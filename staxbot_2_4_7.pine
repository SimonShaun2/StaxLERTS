//@version=6
// StaxBot 2.4.7
// New saved script. The legend reads StaxBot. The HUD reads STAXBOT 2.4.7.
// Built from the 2.1 base: stored break price, latest swing, gap detection.
// A shelf plan arms without a gap. A gap inside the window is a second plan.
// Tight stops past the gap far edge or the break candle. Medium stops past the displacement candle. Large stops past the leg extreme.
// Buffers, reclaim, and stop limits use the previous bar's ATR. Tight stays at or inside Medium, and Large stays at or beyond it.
// The arm decision uses the Medium stop. A selected stop inside the minimum is widened to it. Targets use the Medium distance. The daily count moves only when a plan fills.
// This script does not call strategy.entry or strategy.exit. Alerts are alert() only.
strategy("StaxBot", shorttitle = "StaxBot", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     margin_long = 1, margin_short = 1,
     calc_on_every_tick = false, calc_on_order_fills = false, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.0, slippage = 0,
     max_boxes_count = 300, max_lines_count = 500, max_labels_count = 500)

G_PRESET  = "Preset"
G_COACH   = "Coach & Execution Filters"
G_STRUCT  = "Structure"
G_TP      = "Take Profit"
G_SL      = "Stop Loss"
G_BE      = "Breakeven"
G_TRAIL   = "Trailing Stop"
G_VOL     = "Volume Filter"
G_BIAS    = "EMA Bias"
G_STAX    = "Stax Alerts"
G_DISPLAY = "Display"
G_SESSION = "Session Pause"

presetIn = input.string("Manual", "Strategy Preset", group = G_PRESET,
     options = ["Manual", "NY AM Scalper", "NY AM Standard", "London Breakout", "Overnight Conservative"],
     tooltip = "A preset can change direction, session, which stop is selected, breakeven, trail, and the daily cap. It cannot change Take Profit (R), the entry, the scenario, or whether the plan arms.")
dirIn            = input.string("Both", "Allowed Direction", options = ["Both", "Longs Only", "Shorts Only"], group = G_COACH)
sessIn           = input.string("24/5 (No Filter)", "Session Preset", group = G_COACH,
     options = ["24/5 (No Filter)", "NY AM (09:30-12:00)", "NY PM (13:00-16:00)", "London (03:00-06:00)", "Asia (20:00-00:00)", "Overnight (18:00-03:00)", "Custom"])
customSessIn     = input.session("2000-2130", "Custom Session (If Custom Selected)", group = G_COACH)
tzIn             = input.string("America/New_York", "Timezone", group = G_COACH)
maxTradesIn      = input.int(20, "Max Trades Per Day", minval = 1, group = G_COACH)
maxLiveIn        = input.int(1, "Live Positions At Once", minval = 1, maxval = 5, group = G_COACH)
flatAtSessEndIn  = input.bool(false, "Flatten Open Trade At Session End", group = G_COACH)
minGradeIn       = input.string("Off", "Minimum Grade", options = ["Off", "A", "A+"], group = G_COACH,
     tooltip = "A+ needs all five flags. A is four, and one of those four must be strong displacement or the London/New York window. Flag 1 is the strong-displacement body. Flag 5 is a gap on scenario A, or swing age on scenario B.")
reclaimExitIn    = input.bool(true, "Reclaim Exit On Live Trades", group = G_COACH,
     tooltip = "On: a live trade that closes back through the shelf exits at that close. Off: the shelf reclaim only blocks a fill.")
reclaimAtrIn   = input.float(0.25, "Reclaim Tolerance (ATR x)", minval = 0, step = 0.05, group = G_COACH,
     tooltip = "Invalidation and the live reclaim exit need the close at least this many ATR past the shelf. A shelf fill can trade anywhere from the shelf to this distance. A gap plan uses the gap far edge instead of the shelf. The multiple is the previous bar's ATR.")

swingLenIn       = input.int(3, "Swing Length", minval = 2, group = G_STRUCT)
minRangeAtrIn    = input.float(0.0, "Min Shelf Height (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_STRUCT)
minGapAtrIn      = input.float(0.2, "Min Gap Height (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_STRUCT,
     tooltip = "A gap shorter than this multiple of ATR does not arm.")
dispModeIn       = input.string("Body >= ATR x", "Displaced Close", group = G_STRUCT,
     options = ["Body >= ATR x", "Close beyond zone by zone width"],
     tooltip = "The only definition of a displaced close. Inside the break window, a bar that passes this test and is still beyond the shelf arms the plan.")
dispBodyAtrIn    = input.float(1.0, "Displacement Body (ATR x)", minval = 0, step = 0.1, group = G_STRUCT)
breakWinIn       = input.int(3, "Break Window (bars)", minval = 1, group = G_STRUCT,
     tooltip = "A close through the shelf opens this many bars. A displaced close still beyond that shelf inside the window arms the plan, including when the crossing bar itself was not displaced.")
strongAtrIn      = input.float(1.5, "Strong Displacement (ATR x)", minval = 0, step = 0.1, group = G_STRUCT,
     tooltip = "Grade flag 1. The arming bar's body must be at least this multiple of ATR. A smaller displaced close can still arm.")
fvgWindowIn      = input.int(1, "Gap Window After The Break (bars)", minval = 1, group = G_STRUCT)
swingAgeIn       = input.int(5, "Swing Age For Grade Flag 5 (bars)", minval = 1, group = G_STRUCT)
setupExpiryIn    = input.int(12, "Plan Expires After N Bars", minval = 1, group = G_STRUCT)
entryLevelIn     = input.string("FVG Near Edge (Aggressive)", "Gap Entry", group = G_STRUCT,
     options = ["FVG Near Edge (Aggressive)", "FVG Midpoint (CE)", "FVG Far Edge (Deep)"])
enableCIn        = input.bool(false, "Scenario C (not built)", group = G_STRUCT,
     tooltip = "Sweep and reclaim is off. Turning this on does not arm a plan.")
scenariosIn      = input.string("Shelf + Gap", "Allowed Scenarios", options = ["Shelf + Gap", "Gap only", "Shelf only"], group = G_STRUCT,
     tooltip = "Shelf + Gap arms both. Gap only arms the fair-value-gap plan, which is the 2.0 behavior. Shelf only arms the break. The break still opens the gap window.")

tpRIn = input.float(1.0, "Take Profit (R)", minval = 0.1, maxval = 5, step = 0.1, group = G_TP,
     tooltip = "TP1 is this many reference R from entry. TP2 is twice that. TP3 is three times that. Reference R is the entry-to-Medium-stop distance. Presets cannot change this input.")
tp1OnIn = input.bool(true, "TP1", group = G_TP)
tp2OnIn = input.bool(false, "TP2", group = G_TP)
tp3OnIn = input.bool(false, "TP3", group = G_TP)
tp1WIn  = input.int(1, "TP1 weight", minval = 1, maxval = 100, group = G_TP)
tp2WIn  = input.int(1, "TP2 weight", minval = 1, maxval = 100, group = G_TP)
tp3WIn  = input.int(1, "TP3 weight", minval = 1, maxval = 100, group = G_TP)

slTypeIn     = input.string("Medium", "SL Type", options = ["Tight", "Medium", "Large"], group = G_SL,
     tooltip = "Tight stops beyond the gap far edge, or the break candle on a shelf plan. Medium stops beyond the displacement candle. Large stops beyond the leg extreme. Distances stay Tight at or inside Medium, and Large at or beyond Medium. A selected stop inside the minimum is widened to the minimum. Entry, targets, and the arm decision stay on the Medium stop. Buffers use the previous bar's ATR.")
tightAtrIn = input.float(0.05, "Tight Buffer (ATR x)", minval = 0, step = 0.01, group = G_SL)
medAtrIn   = input.float(0.10, "Medium Buffer (ATR x)", minval = 0, step = 0.01, group = G_SL)
largeAtrIn = input.float(0.25, "Large Buffer (ATR x)", minval = 0, step = 0.05, group = G_SL)
legLookbackIn   = input.int(30, "Leg Lookback (bars)", minval = 3, group = G_SL)
minStopAtrIn  = input.float(0.5, "Min Stop Distance (ATR x)", minval = 0, step = 0.1, group = G_SL,
     tooltip = "Checked on the Medium stop. The preset does not change it. A selected stop closer than this is widened to it. The multiple is the previous bar's ATR.")
maxStopAtrIn  = input.float(3.0, "Max Stop Distance (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_SL,
     tooltip = "Checked on the Medium stop. The preset does not change it. The multiple is the previous bar's ATR.")

beIn    = input.string("Off", "Breakeven", options = ["Off", "At 0.5R", "At 0.75R", "At 1R", "At 1.5R"], group = G_BE,
     tooltip = "Steps use reference R. Ignored while a trailing preset is on.")
beTickIn = input.bool(false, "BE +1 Tick Buffer", group = G_BE)
trailIn = input.string("Off", "Trailing Stop", group = G_TRAIL,
     options = ["Off", "Aggressive (BE 0.75R)", "Standard (BE 1R)", "Wide (BE 1.5R)"])

volIn    = input.string("Off", "Volume Filter", options = ["Off", "Above Average (1.0x)", "Strong (1.5x)"], group = G_VOL)
volLenIn = input.int(20, "Volume Average Length", minval = 2, group = G_VOL)
emaFastIn = input.int(9, "EMA Cloud Fast", minval = 1, group = G_BIAS)
emaSlowIn = input.int(21, "EMA Cloud Slow", minval = 1, group = G_BIAS)
biasFilterIn = input.bool(false, "Only Trade With EMA Bias", group = G_BIAS)

payloadModeIn = input.string("Generic JSON (Futures / Any Webhook)", "Alert Payload", group = G_STAX,
     options = ["Stax Options Webhook", "Generic JSON (Futures / Any Webhook)"])
tickerOverrideIn = input.string("", "Underlying Symbol Override (blank = chart root)", group = G_STAX)
dteIn            = input.int(0, "Days To Expiration (0 = 0DTE)", minval = 0, maxval = 60, group = G_STAX)
strikesOtmIn     = input.int(0, "Strikes OTM", minval = 0, group = G_STAX)
strikeStepIn     = input.float(1.0, "Strike Step", minval = 0.5, step = 0.5, group = G_STAX)
sendExitAlertsIn = input.bool(true, "Send Exit Alerts", group = G_STAX)
sendStopUpdIn    = input.bool(false, "Send Stop-Update Alerts", group = G_STAX)

showTableIn    = input.bool(true, "Show HUD", group = G_DISPLAY)
hudSizeIn      = input.string("Full", "HUD size", options = ["Full", "Compact"], group = G_DISPLAY)
hudPosIn       = input.string("Top right", "HUD position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DISPLAY)
showDrawingsIn = input.bool(true, "Show Chart Drawings", group = G_DISPLAY)
resolvedIn     = input.string("Remove", "Resolved Plans", options = ["Grey", "Remove", "Review"], group = G_DISPLAY,
     tooltip = "Remove deletes the drawing. Grey keeps a faint entry line and a state tag for the last three. Review keeps the last five with entry, stop, and target lines in grey, plus the state tag and the reason.")
showSessBgIn   = input.bool(true, "Shade Active Session", group = G_DISPLAY)
cloudColorIn   = input.color(#00c8ff, "EMA Cloud Color", group = G_DISPLAY)

pauseOnIn   = input.bool(true, "Session Pause", group = G_SESSION)
pauseSessIn = input.session("1500-1700", "Pause Window", group = G_SESSION,
     tooltip = "Default 3:00–5:00 PM on the pause timezone. No new plan arms and no fill triggers in the window.")
pauseTzIn   = input.string("America/Chicago", "Pause Timezone", group = G_SESSION)

pDir = switch presetIn
    "NY AM Scalper"          => "Both"
    "NY AM Standard"         => "Both"
    "London Breakout"        => "Both"
    "Overnight Conservative" => "Both"
    => dirIn
pSess = presetIn == "NY AM Scalper" or presetIn == "NY AM Standard" ? "NY AM (09:30-12:00)" : presetIn == "London Breakout" ? "London (03:00-06:00)" : presetIn == "Overnight Conservative" ? "Overnight (18:00-03:00)" : sessIn
pTp = tpRIn
pSl = switch presetIn
    "NY AM Scalper"          => "Medium"
    "NY AM Standard"         => "Large"
    "London Breakout"        => "Medium"
    "Overnight Conservative" => "Large"
    => slTypeIn
pBe = switch presetIn
    "NY AM Scalper"          => "Off"
    "NY AM Standard"         => "Off"
    "London Breakout"        => "Off"
    "Overnight Conservative" => "At 1R"
    => beIn
pTrail = switch presetIn
    "NY AM Scalper"          => "Aggressive (BE 0.75R)"
    "NY AM Standard"         => "Standard (BE 1R)"
    "London Breakout"        => "Standard (BE 1R)"
    "Overnight Conservative" => "Off"
    => trailIn
pMaxTrades = switch presetIn
    "NY AM Scalper"          => 3
    "NY AM Standard"         => 3
    "London Breakout"        => 2
    "Overnight Conservative" => 2
    => maxTradesIn

sessStr = pSess == "NY AM (09:30-12:00)" ? "0930-1200" : pSess == "NY PM (13:00-16:00)" ? "1300-1600" : pSess == "London (03:00-06:00)" ? "0300-0600" : pSess == "Asia (20:00-00:00)" ? "2000-0000" : pSess == "Overnight (18:00-03:00)" ? "1800-0300" : pSess == "Custom" ? customSessIn : ""
sessShort = pSess == "NY AM (09:30-12:00)" ? "NY AM" : pSess == "NY PM (13:00-16:00)" ? "NY PM" : pSess == "London (03:00-06:00)" ? "London" : pSess == "Asia (20:00-00:00)" ? "Asia" : pSess == "Overnight (18:00-03:00)" ? "Overnight" : pSess == "Custom" ? customSessIn : "24/5"
sessionFilterOn = sessStr != ""
sessForTime = sessionFilterOn ? sessStr : "0000-2359:1234567"
inSession = not sessionFilterOn or not na(time(timeframe.period, sessForTime, tzIn))
sessionEnded = sessionFilterOn and inSession[1] and not inSession
pauseHit = time(timeframe.period, pauseSessIn, pauseTzIn)
inPause = pauseOnIn and not na(pauseHit)
tick = syminfo.mintick
longsOk = pDir != "Shorts Only"
shortsOk = pDir != "Longs Only"
trailOn = pTrail != "Off"
beOn = not trailOn and pBe != "Off"
beR = switch pBe
    "At 0.5R"  => 0.5
    "At 0.75R" => 0.75
    "At 1R"    => 1.0
    "At 1.5R"  => 1.5
    => 0.0
trailBe = switch pTrail
    "Aggressive (BE 0.75R)" => 0.75
    "Standard (BE 1R)"      => 1.0
    "Wide (BE 1.5R)"        => 1.5
    => 0.0
trailT1 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.0
    "Standard (BE 1R)"      => 1.5
    "Wide (BE 1.5R)"        => 2.0
    => 0.0
trailO1 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.25
    "Standard (BE 1R)"      => 0.5
    "Wide (BE 1.5R)"        => 0.5
    => 0.0
trailT2 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.25
    "Standard (BE 1R)"      => 2.0
    "Wide (BE 1.5R)"        => 2.5
    => 0.0
trailO2 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.5
    "Standard (BE 1R)"      => 1.0
    "Wide (BE 1.5R)"        => 1.0
    => 0.0
trailT3 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.5
    "Standard (BE 1R)"      => 2.5
    "Wide (BE 1.5R)"        => 3.0
    => 0.0
trailO3 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.75
    "Standard (BE 1R)"      => 1.5
    "Wide (BE 1.5R)"        => 1.5
    => 0.0
volMult = switch volIn
    "Above Average (1.0x)" => 1.0
    "Strong (1.5x)"        => 1.5
    => 0.0
staxMode = payloadModeIn == "Stax Options Webhook"
targetsOk = tp1OnIn or tp2OnIn or tp3OnIn

emaFast = ta.ema(close, emaFastIn)
emaSlow = ta.ema(close, emaSlowIn)
bias = close > emaFast and emaFast > emaSlow ? 1 : close < emaFast and emaFast < emaSlow ? -1 : 0
atr = ta.atr(14)
armAtr = atr[1]
volSma = ta.sma(volume, volLenIn)

f_htf() =>
    float fast = ta.ema(close, emaFastIn)
    float slow = ta.ema(close, emaSlowIn)
    close > fast and fast > slow ? 1 : close < fast and fast < slow ? -1 : 0
hD  = request.security(syminfo.tickerid, "D", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h4  = request.security(syminfo.tickerid, "240", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h1  = request.security(syminfo.tickerid, "60", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h15 = request.security(syminfo.tickerid, "15", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h5  = request.security(syminfo.tickerid, "5", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)

ph = ta.pivothigh(high, swingLenIn, swingLenIn)
pl = ta.pivotlow(low, swingLenIn, swingLenIn)
var float rangeHigh = na
var float rangeLow = na
var int rangeHighBar = na
var int rangeLowBar = na
if not na(ph)
    rangeHigh := ph
    rangeHighBar := bar_index - swingLenIn
if not na(pl)
    rangeLow := pl
    rangeLowBar := bar_index - swingLenIn
lowLegLen = na(rangeLowBar) ? legLookbackIn : math.max(1, math.min(legLookbackIn, bar_index - rangeLowBar + 1))
highLegLen = na(rangeHighBar) ? legLookbackIn : math.max(1, math.min(legLookbackIn, bar_index - rangeHighBar + 1))
legLowNow = ta.lowest(low, lowLegLen)
legHighNow = ta.highest(high, highLegLen)
zoneWidth = not na(rangeHigh) and not na(rangeLow) ? rangeHigh - rangeLow : 0.0
bodyDisp = math.abs(close - open) >= dispBodyAtrIn * atr
bullBeyond = not na(rangeHigh) and zoneWidth > 0 and close - rangeHigh >= zoneWidth
bearBeyond = not na(rangeLow) and zoneWidth > 0 and rangeLow - close >= zoneWidth
bullDisp = dispModeIn == "Close beyond zone by zone width" ? bullBeyond : bodyDisp
bearDisp = dispModeIn == "Close beyond zone by zone width" ? bearBeyond : bodyDisp
bullThrough = not na(rangeHigh) and close > rangeHigh and (na(close[1]) or close[1] <= rangeHigh)
bearThrough = not na(rangeLow) and close < rangeLow and (na(close[1]) or close[1] >= rangeLow)
strongDisp = math.abs(close - open) >= strongAtrIn * atr
shelfOk = zoneWidth > 0 and (minRangeAtrIn <= 0 or zoneWidth >= minRangeAtrIn * atr)
bullFvg = low > high[2] and close[1] > open[1]
bearFvg = high < low[2] and close[1] < open[1]
volOk = volMult <= 0 or volume > volSma * volMult

type staxPlan
    int planId = 0
    int moveId = 0
    string scenario = ""
    string origin = ""
    int dir = 0
    float entry = na
    float anchor = na
    string preset = ""
    float stop = na
    float tp1 = na
    float tp2 = na
    float tp3 = na
    float refRisk = na
    string grade = ""
    string state = ""
    int createdBar = 0
    int expiryBar = 0
    float shelf = na
    float inv = na
    int swingBar = 0
    float zoneHi = na
    float zoneLo = na
    int zoneFrom = 0
    bool on1 = false
    bool on2 = false
    bool on3 = false
    float rUnit = na
    int w1 = 1
    int w2 = 1
    int w3 = 1
    string setupId = ""
    string reason = ""
    string fp = ""
    bool hit1 = false
    bool hit2 = false
    bool hit3 = false
    float liveStop = na
    int fillBar = -1
    bool ready = false
    bool greyed = false
    bool erased = false
    int resolvedBar = -1
    line lnEn = na
    line lnSl = na
    line ln1 = na
    line ln2 = na
    line ln3 = na
    label lbEn = na
    label lbSl = na
    label lb1 = na
    label lb2 = na
    label lb3 = na
    label lbFill = na
    label lbExit = na
    box rangeBox = na
    label lbRange = na
    label lbBos = na

type Engine
    int planSeq = 0
    string hudReject = ""

var Engine eng = Engine.new()
var array<staxPlan> plans = array.new<staxPlan>()
var array<string> outbox = array.new_string()
var int moveSeq = 0
var int moveIdNow = 0
var int moveDir = 0
var int moveBar = -1
var float moveAnchor = na
var float moveShelf = na
var int moveSwing = 0
var float moveZoneHi = na
var float moveZoneLo = na
var int moveZoneFrom = 0
var bool moveFlag1 = false
var int winSide = 0
var int winFrom = -1
var float winLevel = na
var int winSwing = na
var float winZoneHi = na
var float winZoneLo = na
var int winZoneFrom = 0
var int tradesToday = 0

f_num(float v) =>
    na(v) ? "null" : str.tostring(v, format.mintick)
f_ts() =>
    str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ssZ", tzIn)
f_pad2(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)
f_expiryYYMMDD() =>
    int base = timestamp(tzIn, year(time, tzIn), month(time, tzIn), dayofmonth(time, tzIn), 12, 0, 0) + dteIn * 86400000
    int dow = dayofweek(base, tzIn)
    int adj = dow == dayofweek.saturday ? base + 2 * 86400000 : dow == dayofweek.sunday ? base + 86400000 : base
    str.substring(str.tostring(year(adj, tzIn)), 2, 4) + f_pad2(month(adj, tzIn)) + f_pad2(dayofmonth(adj, tzIn))
f_strike(int side) =>
    float step = strikeStepIn
    float raw = side == 1 ? math.ceil(close / step) * step + strikesOtmIn * step : math.floor(close / step) * step - strikesOtmIn * step
    float frac = raw - math.floor(raw)
    frac == 0 ? str.tostring(math.round(raw)) + ".0" : str.tostring(raw)
f_grade(bool dispOk, bool biasOk, bool volFlag, bool sessOk, bool fifth) =>
    int score = (dispOk ? 1 : 0) + (biasOk ? 1 : 0) + (volFlag ? 1 : 0) + (sessOk ? 1 : 0) + (fifth ? 1 : 0)
    score == 5 ? "A+" : score == 4 and (dispOk or sessOk) ? "A" : "B"
f_fp() =>
    str.tostring(pTp, "0.00") + "|" + pSl + "|" + str.tostring(tightAtrIn, "0.00") + "|" + str.tostring(medAtrIn, "0.00") + "|" + str.tostring(largeAtrIn, "0.00") + "|" + minGradeIn + "|" + entryLevelIn + "|" + pBe + "|" + pTrail + "|" + pDir + "|" + sessShort + "|" + dispModeIn + "|" + str.tostring(dispBodyAtrIn, "0.0") + "|" + str.tostring(maxLiveIn) + "|" + (reclaimExitIn ? "1" : "0") + "|" + (pauseOnIn ? "1" : "0") + "|" + (enableCIn ? "1" : "0") + "|" + str.tostring(breakWinIn) + "|" + str.tostring(strongAtrIn, "0.0") + "|" + str.tostring(reclaimAtrIn, "0.00") + "|" + str.tostring(minStopAtrIn, "0.0") + "|" + str.tostring(maxStopAtrIn, "0.0") + "|" + scenariosIn
f_signed(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"
f_stop(float anchor, int side, string which) =>
    float buf = which == "Tight" ? tightAtrIn * armAtr : which == "Large" ? largeAtrIn * armAtr : medAtrIn * armAtr
    anchor - side * buf
f_hit(float px) =>
    low <= px and px <= high
f_stop_hit(int side, float px) =>
    side == 1 ? low <= px : high >= px
f_tp_hit(int side, float px) =>
    side == 1 ? high >= px : low <= px
f_wrong(int side, float shelf) =>
    float tol = reclaimAtrIn * armAtr
    side == 1 ? shelf - close >= tol : close - shelf >= tol
f_entry_hit(staxPlan p) =>
    float tol = reclaimAtrIn * armAtr
    p.origin == "shelf" ? (p.dir == 1 ? low <= p.shelf and high >= p.shelf - tol : high >= p.shelf and low <= p.shelf + tol) : f_hit(p.entry)
f_active(string state) =>
    state == "ARMED" or state == "TRIGGERED" or state == "LIVE"
f_targets(staxPlan p) =>
    string s = ""
    if p.on1
        s := '{"id":"TP1","price":' + f_num(p.tp1) + ',"allocation":' + str.tostring(p.w1) + ',"r":' + str.tostring(p.rUnit, "0.00") + '}'
    if p.on2
        string bit = '{"id":"TP2","price":' + f_num(p.tp2) + ',"allocation":' + str.tostring(p.w2) + ',"r":' + str.tostring(p.rUnit * 2.0, "0.00") + '}'
        s := s == "" ? bit : s + "," + bit
    if p.on3
        string bit3 = '{"id":"TP3","price":' + f_num(p.tp3) + ',"allocation":' + str.tostring(p.w3) + ',"r":' + str.tostring(p.rUnit * 3.0, "0.00") + '}'
        s := s == "" ? bit3 : s + "," + bit3
    "[" + s + "]"
f_payload(staxPlan p, string event, string extra) =>
    string side = p.dir == 1 ? "long" : "short"
    string opt = staxMode and event == "entry" ? ',"unmodifiedTicker":"' + (tickerOverrideIn != "" ? tickerOverrideIn : syminfo.root) + f_expiryYYMMDD() + (p.dir == 1 ? "C" : "P") + f_strike(p.dir) + '"' : ""
    '{"source":"staxbot","event":"' + event + '","eventId":"' + p.setupId + ":" + event + ":" + str.tostring(bar_index) + '","setupId":"' + p.setupId + '","plan_id":' + str.tostring(p.planId) + ',"move_id":' + str.tostring(p.moveId) + ',"scenario":"' + p.scenario + '","state":"' + p.state + '","origin":"' + p.origin + '","side":"' + side + '","entry":' + f_num(p.entry) + ',"stop":' + f_num(p.liveStop) + ',"stop_preset":"' + p.preset + '","price":' + f_num(p.entry) + ',"target":' + f_num(p.on1 ? p.tp1 : p.on2 ? p.tp2 : p.tp3) + ',"targets":' + f_targets(p) + ',"grade":"' + p.grade + '","timeframe":"' + timeframe.period + '","ticker":"' + syminfo.ticker + '","root":"' + syminfo.root + '","exchange":"' + syminfo.prefix + '"' + opt + extra + ',"timestamp":"' + f_ts() + '"}'
f_send(string msg) =>
    array.push(outbox, msg)
    true
f_live_n() =>
    int n = 0
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.state == "LIVE" or p.state == "TRIGGERED"
                n += 1
    n
f_has(int id, string origin) =>
    bool found = false
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.moveId == id and p.origin == origin and f_active(p.state)
                found := true
    found
f_replace_older(int side, int id) =>
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.dir == side and p.state == "ARMED" and p.moveId < id
                p.state := "REPLACED"
                p.reason := "newer break"
                p.ready := false
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"replaced"'))
                array.set(plans, i, p)
    true
f_try_arm(string origin, int side, float entry, float tightPx, float medPx, float anchor, float shelf, int swingBar, float zoneHi, float zoneLo, int zoneFrom, bool flag1, bool fifth) =>
    eng.planSeq += 1
    float med = f_stop(medPx, side, "Medium")
    float rawTight = f_stop(tightPx, side, "Tight")
    float rawLarge = f_stop(anchor, side, "Large")
    float dM = (entry - med) * side
    float dT = (entry - rawTight) * side
    float dL = (entry - rawLarge) * side
    float dT2 = na(dM) ? na : ((na(dT) or dT > dM or dT <= 0) ? dM : dT)
    float dL2 = na(dM) ? na : ((na(dL) or dL < dM) ? dM : dL)
    float tightStop = entry - side * dT2
    float largeStop = entry - side * dL2
    float sel = na(dM) ? na : pSl == "Tight" ? tightStop : pSl == "Large" ? largeStop : med
    float ref = dM
    float t1 = entry + side * pTp * ref
    float t2 = entry + side * pTp * 2.0 * ref
    float t3 = entry + side * pTp * 3.0 * ref
    bool distanceOk = dM >= minStopAtrIn * armAtr and (maxStopAtrIn <= 0 or dM <= maxStopAtrIn * armAtr)
    bool ordered = side == 1 ? med < entry and entry < t1 and t1 < t2 and t2 < t3 : med > entry and entry > t1 and t1 > t2 and t2 > t3
    float r1 = ref > 0 ? math.abs(t1 - entry) / ref : na
    float r2 = ref > 0 ? math.abs(t2 - entry) / ref : na
    float r3 = ref > 0 ? math.abs(t3 - entry) / ref : na
    bool labelsOk = not na(r1) and math.abs(r1 - pTp) < 0.0001 and math.abs(r2 - pTp * 2.0) < 0.0001 and math.abs(r3 - pTp * 3.0) < 0.0001
    bool geometryOk = ordered and labelsOk
    int clock = hour(time, tzIn) * 60 + minute(time, tzIn)
    bool gradeSess = (clock >= 180 and clock < 360) or (clock >= 500 and clock < 690)
    string g = f_grade(flag1, side == 1 ? bias == 1 : bias == -1, volume > volSma, gradeSess, fifth)
    bool take = minGradeIn == "Off" or g == "A+" or (minGradeIn == "A" and g == "A")
    if not geometryOk
        eng.hudReject := "PLAN REJECTED: geometry."
        log.info("plan_id " + str.tostring(eng.planSeq) + " PLAN REJECTED: geometry")
    else if not distanceOk
        eng.hudReject := "PLAN REJECTED: stop distance."
        log.info("plan_id " + str.tostring(eng.planSeq) + " PLAN REJECTED: stop distance")
    else if take and not f_has(moveIdNow, origin)
        float minDist = minStopAtrIn * armAtr
        float dSel = (entry - sel) * side
        if not na(dSel) and dSel < minDist
            sel := entry - side * minDist
        staxPlan p = staxPlan.new()
        p.planId := eng.planSeq
        p.moveId := moveIdNow
        p.scenario := origin == "gap" ? "A" : "B"
        p.origin := origin
        p.dir := side
        p.entry := entry
        p.anchor := pSl == "Tight" ? tightPx : pSl == "Large" ? anchor : medPx
        p.preset := pSl
        p.stop := sel
        p.liveStop := sel
        p.tp1 := t1
        p.tp2 := t2
        p.tp3 := t3
        p.refRisk := ref
        p.grade := g
        p.state := "ARMED"
        p.createdBar := bar_index
        p.expiryBar := bar_index + setupExpiryIn
        p.shelf := shelf
        p.inv := origin == "gap" ? tightPx : shelf
        p.swingBar := swingBar
        p.zoneHi := zoneHi
        p.zoneLo := zoneLo
        p.zoneFrom := zoneFrom
        p.on1 := tp1OnIn
        p.on2 := tp2OnIn
        p.on3 := tp3OnIn
        p.rUnit := pTp
        p.w1 := tp1WIn
        p.w2 := tp2WIn
        p.w3 := tp3WIn
        p.setupId := syminfo.ticker + ":" + str.tostring(time) + ":" + str.tostring(eng.planSeq)
        p.fp := f_fp()
        p.reason := ""
        array.push(plans, p)
        f_send(f_payload(p, "plan", ""))
        eng.hudReject := ""
    true

f_note(int at, float y, string txt) =>
    label.new(at, y, txt, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = color.new(#E6EAF2, 0), size = size.small)
f_price_tag(int at, float y, string txt, color ink) =>
    label.new(at, y, txt, style = label.style_label_right, color = color.new(#0B0F19, 0), textcolor = ink, size = size.normal, text_font_family = font.family_monospace)
f_exit_mark(int side, float y, string txt, color ink) =>
    label.new(bar_index, y, txt, style = side == 1 ? label.style_label_down : label.style_label_up, color = ink, textcolor = color.white, size = size.tiny, text_font_family = font.family_monospace)
f_drop_line(line l) =>
    if not na(l)
        line.delete(l)
    true
f_drop_lab(label l) =>
    if not na(l)
        label.delete(l)
    true
f_drop_box(box b) =>
    if not na(b)
        box.delete(b)
    true
f_erase(staxPlan p) =>
    f_drop_line(p.lnEn)
    f_drop_line(p.lnSl)
    f_drop_line(p.ln1)
    f_drop_line(p.ln2)
    f_drop_line(p.ln3)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbExit)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lnEn := na
    p.lnSl := na
    p.ln1 := na
    p.ln2 := na
    p.ln3 := na
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbExit := na
    p.lbRange := na
    p.lbBos := na
    p.rangeBox := na
    p.erased := true
    p
f_grey(staxPlan p) =>
    color ink = color.new(#7F8AA3, 55)
    f_drop_line(p.lnSl)
    f_drop_line(p.ln1)
    f_drop_line(p.ln2)
    f_drop_line(p.ln3)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbExit)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lnSl := na
    p.ln1 := na
    p.ln2 := na
    p.ln3 := na
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbExit := na
    p.lbBos := na
    p.rangeBox := na
    if not na(p.lnEn)
        line.set_color(p.lnEn, ink)
        line.set_width(p.lnEn, 1)
        line.set_x2(p.lnEn, bar_index)
    int tagAt = p.resolvedBar >= 0 ? p.resolvedBar : bar_index
    p.lbRange := label.new(tagAt, p.entry, p.state, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = ink, size = size.small)
    p.greyed := true
    p
f_review(staxPlan p) =>
    color ink = color.new(#7F8AA3, 0)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbExit)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbExit := na
    p.lbBos := na
    p.rangeBox := na
    if not na(p.lnEn)
        line.set_color(p.lnEn, ink)
        line.set_x2(p.lnEn, bar_index)
    if not na(p.lnSl)
        line.set_color(p.lnSl, ink)
        line.set_x2(p.lnSl, bar_index)
    if not na(p.ln1)
        line.set_color(p.ln1, ink)
        line.set_x2(p.ln1, bar_index)
    if not na(p.ln2)
        line.set_color(p.ln2, ink)
        line.set_x2(p.ln2, bar_index)
    if not na(p.ln3)
        line.set_color(p.ln3, ink)
        line.set_x2(p.ln3, bar_index)
    int tagAt = p.resolvedBar >= 0 ? p.resolvedBar : bar_index
    string tagTxt = p.reason == "" ? p.state : p.state + " " + p.reason
    p.lbRange := label.new(tagAt, p.entry, tagTxt, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = ink, size = size.small)
    p.greyed := true
    p
f_draw(staxPlan p) =>
    if not showDrawingsIn or p.erased
        p
    else if not f_active(p.state)
        if resolvedIn == "Remove"
            f_erase(p)
        else if not p.greyed and resolvedIn == "Review"
            f_review(p)
        else if not p.greyed
            f_grey(p)
        else
            p
    else
        int left = math.max(0, p.createdBar - 24)
        int right = bar_index
        color sideInk = p.dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0)
        if na(p.lnEn)
            float top = math.max(p.zoneHi, p.zoneLo)
            float bot = math.min(p.zoneHi, p.zoneLo)
            int boxLeft = math.max(0, p.zoneFrom)
            p.rangeBox := box.new(boxLeft, top, p.createdBar, bot, border_color = color.new(sideInk, 0), border_width = 2, border_style = line.style_solid, bgcolor = color.new(sideInk, 70))
            p.lbRange := f_note(boxLeft, (top + bot) / 2.0, p.origin == "gap" ? "GAP" : "RANGE")
            p.lbBos := f_note(p.createdBar, p.shelf, "BREAK")
            p.lnEn := line.new(left, p.entry, right, p.entry, color = color.new(#E6EAF2, 0), style = line.style_solid, width = 2)
            p.lnSl := line.new(left, p.liveStop, right, p.liveStop, color = color.new(#FF5C6C, 0), style = line.style_solid, width = 3)
            p.lbEn := f_price_tag(right, p.entry, "ENTRY  " + f_num(p.entry), color.new(#E6EAF2, 0))
            p.lbSl := f_price_tag(right, p.liveStop, "STOP  " + f_num(p.liveStop), color.new(#FF5C6C, 0))
            if p.on1
                p.ln1 := line.new(left, p.tp1, right, p.tp1, color = color.new(#3DDC97, 0), style = line.style_solid, width = 2)
                p.lb1 := f_price_tag(right, p.tp1, "TP1  " + f_num(p.tp1) + "   " + str.tostring(p.rUnit, "0.#") + "R", color.new(#3DDC97, 0))
            if p.on2
                p.ln2 := line.new(left, p.tp2, right, p.tp2, color = color.new(#3DDC97, 0), style = line.style_solid, width = 3)
                p.lb2 := f_price_tag(right, p.tp2, "TP2  " + f_num(p.tp2) + "   " + str.tostring(p.rUnit * 2.0, "0.#") + "R", color.new(#3DDC97, 0))
            if p.on3
                p.ln3 := line.new(left, p.tp3, right, p.tp3, color = color.new(#147A4E, 0), style = line.style_solid, width = 3)
                p.lb3 := f_price_tag(right, p.tp3, "TP3  " + f_num(p.tp3) + "   " + str.tostring(p.rUnit * 3.0, "0.#") + "R", color.new(#147A4E, 0))
        else
            line.set_x1(p.lnEn, left)
            line.set_x2(p.lnEn, right)
            line.set_x1(p.lnSl, left)
            line.set_x2(p.lnSl, right)
            line.set_y1(p.lnSl, p.liveStop)
            line.set_y2(p.lnSl, p.liveStop)
            if p.liveStop != p.stop
                line.set_color(p.lnSl, color.new(#9AA3B5, 0))
            if not na(p.ln1)
                line.set_x1(p.ln1, left)
                line.set_x2(p.ln1, right)
            if not na(p.ln2)
                line.set_x1(p.ln2, left)
                line.set_x2(p.ln2, right)
            if not na(p.ln3)
                line.set_x1(p.ln3, left)
                line.set_x2(p.ln3, right)
            label.set_x(p.lbEn, right)
            label.set_x(p.lbSl, right)
            label.set_y(p.lbSl, p.liveStop)
            label.set_text(p.lbSl, "STOP  " + f_num(p.liveStop))
            if not na(p.lb1)
                label.set_x(p.lb1, right)
            if not na(p.lb2)
                label.set_x(p.lb2, right)
            if not na(p.lb3)
                label.set_x(p.lb3, right)
        p

f_near(staxPlan p) =>
    p.on1 ? p.tp1 : p.on2 ? p.tp2 : p.tp3
f_done(staxPlan p) =>
    (not p.on1 or p.hit1) and (not p.on2 or p.hit2) and (not p.on3 or p.hit3)
f_close_trade(staxPlan p, float px, string why, string targetId) =>
    p.state := "CLOSED"
    p.reason := why
    p.resolvedBar := bar_index
    float rr = p.refRisk > 0 ? p.dir * (px - p.entry) / p.refRisk : 0.0
    color ink = why == "SL" ? color.new(#FF5C6C, 0) : color.new(#3DDC97, 0)
    if showDrawingsIn
        if not na(p.lbExit)
            label.delete(p.lbExit)
        p.lbExit := f_exit_mark(p.dir, px, why + " " + f_signed(rr), ink)
    if sendExitAlertsIn
        string extra = ',"price":' + f_num(px) + ',"reason":"' + why + '","targetId":"' + targetId + '","realizedR":' + str.tostring(rr, "0.00")
        f_send(f_payload(p, "exit", extra))
    p
f_mark_tp(staxPlan p, string which, float px, float rr) =>
    if showDrawingsIn
        if not na(p.lbExit)
            label.delete(p.lbExit)
        p.lbExit := f_exit_mark(p.dir, px, which + " " + f_signed(rr), color.new(#3DDC97, 0))
    if sendExitAlertsIn
        string extra = ',"price":' + f_num(px) + ',"reason":"TP","targetId":"' + which + '","realizedR":' + str.tostring(rr, "0.00")
        f_send(f_payload(p, "exit", extra))
    p

int ctOpenMin = hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")
int ctPrevMin = hour(time[1], "America/Chicago") * 60 + minute(time[1], "America/Chicago")
if ctOpenMin >= 17 * 60 and (na(ctPrevMin) or ctPrevMin < 17 * 60)
    tradesToday := 0
array.clear(outbox)

bool sideOkBull = longsOk and (not biasFilterIn or bias == 1)
bool sideOkBear = shortsOk and (not biasFilterIn or bias == -1)
bool canArm = inSession and not inPause and targetsOk and volOk

if bullThrough or bearThrough
    winSide := bullThrough ? 1 : -1
    winFrom := bar_index
    winLevel := bullThrough ? rangeHigh : rangeLow
    winSwing := bullThrough ? rangeHighBar : rangeLowBar
    winZoneHi := rangeHigh
    winZoneLo := rangeLow
    winZoneFrom := winSwing
bool winOpen = winSide != 0 and winFrom >= 0 and bar_index - winFrom < breakWinIn
bool winBeyond = winSide == 1 ? close > winLevel : winSide == -1 ? close < winLevel : false
bool winDisp = winSide == 1 ? bullDisp : winSide == -1 ? bearDisp : false
bool winSideOk = (winSide == 1 and sideOkBull) or (winSide == -1 and sideOkBear)
if canArm and shelfOk and winOpen and winBeyond and winDisp and winSideOk
    int side = winSide
    moveSeq += 1
    moveIdNow := moveSeq
    moveDir := side
    moveBar := bar_index
    moveAnchor := side == 1 ? legLowNow : legHighNow
    moveShelf := winLevel
    moveSwing := winSwing
    moveZoneHi := winZoneHi
    moveZoneLo := winZoneLo
    moveZoneFrom := winZoneFrom
    moveFlag1 := strongDisp
    f_replace_older(side, moveIdNow)
    bool fifth = bar_index - moveSwing <= swingAgeIn
    float tightCandle = side == 1 ? low : high
    if scenariosIn != "Gap only"
        f_try_arm("shelf", side, moveShelf, tightCandle, tightCandle, moveAnchor, moveShelf, moveSwing, moveZoneHi, moveZoneLo, moveZoneFrom, moveFlag1, fifth)
    winSide := 0
    winFrom := -1

bool gapNow = moveDir == 1 ? bullFvg : bearFvg
float gapTop = moveDir == 1 ? low : low[2]
float gapBot = moveDir == 1 ? high[2] : high
float gapHeight = math.abs(gapTop - gapBot)
bool gapHeightOk = minGapAtrIn <= 0 or gapHeight >= minGapAtrIn * atr
bool inGapWindow = moveBar >= 0 and bar_index - moveBar <= fvgWindowIn
if scenariosIn != "Shelf only" and canArm and inGapWindow and gapNow and gapHeightOk and ((moveDir == 1 and sideOkBull) or (moveDir == -1 and sideOkBear))
    float nearEdge = moveDir == 1 ? gapTop : gapBot
    float farEdge = moveDir == 1 ? gapBot : gapTop
    float midEdge = (gapTop + gapBot) / 2.0
    float gapEntry = entryLevelIn == "FVG Midpoint (CE)" ? midEdge : entryLevelIn == "FVG Far Edge (Deep)" ? farEdge : nearEdge
    float gapMed = moveDir == 1 ? low[1] : high[1]
    f_try_arm("gap", moveDir, gapEntry, farEdge, gapMed, moveAnchor, moveShelf, moveSwing, gapTop, gapBot, math.max(0, bar_index - 2), moveFlag1, true)

if array.size(plans) > 0
    for i = 0 to array.size(plans) - 1
        staxPlan p = array.get(plans, i)
        p.ready := false
        if p.state == "TRIGGERED" and bar_index > p.fillBar
            p.state := "LIVE"
        if p.state == "LIVE" and bar_index > p.fillBar
            bool stopped = f_stop_hit(p.dir, p.liveStop)
            if stopped
                bool moved = p.liveStop != p.stop
                float rr = p.refRisk > 0 ? p.dir * (p.liveStop - p.entry) / p.refRisk : 0.0
                string why = not moved ? "SL" : math.abs(rr) < 0.05 ? "BE" : "TRAILED"
                float exitPx = p.dir == 1 ? math.min(open, p.liveStop) : math.max(open, p.liveStop)
                p := f_close_trade(p, exitPx, why, "STOP")
            else
                if p.on1 and not p.hit1 and f_tp_hit(p.dir, p.tp1) and p.state == "LIVE"
                    p.hit1 := true
                    if f_done(p)
                        p.state := "CLOSED"
                        p.reason := "targets"
                        p.resolvedBar := bar_index
                    p := f_mark_tp(p, "TP1", p.tp1, p.rUnit)
                if p.on2 and not p.hit2 and f_tp_hit(p.dir, p.tp2) and p.state == "LIVE"
                    p.hit2 := true
                    if f_done(p)
                        p.state := "CLOSED"
                        p.reason := "targets"
                        p.resolvedBar := bar_index
                    p := f_mark_tp(p, "TP2", p.tp2, p.rUnit * 2.0)
                if p.on3 and not p.hit3 and f_tp_hit(p.dir, p.tp3) and p.state == "LIVE"
                    p.hit3 := true
                    if f_done(p)
                        p.state := "CLOSED"
                        p.reason := "targets"
                        p.resolvedBar := bar_index
                    p := f_mark_tp(p, "TP3", p.tp3, p.rUnit * 3.0)
                else if p.state == "LIVE" and reclaimExitIn and f_wrong(p.dir, p.inv)
                    p := f_close_trade(p, close, "RECLAIM", "RECLAIM")
                else if p.state == "LIVE" and sessionEnded and flatAtSessEndIn
                    p := f_close_trade(p, close, "FLAT", "FLAT")
                else if p.state == "LIVE"
                    float favR = p.dir == 1 ? (high - p.entry) / p.refRisk : (p.entry - low) / p.refRisk
                    float offR = na
                    if trailOn
                        offR := favR >= trailT3 ? trailO3 : favR >= trailT2 ? trailO2 : favR >= trailT1 ? trailO1 : favR >= trailBe ? 0.0 : na
                    else if beOn
                        offR := favR >= beR ? 0.0 : na
                    if not na(offR)
                        float buffer = offR == 0 and beTickIn ? p.dir * tick : 0.0
                        float cand = p.entry + p.dir * offR * p.refRisk + buffer
                        float newStop = p.dir == 1 ? math.max(p.liveStop, cand) : math.min(p.liveStop, cand)
                        if newStop != p.liveStop
                            p.liveStop := newStop
                            if sendStopUpdIn
                                f_send(f_payload(p, "stop_update", ',"reason":"trail","realizedR":' + str.tostring(offR, "0.00")))
        if p.state == "ARMED" and bar_index > p.createdBar
            bool staleBars = bar_index > p.expiryBar
            if sessionEnded
                p.state := "EXPIRED"
                p.reason := "session"
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"session"'))
            else if f_wrong(p.dir, p.inv)
                p.state := "INVALIDATED"
                p.reason := "reclaim close"
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"reclaim close"'))
            else if f_entry_hit(p) and f_hit(p.stop)
                p.ready := false
            else if not inPause and inSession and tradesToday < pMaxTrades and f_live_n() < maxLiveIn and f_entry_hit(p) and not f_wrong(p.dir, p.inv)
                p.ready := true
            else if f_tp_hit(p.dir, f_near(p)) and not f_entry_hit(p)
                p.state := "EXPIRED"
                p.scenario := "D"
                p.reason := "ran without retest"
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"ran without retest"'))
            else if staleBars
                p.state := "EXPIRED"
                p.reason := "expired"
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"expired"'))
        array.set(plans, i, p)

int guard = 0
int room = maxLiveIn - f_live_n()
while room > 0 and tradesToday < pMaxTrades and guard < 12
    guard += 1
    int best = -1
    float bestPx = na
    bool down = close <= open
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.ready and (best == -1 or (down and p.entry > bestPx) or (not down and p.entry < bestPx))
                best := i
                bestPx := p.entry
    if best == -1
        room := 0
    else
        staxPlan chosen = array.get(plans, best)
        chosen.state := "TRIGGERED"
        chosen.ready := false
        chosen.fillBar := bar_index
        chosen.liveStop := chosen.stop
        tradesToday += 1
        if showDrawingsIn
            if not na(chosen.lbFill)
                label.delete(chosen.lbFill)
            chosen.lbFill := label.new(bar_index, chosen.dir == 1 ? low : high, chosen.dir == 1 ? "LONG" : "SHORT", style = chosen.dir == 1 ? label.style_label_up : label.style_label_down, color = chosen.dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0), textcolor = color.white, size = size.small, text_font_family = font.family_monospace)
        f_send(f_payload(chosen, "entry", ""))
        array.set(plans, best, chosen)
        if array.size(plans) > 0
            for i = 0 to array.size(plans) - 1
                staxPlan sib = array.get(plans, i)
                if i != best and sib.moveId == chosen.moveId and sib.state == "ARMED"
                    sib.state := "CANCELLED"
                    sib.ready := false
                    sib.reason := "sibling filled"
                    sib.resolvedBar := bar_index
                    f_send(f_payload(sib, "plan_cancel", ',"reason":"sibling filled"'))
                    array.set(plans, i, sib)
        room := maxLiveIn - f_live_n()

if array.size(plans) > 0
    for i = 0 to array.size(plans) - 1
        staxPlan p = array.get(plans, i)
        p := f_draw(p)
        array.set(plans, i, p)

int cold = 0
if array.size(plans) > 0
    for i = array.size(plans) - 1 to 0
        staxPlan p = array.get(plans, i)
        if not f_active(p.state)
            cold += 1
            int keepN = resolvedIn == "Review" ? 5 : 3
            if cold > keepN
                f_erase(p)
                array.remove(plans, i)

f_focus() =>
    int idx = -1
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if idx == -1 and p.state == "TRIGGERED"
                idx := i
        if idx == -1
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if idx == -1 and p.state == "LIVE"
                    idx := i
        if idx == -1
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if idx == -1 and p.state == "ARMED"
                    idx := i
    idx
f_move_line() =>
    int id = -1
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if f_active(p.state)
                id := math.max(id, p.moveId)
    string s = ""
    if id >= 0
        s := "Move " + str.tostring(id) + ":"
        int n = 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.moveId == id and f_active(p.state)
                n += 1
                string kind = p.origin == "gap" ? "gap" : "shelf"
                s := s + (n > 1 ? " and " : " ") + kind + " plan " + f_num(p.entry)
    s

f_resolved_line() =>
    string s = ""
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.resolvedBar == bar_index
                s := p.state + (p.reason == "" ? "" : ": " + p.reason)
    s
int focus = f_focus()
bool have = focus >= 0
staxPlan view = have ? array.get(plans, focus) : staxPlan.new()
string resolvedLine = f_resolved_line()
bool hudStale = have and view.fp != f_fp()
string moveLine = f_move_line()
string noteBody = hudStale ? "INPUTS CHANGED. Recreate the alert." : eng.hudReject != "" ? eng.hudReject : not targetsOk ? "Enable TP1, TP2, or TP3." : inPause ? "Pause. No new plans and no fills." : moveLine != "" ? moveLine : "Waiting for the retest."
string note = enableCIn ? "Scenario C is not built. " + noteBody : noteBody
string stateWord = have and view.state == "TRIGGERED" ? "TRIGGERED" : have and view.state == "LIVE" ? "LIVE" : have and view.state == "ARMED" ? "ARMED" : resolvedLine != "" ? resolvedLine : inPause ? "PAUSE" : "WATCH"
string sideWord = have ? (view.dir == 1 ? "LONG" : "SHORT") : ""
string stateTxt = have ? stateWord + "  ·  " + sideWord : stateWord
float openR = have and view.refRisk > 0 ? view.dir * (close - view.entry) / view.refRisk : 0.0
float stopR = have and view.refRisk > 0 ? view.dir * (view.liveStop - view.entry) / view.refRisk : 0.0
string gradeTxt = have and (view.state == "LIVE" or view.state == "TRIGGERED") ? view.grade + "   " + f_signed(openR) : have ? "Grade " + view.grade : str.tostring(tradesToday) + " / " + str.tostring(pMaxTrades)
string foot = hudStale ? "INPUTS CHANGED" : have ? str.tostring(view.rUnit, "0.#") + "R · " + view.preset + " · " + (trailOn ? "Trail" : beOn ? "BE" : "BE off") + " · " + sessShort + "  ·  " + pDir : str.tostring(pTp, "0.#") + "R  ·  " + pSl + "  ·  " + sessShort + "  ·  " + pDir
string tpName = have ? (view.on1 and not view.hit1 ? "TP1" : view.on2 and not view.hit2 ? "TP2" : view.on3 and not view.hit3 ? "TP3" : "TP") : "Trades"
float tpShow = have ? (view.on1 and not view.hit1 ? view.tp1 : view.on2 and not view.hit2 ? view.tp2 : view.on3 and not view.hit3 ? view.tp3 : f_near(view)) : na
bool hudNote = not targetsOk or hudStale or eng.hudReject != "" or inPause or (have and view.state == "ARMED") or moveLine != ""
int hudTg = have ? (view.on1 ? 1 : 0) + (view.on2 ? 1 : 0) + (view.on3 ? 1 : 0) : 0
int hudLevels = have ? hudTg + 2 : 2
int hudBody = hudSizeIn == "Compact" ? 4 : 3 + (hudNote ? 1 : 0) + hudLevels + 1
bool hudTop = hudPosIn == "Top right" or hudPosIn == "Top left"
int hudPad = hudTop ? 1 : 0
string tpKey = have ? (view.on1 ? "1" : "0") + (view.on2 ? "1" : "0") + (view.on3 ? "1" : "0") : "flat"

var table infoTbl = na
var string hudKey = ""
f_cell(table t, int col, int row, string txt, color ink, color bg, string align) =>
    table.cell(t, col, row, txt, text_color = ink, bgcolor = bg, text_halign = align == "r" ? text.align_right : text.align_left, text_valign = text.align_center, text_size = size.small, text_font_family = font.family_monospace)
f_lab_ink(string lab) =>
    str.startswith(lab, "TP3") ? color.new(#147A4E, 0) : str.startswith(lab, "TP") ? color.new(#3DDC97, 0) : str.startswith(lab, "STOP") ? color.new(#FF5C6C, 0) : str.startswith(lab, "ENTRY") ? color.new(#E6EAF2, 0) : color.new(#7F8AA3, 0)
f_val_ink(string lab) =>
    str.startswith(lab, "STOP") ? color.new(#FF5C6C, 0) : str.startswith(lab, "TP") ? color.new(#3DDC97, 0) : color.white
string wantKey = (showTableIn ? "1" : "0") + hudSizeIn + hudPosIn + str.tostring(hudPad) + ":" + str.tostring(hudBody) + (hudNote ? "N" : "") + tpKey
if not showTableIn and not na(infoTbl)
    table.delete(infoTbl)
    infoTbl := na
    hudKey := ""
if showTableIn and wantKey != hudKey
    if not na(infoTbl)
        table.delete(infoTbl)
    int cols = hudSizeIn == "Compact" ? 3 : 2
    infoTbl := table.new(hudPosIn == "Top left" ? position.top_left : hudPosIn == "Bottom right" ? position.bottom_right : hudPosIn == "Bottom left" ? position.bottom_left : position.top_right, cols, hudBody + hudPad, bgcolor = color.new(#0B0F19, 100), border_width = 0, frame_width = 0)
    if hudPad == 1
        table.merge_cells(infoTbl, 0, 0, cols - 1, 0)
    if hudSizeIn == "Full"
        if hudNote
            table.merge_cells(infoTbl, 0, 3 + hudPad, 1, 3 + hudPad)
        table.merge_cells(infoTbl, 0, hudBody - 1 + hudPad, 1, hudBody - 1 + hudPad)
    hudKey := wantKey

if showTableIn and not na(infoTbl)
    color headBg = color.new(#121A2B, 0)
    color ink = color.white
    color muted = color.new(#7F8AA3, 0)
    color liveGreen = color.new(#3DDC97, 0)
    color rowBg = color.new(#0B0F19, 0)
    color keyBg = color.new(#121A2B, 0)
    color sideInk = not have ? ink : view.dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0)
    color stateInk = stateWord == "TRIGGERED" or stateWord == "LIVE" ? liveGreen : stateWord == "ARMED" ? color.new(#e6b35a, 0) : ink
    int bulls = (hD == 1 ? 1 : 0) + (h4 == 1 ? 1 : 0) + (h1 == 1 ? 1 : 0) + (h15 == 1 ? 1 : 0) + (h5 == 1 ? 1 : 0)
    int bears = (hD == -1 ? 1 : 0) + (h4 == -1 ? 1 : 0) + (h1 == -1 ? 1 : 0) + (h15 == -1 ? 1 : 0) + (h5 == -1 ? 1 : 0)
    string cloud = bulls > bears ? "BULL " + str.tostring(bulls) + "/5" : bears > bulls ? "BEAR " + str.tostring(bears) + "/5" : "MIX"
    color biasInk = bulls > bears ? color.new(#4C8DFF, 0) : bears > bulls ? color.new(#FF8A3D, 0) : ink
    int p = hudPad
    if p == 1
        table.cell(infoTbl, 0, 0, "", bgcolor = color.new(#0B0F19, 100), height = 6)
    if hudSizeIn == "Compact"
        f_cell(infoTbl, 0, p, "STAXBOT 2.4.7", ink, headBg, "l")
        f_cell(infoTbl, 1, p, cloud, biasInk, headBg, "l")
        f_cell(infoTbl, 2, p, stateWord, stateInk, headBg, "r")
        f_cell(infoTbl, 0, p + 1, stateTxt, sideInk, keyBg, "l")
        f_cell(infoTbl, 1, p + 1, have ? f_num(view.entry) : sessShort, ink, rowBg, "r")
        f_cell(infoTbl, 2, p + 1, have ? f_signed(openR) : gradeTxt, have ? liveGreen : muted, rowBg, "r")
        f_cell(infoTbl, 0, p + 2, tpName, have ? liveGreen : muted, keyBg, "l")
        f_cell(infoTbl, 1, p + 2, have ? f_num(tpShow) : str.tostring(tradesToday) + " / " + str.tostring(pMaxTrades), ink, rowBg, "r")
        f_cell(infoTbl, 2, p + 2, have ? str.tostring(view.rUnit, "0.#") + "R" : "", muted, rowBg, "r")
        f_cell(infoTbl, 0, p + 3, hudStale ? "INPUTS CHANGED" : "STOP", hudStale ? color.new(#e6b35a, 0) : color.new(#FF5C6C, 0), keyBg, "l")
        f_cell(infoTbl, 1, p + 3, have ? f_num(view.liveStop) : pSl, have ? color.new(#FF5C6C, 0) : ink, rowBg, "r")
        f_cell(infoTbl, 2, p + 3, have ? f_signed(stopR) : "", muted, rowBg, "r")
    else
        f_cell(infoTbl, 0, p, "STAXBOT 2.4.7", ink, headBg, "l")
        f_cell(infoTbl, 1, p, stateWord, stateInk, headBg, "r")
        f_cell(infoTbl, 0, p + 1, cloud, biasInk, keyBg, "l")
        f_cell(infoTbl, 1, p + 1, sessShort, ink, rowBg, "r")
        f_cell(infoTbl, 0, p + 2, stateTxt, sideInk, keyBg, "l")
        f_cell(infoTbl, 1, p + 2, gradeTxt, have ? ink : muted, rowBg, "r")
        int at = p + 3
        if hudNote
            f_cell(infoTbl, 0, at, note, hudStale or eng.hudReject != "" ? color.new(#e6b35a, 0) : muted, rowBg, "l")
            at += 1
        string[] hudLab = array.new_string(0)
        string[] hudVal = array.new_string(0)
        if have
            if view.on3
                array.push(hudLab, "TP3   " + str.tostring(view.rUnit * 3.0, "0.#") + "R   w" + str.tostring(view.w3))
                array.push(hudVal, f_num(view.tp3))
            if view.on2
                array.push(hudLab, "TP2   " + str.tostring(view.rUnit * 2.0, "0.#") + "R   w" + str.tostring(view.w2))
                array.push(hudVal, f_num(view.tp2))
            if view.on1
                array.push(hudLab, "TP1   " + str.tostring(view.rUnit, "0.#") + "R   w" + str.tostring(view.w1))
                array.push(hudVal, f_num(view.tp1))
            array.push(hudLab, "ENTRY")
            array.push(hudVal, f_num(view.entry))
            array.push(hudLab, "STOP")
            array.push(hudVal, f_num(view.liveStop))
        else
            array.push(hudLab, "Trades")
            array.push(hudVal, str.tostring(tradesToday) + " / " + str.tostring(pMaxTrades))
            array.push(hudLab, "Watching")
            array.push(hudVal, "break")
        if array.size(hudLab) > 0
            for i = 0 to array.size(hudLab) - 1
                string lab = array.get(hudLab, i)
                f_cell(infoTbl, 0, at, lab, f_lab_ink(lab), keyBg, "l")
                f_cell(infoTbl, 1, at, array.get(hudVal, i), f_val_ink(lab), rowBg, "r")
                at += 1
        f_cell(infoTbl, 0, p + hudBody - 1, foot, hudStale ? color.new(#e6b35a, 0) : muted, keyBg, "l")

pF = plot(emaFast, "EMA Fast", color = color.new(cloudColorIn, 0), linewidth = 2)
pS = plot(emaSlow, "EMA Slow", color = color.new(cloudColorIn, 35), linewidth = 2)
fill(pF, pS, color = color.new(cloudColorIn, 85), title = "EMA Cloud")
bgcolor(showSessBgIn and ((sessionFilterOn and inSession) or inPause) ? color.new(inPause ? #e6b35a : cloudColorIn, 92) : na, title = "Session")

if array.size(outbox) == 1
    alert(array.get(outbox, 0), alert.freq_once_per_bar_close)
else if array.size(outbox) > 1
    string joined = ""
    for i = 0 to array.size(outbox) - 1
        joined := joined + (i == 0 ? "" : ",") + array.get(outbox, i)
    alert("[" + joined + "]", alert.freq_once_per_bar_close)
