var array<importedLevel> engineCatalog = array.new<importedLevel>()
var float catalogNyHigh = na
var float catalogNyLow = na
var float catalogOrHigh = na
var float catalogOrLow = na
var bool catalogNyCovered = false
var bool catalogOrCovered = false
var float lastEqualHigh = na
var float lastEqualLow = na
var int lastEqualHighBar = na
var int lastEqualLowBar = na
float catalogPdc = request.security(syminfo.tickerid, "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
string catalogNySession = syminfo.root == "MGC" ? "0820-1130" : "0930-1600"
bool catalogNyNow = not na(time(timeframe.period, catalogNySession + ":1234567", "America/New_York"))
int catalogNyStartMinute = syminfo.root == "MGC" ? 500 : 570
int catalogNyMinute = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
bool catalogOrNow = catalogNyNow and catalogNyMinute >= catalogNyStartMinute and catalogNyMinute < catalogNyStartMinute + 15
float catalogPivotHigh = ta.pivothigh(high, catalogPivotLenIn, catalogPivotLenIn)
float catalogPivotLow = ta.pivotlow(low, catalogPivotLenIn, catalogPivotLenIn)
var array<string> importedNames = array.new_string()
var array<float> importedPrices = array.new_float()
var float asiaHi = na
var float asiaLo = na
var float asiaRunHi = na
var float asiaRunLo = na
var float lonHi = na
var float lonLo = na
var float lonRunHi = na
var float lonRunLo = na
var float onHi = na
var float onLo = na
var float onRunHi = na
var float onRunLo = na
var float seenDph = na
var float seenDpl = na
var float seen4h = na
var float seen4l = na
var float seen1h = na
var float seen1l = na
