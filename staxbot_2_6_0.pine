varip float formTp = na
var array<line> htfLn = array.new_line()
var array<label> htfLb = array.new_label()
var array<line> catalogLn = array.new_line()
var array<label> catalogLb = array.new_label()

f_num(float v) =>
    na(v) ? "null" : str.tostring(v, format.mintick)
f_ts() =>
    str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ssZ", tzIn)
f_pad2(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)
f_expiryYYMMDD() =>
    int base = timestamp(tzIn, year(time, tzIn), month(time, tzIn), dayofmonth(time, tzIn), 12, 0, 0) + dteIn * 86400000
    int dow = dayofweek(base, tzIn)
    int adj = dow == dayofweek.saturday ? base + 2 * 86400000 : dow == dayofweek.sunday ? base + 86400000 : base
    str.substring(str.tostring(year(adj, tzIn)), 2, 4) + f_pad2(month(adj, tzIn)) + f_pad2(dayofmonth(adj, tzIn))
f_strike(int side) =>
    float step = strikeStepIn
    float raw = side == 1 ? math.ceil(close / step) * step + strikesOtmIn * step : math.floor(close / step) * step - strikesOtmIn * step
    float frac = raw - math.floor(raw)
    frac == 0 ? str.tostring(math.round(raw)) + ".0" : str.tostring(raw)
f_grade(bool dispOk, bool biasOk, bool volFlag, bool sessOk, bool fifth) =>
    int score = (dispOk ? 1 : 0) + (biasOk ? 1 : 0) + (volFlag ? 1 : 0) + (sessOk ? 1 : 0) + (fifth ? 1 : 0)
    score == 5 ? "A+" : score == 4 and (dispOk or sessOk) ? "A" : "B"
f_fp() =>
    string base = str.tostring(pTp, "0.00") + "|" + pSl + "|" + str.tostring(tightAtrIn, "0.00") + "|" + str.tostring(medAtrIn, "0.00") + "|" + str.tostring(largeAtrIn, "0.00") + "|" + minGradeIn + "|" + entryLevelIn + "|" + pBe + "|" + pTrail + "|" + pDir + "|" + sessShort + "|" + dispModeIn + "|" + str.tostring(dispBodyAtrIn, "0.0") + "|" + str.tostring(maxLiveIn) + "|" + (reclaimExitIn ? "1" : "0") + "|" + (pauseOnIn ? "1" : "0") + "|" + (enableCIn ? "1" : "0") + "|" + str.tostring(breakWinIn) + "|" + str.tostring(strongAtrIn, "0.0") + "|" + str.tostring(reclaimAtrIn, "0.00") + "|" + str.tostring(minStopAtrIn, "0.0") + "|" + str.tostring(maxStopAtrIn, "0.0") + "|" + (shelfOnIn ? "1" : "0") + "|" + (gapOnIn ? "1" : "0") + "|" + roomModeIn + "|" + (extOnIn ? "1" : "0") + "|" + str.tostring(extAtrIn, "0.0") + "|" + (structOnIn ? "1" : "0") + "|" + (showHtfIn ? "1" : "0") + "|" + (momentumOnIn ? "1" : "0") + "|" + str.tostring(sweepWinIn) + "|" + (rangeOnIn ? "1" : "0") + "|" + str.tostring(rangeBarsIn) + "|" + str.tostring(rangeAtrIn, "0.0") + "|" + (intrabarOnIn ? "1" : "0")
    string extra = ""
    extra += intrabarCheckIn != true ? "|A2.intrabar=" + (intrabarCheckIn ? "1" : "0") : ""
    extra += slippageTicksIn != 0 ? "|A3.slippage=" + str.tostring(slippageTicksIn) : ""
    extra += commissionRTIn != 0 ? "|A3.commission=" + str.tostring(commissionRTIn, "0.00") : ""
    extra += riskDollarsIn != 0 ? "|A4.risk=" + str.tostring(riskDollarsIn, "0.00") : ""
    extra += maxContractsIn != 30 ? "|A4.max=" + str.tostring(maxContractsIn) : ""
    extra += useCatalogIn ? "|B1.catalog=1" : ""
    extra += catalogFeedsGradeIn ? "|B1.grade=1" : ""
    extra += equalAtrTolIn != 0.25 ? "|B1.eqAtr=" + str.tostring(equalAtrTolIn, "0.00") : ""
    extra += catalogPivotLenIn != 2 ? "|B1.pivot=" + str.tostring(catalogPivotLenIn) : ""
    extra += equalLookbackIn != 150 ? "|B1.lookback=" + str.tostring(equalLookbackIn) : ""
    extra += equalCapIn != 8 ? "|B1.cap=" + str.tostring(equalCapIn) : ""
    extra += pubAsiaIn ? "|B2.asia=1" : ""
    extra += pubLondonIn ? "|B2.london=1" : ""
    extra += pubNYIn ? "|B2.ny=1" : ""
    extra += pubAsiaWindowIn != "1900-0200" ? "|B2.asiaWindow=" + pubAsiaWindowIn : ""
    extra += pubLondonWindowIn != "0300-0700" ? "|B2.londonWindow=" + pubLondonWindowIn : ""
    extra += pubNYIndexWindowIn != "0930-1545" ? "|B2.nyIndex=" + pubNYIndexWindowIn : ""
    extra += pubNYGoldWindowIn != "0820-1330" ? "|B2.nyGold=" + pubNYGoldWindowIn : ""
    extra += newsTimesIn != "0830,1000,1400" ? "|B3.times=" + newsTimesIn : ""
    extra += newsBlockMinutesIn != 0 ? "|B3.minutes=" + str.tostring(newsBlockMinutesIn) : ""
    extra += useTickFloorIn ? "|B4.floor=1" : ""
    extra += mnqFloorTicksIn != 8 ? "|B4.mnq=" + str.tostring(mnqFloorTicksIn) : ""
    extra += mesFloorTicksIn != 4 ? "|B4.mes=" + str.tostring(mesFloorTicksIn) : ""
    extra += mgcFloorTicksIn != 10 ? "|B4.mgc=" + str.tostring(mgcFloorTicksIn) : ""
    extra += genericFloorTicksIn != 8 ? "|B4.generic=" + str.tostring(genericFloorTicksIn) : ""
    extra += useScaledHTFIn ? "|B5.scaled=1" : ""
    extra += topDownFilterIn ? "|B6a.filter=1" : ""
    extra += topDownFastEmaIn != 100 ? "|B6a.fast=" + str.tostring(topDownFastEmaIn) : ""
    extra += topDownSlowEmaIn != 200 ? "|B6a.slow=" + str.tostring(topDownSlowEmaIn) : ""
    extra += structuralTargets2In ? "|B6b.targets=1" : ""
    extra += tp2MinRIn != 1.0 ? "|B6b.minR=" + str.tostring(tp2MinRIn, "0.0") : ""
    extra += confirmBeforeFillIn ? "|B6c.confirm=1" : ""
    extra += confirmPivotLenIn != 2 ? "|B6c.pivot=" + str.tostring(confirmPivotLenIn) : ""
    base + extra
f_signed(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"
f_stopBuffer(string which) =>
    float mult = which == "Tight" ? tightAtrIn : which == "Large" ? largeAtrIn : medAtrIn
    int floorTicks = syminfo.root == "MNQ" ? mnqFloorTicksIn : syminfo.root == "MES" ? mesFloorTicksIn : syminfo.root == "MGC" ? mgcFloorTicksIn : genericFloorTicksIn
    useTickFloorIn ? math.max(floorTicks * tick, mult * armAtr) : mult * armAtr
f_stop(float anchor, int side, string which) =>
    anchor - side * f_stopBuffer(which)
f_hit(float px) =>
    low <= px and px <= high
f_stop_hit(int side, float px) =>
    side == 1 ? low <= px : high >= px
f_tp_hit(int side, float px) =>
    side == 1 ? high >= px : low <= px
f_ltfAvailable() =>
    not na(ltfHighs) and not na(ltfLows) and array.size(ltfHighs) > 0 and array.size(ltfHighs) == array.size(ltfLows)
f_wrong(int side, float shelf) =>
    float tol = reclaimAtrIn * armAtr
    side == 1 ? shelf - close >= tol : close - shelf >= tol
f_entry_hit(staxPlan p) =>
    float tol = reclaimAtrIn * armAtr
    p.origin == "shelf" ? (p.dir == 1 ? low <= p.shelf and high >= p.shelf - tol : high >= p.shelf and low <= p.shelf + tol) : f_hit(p.entry)
f_newsBlocked() =>
    bool blocked = false
    int openMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    int closeMin = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")
    if newsBlockMinutesIn > 0 and str.length(newsTimesIn) >= 4
        array<string> parts = str.split(newsTimesIn, ",")
        for part in parts
            string hhmm = str.trim(part)
            if str.length(hhmm) == 4
                float value = str.tonumber(hhmm)
                if not na(value)
                    int releaseMin = int(value / 100) * 60 + int(value % 100)
                    blocked := blocked or (openMin <= releaseMin + newsBlockMinutesIn and closeMin >= releaseMin - newsBlockMinutesIn)
    blocked
newsBlocked = f_newsBlocked()
f_ltfWalk(int side, bool needEntry, float entry, float stop, float t1, float t2, float t3, bool hit1, bool hit2, bool hit3) =>
    string certainty = "unproven"
    int n = na(ltfHighs) or na(ltfLows) ? 0 : array.size(ltfHighs)
    if not intrabarCheckIn
        certainty := "proven"
    else if n > 0 and array.size(ltfLows) == n
        bool entered = not needEntry
        bool resolved = false
        for i = 0 to n - 1
            if not resolved
                float ih = array.get(ltfHighs, i)
                float il = array.get(ltfLows, i)
                bool adverse = side == 1 ? il <= stop : ih >= stop
                bool f1 = not hit1 and (side == 1 ? ih >= t1 : il <= t1)
                bool f2 = not hit2 and (side == 1 ? ih >= t2 : il <= t2)
                bool f3 = not hit3 and (side == 1 ? ih >= t3 : il <= t3)
                bool favorable = f1 or f2 or f3
                bool entryTouch = il <= entry and ih >= entry
                if not entered
                    if entryTouch and (adverse or favorable)
                        certainty := "unproven"
                        resolved := true
                    else if adverse or favorable
                        certainty := "unproven"
                        resolved := true
                    else if entryTouch
                        entered := true
                        certainty := "proven"
                        resolved := true
                else if adverse and favorable
                    certainty := "unproven"
                    resolved := true
                else if adverse or favorable
                    certainty := "proven"
                    resolved := true
    certainty
f_totalWeight(staxPlan p) =>
    (p.on1 ? p.w1 : 0) + (p.on2 ? p.w2 : 0) + (p.on3 ? p.w3 : 0)
f_remainingWeight(staxPlan p) =>
    (p.on1 and not p.hit1 ? p.w1 : 0) + (p.on2 and not p.hit2 ? p.w2 : 0) + (p.on3 and not p.hit3 ? p.w3 : 0)
f_netR(staxPlan p, float grossR, float weightShare, bool marketExit) =>
    float selectedRisk = math.abs(p.entry - p.stop)
    float totalWeight = f_totalWeight(p)
    float share = totalWeight > 0 ? weightShare / totalWeight : 1.0
    float slipPts = slippageTicksIn * tick
    float entrySlip = p.scenario == "M" ? slipPts : 0.0
    float exitSlip = marketExit ? slipPts : 0.0
    float commissionPts = syminfo.pointvalue > 0 ? commissionRTIn / syminfo.pointvalue : 0.0
    float costPts = (entrySlip + exitSlip + commissionPts) * share
    selectedRisk > 0 ? grossR - costPts / selectedRisk : grossR
f_planQty(float entry, float selectedStop, string scenario) =>
    int result = 1
    if riskDollarsIn > 0 and not staxMode
        float marketFills = scenario == "M" ? 2.0 : 1.0
        float riskPts = math.abs(entry - selectedStop) + slippageTicksIn * tick * marketFills
        float perContract = riskPts * syminfo.pointvalue + commissionRTIn
        result := perContract > 0 ? int(math.floor(riskDollarsIn / perContract)) : 0
        result := math.min(maxContractsIn, result)
    result
f_legSplit(int qty, bool on1, bool on2, bool on3, int w1, int w2, int w3) =>
    int q1 = 0
    int q2 = 0
    int q3 = 0
    if riskDollarsIn <= 0 or staxMode
        q1 := 1
    else
        int totalW = (on1 ? w1 : 0) + (on2 ? w2 : 0) + (on3 ? w3 : 0)
        q1 := on1 and totalW > 0 ? int(math.floor(qty * w1 / totalW)) : 0
        q2 := on2 and totalW > 0 ? int(math.floor(qty * w2 / totalW)) : 0
        q3 := on3 and totalW > 0 ? int(math.floor(qty * w3 / totalW)) : 0
        int remainder = qty - q1 - q2 - q3
        if remainder > 0 and on1
            q1 += 1
            remainder -= 1
        if remainder > 0 and on2
            q2 += 1
            remainder -= 1
        if remainder > 0 and on3
            q3 += 1
    [q1, q2, q3]
f_strategyEntry(staxPlan p) =>
    if p.qty > 0 and (not confirmBeforeFillIn or p.scenario == "M")
        strategy.entry(p.setupId, p.dir == 1 ? strategy.long : strategy.short, qty = p.qty,
             limit = p.origin == "momentum" ? na : p.entry, disable_alert = true)
    true
f_strategyExitLeg(staxPlan p, string legId, float target, bool enabled, bool hit, int legQty, int legWeight) =>
    int totalW = f_totalWeight(p)
    if enabled and not hit and p.qty > 0 and totalW > 0
        if riskDollarsIn > 0 and not staxMode
            if legQty > 0
                strategy.exit(p.setupId + ":" + legId, from_entry = p.setupId, stop = p.liveStop, limit = target, qty = legQty, disable_alert = true)
        else
            strategy.exit(p.setupId + ":" + legId, from_entry = p.setupId, stop = p.liveStop, limit = target, qty_percent = 100.0 * legWeight / totalW, disable_alert = true)
    true
f_strategySync(staxPlan p) =>
    if p.state == "ARMED" and confirmBeforeFillIn and p.scenario != "M" and p.structureConfirmed and bar_index > p.confirmBar and p.qty > 0
        strategy.entry(p.setupId, p.dir == 1 ? strategy.long : strategy.short, qty = p.qty, limit = p.entry, disable_alert = true)
    else if p.state == "LIVE"
        f_strategyExitLeg(p, "TP1", p.tp1, p.on1, p.hit1, p.leg1, p.w1)
        f_strategyExitLeg(p, "TP2", p.tp2, p.on2, p.hit2, p.leg2, p.w2)
        f_strategyExitLeg(p, "TP3", p.tp3, p.on3, p.hit3, p.leg3, p.w3)
    else if p.state == "TRIGGERED"
        true
    else if p.state != "ARMED"
        strategy.cancel(p.setupId)
        strategy.cancel(p.setupId + ":TP1")
        strategy.cancel(p.setupId + ":TP2")
        strategy.cancel(p.setupId + ":TP3")
    true
f_active(string state) =>
    state == "ARMED" or state == "TRIGGERED" or state == "LIVE"
f_targets(staxPlan p) =>
    string s = ""
    if p.on1
        s := '{"id":"TP1","price":' + f_num(p.tp1) + ',"allocation":' + str.tostring(p.w1) + ',"r":' + str.tostring(p.rUnit, "0.00") + '}'
    if p.on2
        float r2 = p.struct2 and p.refRisk > 0 ? math.abs(p.tp2 - p.entry) / p.refRisk : p.rUnit * 2.0
        string bit = '{"id":"TP2","price":' + f_num(p.tp2) + ',"allocation":' + str.tostring(p.w2) + ',"r":' + str.tostring(r2, "0.00") + '}'
        s := s == "" ? bit : s + "," + bit
    if p.on3
        float r3 = p.struct3 and p.refRisk > 0 ? math.abs(p.tp3 - p.entry) / p.refRisk : p.rUnit * 3.0
        string bit3 = '{"id":"TP3","price":' + f_num(p.tp3) + ',"allocation":' + str.tostring(p.w3) + ',"r":' + str.tostring(r3, "0.00") + '}'
        s := s == "" ? bit3 : s + "," + bit3
    "[" + s + "]"
f_payload(staxPlan p, string event, string extra, string idBit) =>
    string side = p.dir == 1 ? "long" : "short"
    string opt = staxMode and event == "entry" ? ',"unmodifiedTicker":"' + (tickerOverrideIn != "" ? tickerOverrideIn : syminfo.root) + f_expiryYYMMDD() + (p.dir == 1 ? "C" : "P") + f_strike(p.dir) + '"' : ""
    string eid = idBit == "" ? p.setupId + ":" + event + ":" + str.tostring(bar_index) : p.setupId + ":" + event + ":" + idBit + ":" + str.tostring(bar_index)
    string lvl = p.level == "" ? "null" : '"' + p.level + '"'
    string additions = ""
    if event == "plan" or event == "entry" or event == "exit" or event == "stop_update"
        additions += ',"qty":' + str.tostring(p.qty) + ',"legs":[' + str.tostring(p.leg1) + ',' + str.tostring(p.leg2) + ',' + str.tostring(p.leg3) + ']'
    if event == "plan"
        additions += ',"disp_quality":{"outer_close":' + (p.outerClose ? "true" : "false") + ',"run_bars":' + str.tostring(p.runBars) + '}'
    if event == "entry"
        additions += ',"order_certainty":"' + p.entryCertainty + '"'
    if event == "exit"
        additions += ',"order_certainty":"' + p.exitCertainty + '"'
    '{"source":"staxbot","event":"' + event + '","eventId":"' + eid + '","setupId":"' + p.setupId + '","plan_id":' + str.tostring(p.planId) + ',"move_id":' + str.tostring(p.moveId) + ',"scenario":"' + p.scenario + '","state":"' + p.state + '","origin":"' + p.origin + '","side":"' + side + '","entry":' + f_num(p.entry) + ',"stop":' + f_num(p.liveStop) + ',"stop_preset":"' + p.preset + '","price":' + f_num(p.entry) + ',"target":' + f_num(p.on1 ? p.tp1 : p.on2 ? p.tp2 : p.tp3) + ',"targets":' + f_targets(p) + ',"grade":"' + p.grade + '","level":' + lvl + ',"version":"2.6.0","fp":"' + p.fp + '","timeframe":"' + timeframe.period + '","ticker":"' + syminfo.ticker + '","root":"' + syminfo.root + '","exchange":"' + syminfo.prefix + '"' + opt + extra + additions + ',"timestamp":"' + f_ts() + '"}'
f_send(string msg) =>
    array.push(outbox, msg)
    true
f_live_n() =>
    int n = 0
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.state == "LIVE" or p.state == "TRIGGERED"
                n += 1
    n
f_has(int id, string origin) =>
    bool found = false
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.moveId == id and p.origin == origin and f_active(p.state)
                found := true
    found
f_replace_older(int side, int id) =>
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.dir == side and p.state == "ARMED" and p.moveId < id
                p.state := "REPLACED"
                p.reason := "newer break"
                p.ready := false
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"replaced"', ""))
                array.set(plans, i, p)
    true
f_down(string g) =>
    g == "A+" ? "A" : "B"
f_at_level(float px) =>
    string name = ""
    float best = na
    float reach = 0.5 * atr
    if array.size(zonePx) > 0
        for i = 0 to array.size(zonePx) - 1
            float zLo = array.get(zoneLo, i)
            float zHi = array.get(zoneHi, i)
            float dist = (px >= zLo and px <= zHi) ? 0.0 : (px < zLo ? zLo - px : px - zHi)
            if dist <= reach and (na(best) or dist < best)
                best := dist
                name := array.get(zoneName, i)
    name
f_room_name(int side, float entry, float tp1) =>
    string name = ""
    float best = na
    float tol = reclaimAtrIn * armAtr
    if array.size(zonePx) > 0
        for i = 0 to array.size(zonePx) - 1
            float zLo = array.get(zoneLo, i)
            float zHi = array.get(zoneHi, i)
            float zPx = array.get(zonePx, i)
            bool contains = entry >= zLo and entry <= zHi
            bool clear = side == 1 ? (zLo - entry > tol and zLo < tp1) : (entry - zHi > tol and zHi > tp1)
            float dist = math.abs(zPx - entry)
            if not contains and clear and (na(best) or dist < best)
                best := dist
                name := array.get(zoneName, i)
    name
f_nearestSwing(array<float> highs, array<float> lows, int side, float entry, float beyond) =>
    float result = na
    if side == 1 and array.size(highs) > 0
        for i = 0 to array.size(highs) - 1
            float price = array.get(highs, i)
            float dist = price - entry
            if dist > syminfo.mintick * 0.5 and (na(beyond) or price > beyond + syminfo.mintick * 0.5) and (na(result) or dist < result - entry)
                result := price
    if side == -1 and array.size(lows) > 0
        for i = 0 to array.size(lows) - 1
            float price = array.get(lows, i)
            float dist = entry - price
            if dist > syminfo.mintick * 0.5 and (na(beyond) or price < beyond - syminfo.mintick * 0.5) and (na(result) or dist < entry - result)
                result := price
    result
f_structuralTargets2(float entry, float stop, int side) =>
    array<float> setupHighs = useScaledHTFIn and chartSeconds >= 900 ? scaledSetupHighs : setup15Highs
    array<float> setupLows = useScaledHTFIn and chartSeconds >= 900 ? scaledSetupLows : setup15Lows
    array<float> positionHighs = useScaledHTFIn and chartSeconds >= 900 ? scaledPositionHighs : h1Highs
    array<float> positionLows = useScaledHTFIn and chartSeconds >= 900 ? scaledPositionLows : h1Lows
    array<float> runnerHighs = useScaledHTFIn and chartSeconds >= 900 ? scaledRunnerHighs : h4Highs
    array<float> runnerLows = useScaledHTFIn and chartSeconds >= 900 ? scaledRunnerLows : h4Lows
    float risk = math.abs(entry - stop)
    float setupLevel = f_nearestSwing(setupHighs, setupLows, side, entry, na)
    float lead = f_stopBuffer(pSl)
    float t2 = not na(setupLevel) ? setupLevel - side * lead : na
    float runnerLevel = na
    if not na(setupLevel)
        float positionTarget = f_nearestSwing(positionHighs, positionLows, side, t2, na)
        float runnerTarget = f_nearestSwing(runnerHighs, runnerLows, side, t2, na)
        runnerLevel := na(positionTarget) ? runnerTarget : na(runnerTarget) ? positionTarget : side == 1 ? math.min(positionTarget, runnerTarget) : math.max(positionTarget, runnerTarget)
    float t3 = na
    if not na(t2) and risk > 0
        float t2Distance = side * (t2 - entry)
        float fallback = math.max(2.0 * risk, t2Distance + risk)
        t3 := na(runnerLevel) ? entry + side * fallback : runnerLevel - side * lead
    float t1 = na
    if not na(t2) and array.size(zonePx) > 0
        for i = 0 to array.size(zonePx) - 1
            float price = array.get(zonePx, i)
            float dist = side * (price - entry)
            float t2Dist = side * (t2 - entry)
            if dist > syminfo.mintick * 0.5 and dist < t2Dist - syminfo.mintick * 0.5 and (na(t1) or dist < side * (t1 - entry))
                t1 := price
    if na(t1) and not na(t2)
        t1 := entry + side * (side * (t2 - entry)) * 0.5
    bool minRok = tp2MinRIn == 0 or (risk > 0 and not na(t2) and side * (t2 - entry) >= tp2MinRIn * risk)
    bool ordered = not na(t1) and not na(t2) and not na(t3) and side * (t1 - entry) > 0 and side * (t2 - t1) > 0 and side * (t3 - t2) > 0
    [t1, t2, t3, ordered and minRok]
f_catalogSet(int slot, float price, string kind, int side, bool major, bool live, bool covered) =>
    if array.size(engineCatalog) > slot
        importedLevel level = array.get(engineCatalog, slot)
        bool fresh = na(level.price) != na(price) or (not na(price) and math.abs(level.price - price) > syminfo.mintick * 0.5)
        level.price := price
        level.kind := kind
        level.side := side
        level.originMajor := major
        level.major := major and not level.swept
        level.live := live
        level.covered := covered
        if fresh
            level.major := major
            level.swept := false
            level.sweepConfirmed := false
            level.flipped := false
            level.born := bar_index
        array.set(engineCatalog, slot, level)
    true
f_catalogFeedable(importedLevel level) =>
    level.covered and not level.live and not na(level.price) and (not level.swept or (level.originMajor and level.flipped))
f_catalogPrice(string kind) =>
    float price = na
    if array.size(engineCatalog) > 0
        for i = 0 to array.size(engineCatalog) - 1
            importedLevel level = array.get(engineCatalog, i)
            if level.kind == kind and not na(level.price)
                price := level.price
    price
f_runBars(int side) =>
    bool twoAligned = bar_index >= 1 and (side == 1 ? close > open and close[1] > open[1] : close < open and close[1] < open[1]) and math.abs(close - open[1]) >= 1.5 * atr
    bool threeAligned = bar_index >= 2 and (side == 1 ? close > open and close[1] > open[1] and close[2] > open[2] : close < open and close[1] < open[1] and close[2] < open[2]) and math.abs(close - open[2]) >= 1.5 * atr
    threeAligned ? 3 : twoAligned ? 2 : 0
f_positionOk(int side, float extreme, float closeP) =>
    float bodyTop = math.max(positionOpen, positionClose)
    float bodyBottom = math.min(positionOpen, positionClose)
    not na(positionOpen) and not na(extreme) and (side == 1 ? extreme >= positionLow and extreme <= bodyTop and closeP >= bodyBottom : extreme <= positionHigh and extreme >= bodyBottom and closeP <= bodyTop)
f_keep3(array<float> src, float v) =>
    if not na(v)
        array.push(src, v)
        if array.size(src) > 3
            array.shift(src)
    true
f_pruneSwings(array<float> src, int side) =>
    if array.size(src) > 0
        for i = array.size(src) - 1 to 0
            float price = array.get(src, i)
            if (side == 1 and high > price) or (side == -1 and low < price)
                array.remove(src, i)
    true
f_cancel_failed(int side) =>
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.dir == side and p.state == "ARMED"
                p.state := "CANCELLED"
                p.reason := "failed breakout"
                p.ready := false
                p.resolvedBar := bar_index
                f_send(f_payload(p, "plan_cancel", ',"reason":"failed breakout"', ""))
                array.set(plans, i, p)
    true
f_try_arm(string origin, int side, float entry, float tightPx, float medPx, float anchor, float shelf, int swingBar, float zoneHi, float zoneLo, int zoneFrom, bool flag1, bool htfSweep) =>
    eng.planSeq += 1
    float med = f_stop(medPx, side, "Medium")
    float rawTight = f_stop(tightPx, side, "Tight")
    float rawLarge = f_stop(anchor, side, "Large")
    float dM = (entry - med) * side
    float dT = (entry - rawTight) * side
    float dL = (entry - rawLarge) * side
    float dT2 = na(dM) ? na : ((na(dT) or dT > dM or dT <= 0) ? dM : dT)
    float dL2 = na(dM) ? na : ((na(dL) or dL < dM) ? dM : dL)
    float tightStop = entry - side * dT2
    float largeStop = entry - side * dL2
    float sel = na(dM) ? na : pSl == "Tight" ? tightStop : pSl == "Large" ? largeStop : med
    float ref = dM
    float targetStop = not na(sel) and (entry - sel) * side < minStopAtrIn * armAtr ? entry - side * minStopAtrIn * armAtr : sel
    float t1 = entry + side * pTp * ref
    float t2 = entry + side * pTp * 2.0 * ref
    float t3 = entry + side * pTp * 3.0 * ref
    bool ladder2 = true
    bool ladder3 = true
    [structT1, structT2, structT3, structTargetsOk] = f_structuralTargets2(entry, targetStop, side)
    if structuralTargets2In
        t1 := structT1
        t2 := structT2
        t3 := structT3
        ladder2 := false
        ladder3 := false
    if structOnIn and not na(t1) and array.size(zonePx) > 0
        float nxt1 = na
        float nxt2 = na
        for i = 0 to array.size(zonePx) - 1
            float zPx = array.get(zonePx, i)
            bool beyond = side == 1 ? zPx > t1 : zPx < t1
            if beyond
                if na(nxt1) or (side == 1 ? zPx < nxt1 : zPx > nxt1)
                    nxt2 := nxt1
                    nxt1 := zPx
                else if na(nxt2) or (side == 1 ? zPx < nxt2 : zPx > nxt2)
                    nxt2 := zPx
        if not na(nxt1)
            t2 := nxt1
            ladder2 := false
        if not na(nxt2) and (side == 1 ? nxt2 > t2 : nxt2 < t2)
            t3 := nxt2
            ladder3 := false
        else if not ladder2 and (side == 1 ? t3 <= t2 : t3 >= t2)
            t3 := t2 + side * pTp * ref
            ladder3 := false
    bool distanceOk = dM >= minStopAtrIn * armAtr and (maxStopAtrIn <= 0 or dM <= maxStopAtrIn * armAtr)
    bool ordered = side == 1 ? med < entry and entry < t1 and t1 < t2 and t2 < t3 : med > entry and entry > t1 and t1 > t2 and t2 > t3
    float r1 = ref > 0 ? math.abs(t1 - entry) / ref : na
    float r2 = ref > 0 ? math.abs(t2 - entry) / ref : na
    float r3 = ref > 0 ? math.abs(t3 - entry) / ref : na
    bool labelsOk = not na(r1) and math.abs(r1 - pTp) < 0.0001 and (not ladder2 or math.abs(r2 - pTp * 2.0) < 0.0001) and (not ladder3 or math.abs(r3 - pTp * 3.0) < 0.0001)
    bool geometryOk = ordered and labelsOk and (not structuralTargets2In or structTargetsOk)
    int clock = hour(time, tzIn) * 60 + minute(time, tzIn)
    bool gradeSess = (clock >= 180 and clock < 360) or (clock >= 500 and clock < 690)
    string atLevel = f_at_level(entry)
    string g = f_grade(flag1, side == 1 ? bias == 1 : bias == -1, volume > volSma, gradeSess, atLevel != "")
    bool topDownException = flag1 and (htfSweep or atLevel != "")
    bool topDownOk = not topDownFilterIn or side == topDownDirection or origin == "sweep" or topDownException
    if origin == "sweep"
        g := htfSweep ? "A+" : "B"
    string roomName = geometryOk and distanceOk ? f_room_name(side, entry, t1) : ""
    bool roomHit = roomName != ""
    if roomHit and roomModeIn == "Downgrade"
        g := f_down(g)
    bool extended = extOnIn and origin != "sweep" and math.abs(entry - emaSlow) > extAtrIn * atr
    if extended
        g := f_down(g)
    bool take = minGradeIn == "Off" or g == "A+" or (minGradeIn == "A" and g == "A")
    if not topDownOk
        eng.hudReject := "PLAN REJECTED: top-down direction."
    else if not geometryOk
        eng.hudReject := "PLAN REJECTED: geometry."
        log.info("plan_id " + str.tostring(eng.planSeq) + " PLAN REJECTED: geometry")
    else if not distanceOk
        eng.hudReject := "PLAN REJECTED: stop distance."
        log.info("plan_id " + str.tostring(eng.planSeq) + " PLAN REJECTED: stop distance")
    else if roomHit and roomModeIn == "Reject"
        eng.hudReject := "PLAN REJECTED: no room (" + roomName + ")"
        log.info("plan_id " + str.tostring(eng.planSeq) + " PLAN REJECTED: no room (" + roomName + ")")
    else if take and not f_has(moveIdNow, origin)
        float minDist = minStopAtrIn * armAtr
        float dSel = (entry - sel) * side
        if not na(dSel) and dSel < minDist
            sel := entry - side * minDist
        staxPlan p = staxPlan.new()
        p.planId := eng.planSeq
        p.moveId := moveIdNow
        p.scenario := origin == "gap" ? "A" : origin == "sweep" ? "C" : origin == "momentum" ? "M" : "B"
        p.origin := origin
        p.dir := side
        p.entry := entry
        p.anchor := pSl == "Tight" ? tightPx : pSl == "Large" ? anchor : medPx
        p.preset := pSl
        p.stop := sel
        p.liveStop := sel
        p.tp1 := t1
        p.tp2 := t2
        p.tp3 := t3
        p.refRisk := ref
        p.grade := g
        p.state := "ARMED"
        p.createdBar := bar_index
        p.expiryBar := bar_index + setupExpiryIn
        p.shelf := shelf
        p.inv := origin == "gap" ? tightPx : shelf
        p.swingBar := swingBar
        p.zoneHi := zoneHi
        p.zoneLo := zoneLo
        p.zoneFrom := zoneFrom
        p.on1 := tp1OnIn
        p.on2 := tp2OnIn
        p.on3 := tp3OnIn
        p.rUnit := pTp
        p.w1 := tp1WIn
        p.w2 := tp2WIn
        p.w3 := tp3WIn
        p.setupId := syminfo.ticker + ":" + str.tostring(time) + ":" + str.tostring(eng.planSeq)
        p.qty := f_planQty(entry, sel, p.scenario)
        [split1, split2, split3] = f_legSplit(p.qty, p.on1, p.on2, p.on3, p.w1, p.w2, p.w3)
        p.leg1 := split1
        p.leg2 := split2
        p.leg3 := split3
        float signalRange = high - low
        p.outerClose := signalRange > 0 and (side == 1 ? close >= high - signalRange * 0.25 : close <= low + signalRange * 0.25)
        p.runBars := f_runBars(side)
        p.fp := f_fp()
        p.reason := ""
        p.level := atLevel
        p.extended := extended
        p.struct2 := not ladder2
        p.struct3 := not ladder3
        array.push(plans, p)
        // Keep retest limits live while ARMED; the state machine still decides fills and alerts.
        f_strategyEntry(p)
        f_send(f_payload(p, "plan", "", ""))
        eng.hudReject := ""
    true

if barstate.isfirst
    for i = 0 to 4
        array.push(engineCatalog, importedLevel.new())

f_note(int at, float y, string txt) =>
    label.new(at, y, txt, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = color.new(#E6EAF2, 0), size = size.small)
f_price_tag(int at, float y, string txt, color ink) =>
    label.new(at, y, txt, style = label.style_label_right, color = color.new(#0B0F19, 0), textcolor = ink, size = size.normal, text_font_family = font.family_monospace)
f_exit_mark(int side, float y, string txt, color ink) =>
    label.new(bar_index, y, txt, style = side == 1 ? label.style_label_down : label.style_label_up, color = ink, textcolor = color.white, size = size.tiny, text_font_family = font.family_monospace)
f_drop_line(line l) =>
    if not na(l)
        line.delete(l)
    true
f_drop_lab(label l) =>
    if not na(l)
        label.delete(l)
    true
f_drop_box(box b) =>
    if not na(b)
        box.delete(b)
    true
f_erase(staxPlan p) =>
    f_drop_line(p.lnEn)
    f_drop_line(p.lnSl)
    f_drop_line(p.ln1)
    f_drop_line(p.ln2)
    f_drop_line(p.ln3)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbExit)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lnEn := na
    p.lnSl := na
    p.ln1 := na
    p.ln2 := na
    p.ln3 := na
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbExit := na
    p.lbRange := na
    p.lbBos := na
    p.rangeBox := na
    p.erased := true
    p
f_grey(staxPlan p) =>
    color ink = color.new(#7F8AA3, 55)
    f_drop_line(p.lnSl)
    f_drop_line(p.ln1)
    f_drop_line(p.ln2)
    f_drop_line(p.ln3)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbExit)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lnSl := na
    p.ln1 := na
    p.ln2 := na
    p.ln3 := na
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbExit := na
    p.lbBos := na
    p.rangeBox := na
    if not na(p.lnEn)
        line.set_color(p.lnEn, ink)
        line.set_width(p.lnEn, 1)
        line.set_x2(p.lnEn, bar_index)
    int tagAt = p.resolvedBar >= 0 ? p.resolvedBar : bar_index
    p.lbRange := label.new(tagAt, p.entry, p.state, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = ink, size = size.small)
    p.greyed := true
    p
f_review(staxPlan p) =>
    color ink = color.new(#7F8AA3, 0)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbExit)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbExit := na
    p.lbBos := na
    p.rangeBox := na
    if not na(p.lnEn)
        line.set_color(p.lnEn, ink)
        line.set_x2(p.lnEn, bar_index)
    if not na(p.lnSl)
        line.set_color(p.lnSl, ink)
        line.set_x2(p.lnSl, bar_index)
    if not na(p.ln1)
        line.set_color(p.ln1, ink)
        line.set_x2(p.ln1, bar_index)
    if not na(p.ln2)
        line.set_color(p.ln2, ink)
        line.set_x2(p.ln2, bar_index)
    if not na(p.ln3)
        line.set_color(p.ln3, ink)
        line.set_x2(p.ln3, bar_index)
    int tagAt = p.resolvedBar >= 0 ? p.resolvedBar : bar_index
    string tagTxt = p.reason == "" ? p.state : p.state + " " + p.reason
    p.lbRange := label.new(tagAt, p.entry, tagTxt, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = ink, size = size.small)
    p.greyed := true
    p
f_kind(string origin) =>
    origin == "gap" ? "gap" : origin == "sweep" ? "sweep" : origin == "momentum" ? "momentum" : "shelf"
f_thin(staxPlan p) =>
    f_drop_line(p.lnSl)
    f_drop_line(p.ln1)
    f_drop_line(p.ln2)
    f_drop_line(p.ln3)
    f_drop_lab(p.lbEn)
    f_drop_lab(p.lbSl)
    f_drop_lab(p.lb1)
    f_drop_lab(p.lb2)
    f_drop_lab(p.lb3)
    f_drop_lab(p.lbFill)
    f_drop_lab(p.lbRange)
    f_drop_lab(p.lbBos)
    f_drop_box(p.rangeBox)
    p.lnSl := na
    p.ln1 := na
    p.ln2 := na
    p.ln3 := na
    p.lbEn := na
    p.lbSl := na
    p.lb1 := na
    p.lb2 := na
    p.lb3 := na
    p.lbFill := na
    p.lbRange := na
    p.lbBos := na
    p.rangeBox := na
    color ink = color.new(#7F8AA3, 35)
    int left = math.max(0, p.createdBar - 24)
    if na(p.lnEn)
        p.lnEn := line.new(left, p.entry, bar_index, p.entry, color = ink, style = line.style_dashed, width = 1)
    else
        line.set_color(p.lnEn, ink)
        line.set_style(p.lnEn, line.style_dashed)
        line.set_width(p.lnEn, 1)
        line.set_x1(p.lnEn, left)
        line.set_x2(p.lnEn, bar_index)
        line.set_y1(p.lnEn, p.entry)
        line.set_y2(p.lnEn, p.entry)
    p
f_draw(staxPlan p) =>
    if not showDrawingsIn or p.erased
        p
    else if not f_active(p.state)
        if resolvedIn == "Remove"
            f_erase(p)
        else if not p.greyed and resolvedIn == "Review"
            f_review(p)
        else if not p.greyed
            f_grey(p)
        else
            p
    else if f_live_n() > 0 and p.state == "ARMED"
        f_thin(p)
    else
        int left = math.max(0, p.createdBar - 24)
        int right = bar_index
        color sideInk = p.dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0)
        string stopTxt = p.liveStop != p.stop ? "STOP (trail)  " + f_num(p.liveStop) : "STOP  " + f_num(p.liveStop)
        if not na(p.lnEn) and na(p.lnSl)
            line.delete(p.lnEn)
            p.lnEn := na
        if na(p.lnEn)
            float top = math.max(p.zoneHi, p.zoneLo)
            float bot = math.min(p.zoneHi, p.zoneLo)
            int boxLeft = math.max(0, p.zoneFrom)
            p.rangeBox := box.new(boxLeft, top, p.createdBar, bot, border_color = color.new(sideInk, 0), border_width = 2, border_style = line.style_solid, bgcolor = color.new(sideInk, 70))
            p.lbRange := f_note(boxLeft, (top + bot) / 2.0, p.origin == "gap" ? "GAP" : "RANGE")
            p.lbBos := f_note(p.createdBar, p.shelf, "BREAK")
            p.lnEn := line.new(left, p.entry, right, p.entry, color = color.new(#E6EAF2, 0), style = line.style_solid, width = 2)
            p.lnSl := line.new(left, p.liveStop, right, p.liveStop, color = p.liveStop != p.stop ? color.new(#9AA3B5, 0) : color.new(#FF5C6C, 0), style = line.style_solid, width = 3)
            p.lbEn := f_price_tag(right, p.entry, "ENTRY  " + f_num(p.entry), color.new(#E6EAF2, 0))
            p.lbSl := f_price_tag(right, p.liveStop, stopTxt, p.liveStop != p.stop ? color.new(#9AA3B5, 0) : color.new(#FF5C6C, 0))
            if p.on1
                p.ln1 := line.new(left, p.tp1, right, p.tp1, color = color.new(#3DDC97, 0), style = line.style_solid, width = 2)
                p.lb1 := f_price_tag(right, p.tp1, "TP1  " + f_num(p.tp1) + "   " + str.tostring(p.rUnit, "0.#") + "R", color.new(#3DDC97, 0))
            if p.on2
                p.ln2 := line.new(left, p.tp2, right, p.tp2, color = color.new(#3DDC97, 0), style = line.style_solid, width = 3)
                p.lb2 := f_price_tag(right, p.tp2, p.struct2 ? "TP2  " + f_num(p.tp2) : "TP2  " + f_num(p.tp2) + "   " + str.tostring(p.rUnit * 2.0, "0.#") + "R", color.new(#3DDC97, 0))
            if p.on3
                p.ln3 := line.new(left, p.tp3, right, p.tp3, color = color.new(#147A4E, 0), style = line.style_solid, width = 3)
                p.lb3 := f_price_tag(right, p.tp3, p.struct3 ? "TP3  " + f_num(p.tp3) : "TP3  " + f_num(p.tp3) + "   " + str.tostring(p.rUnit * 3.0, "0.#") + "R", color.new(#147A4E, 0))
        else
            line.set_x1(p.lnEn, left)
            line.set_x2(p.lnEn, right)
            line.set_x1(p.lnSl, left)
            line.set_x2(p.lnSl, right)
            line.set_y1(p.lnSl, p.liveStop)
            line.set_y2(p.lnSl, p.liveStop)
            if p.liveStop != p.stop
                line.set_color(p.lnSl, color.new(#9AA3B5, 0))
            if not na(p.ln1)
                line.set_x1(p.ln1, left)
                line.set_x2(p.ln1, right)
            if not na(p.ln2)
                line.set_x1(p.ln2, left)
                line.set_x2(p.ln2, right)
            if not na(p.ln3)
                line.set_x1(p.ln3, left)
                line.set_x2(p.ln3, right)
            label.set_x(p.lbEn, right)
            label.set_x(p.lbSl, right)
            label.set_y(p.lbSl, p.liveStop)
            label.set_text(p.lbSl, stopTxt)
            label.set_textcolor(p.lbSl, p.liveStop != p.stop ? color.new(#9AA3B5, 0) : color.new(#FF5C6C, 0))
            if not na(p.lb1)
                label.set_x(p.lb1, right)
            if not na(p.lb2)
                label.set_x(p.lb2, right)
            if not na(p.lb3)
                label.set_x(p.lb3, right)
        p

f_near(staxPlan p) =>
    p.on1 ? p.tp1 : p.on2 ? p.tp2 : p.tp3
f_done(staxPlan p) =>
    (not p.on1 or p.hit1) and (not p.on2 or p.hit2) and (not p.on3 or p.hit3)
f_close_trade(staxPlan p, float px, string why, string targetId) =>
    p.state := "CLOSED"
    p.reason := why
    p.resolvedBar := bar_index
    float rr = p.refRisk > 0 ? p.dir * (px - p.entry) / p.refRisk : 0.0
    float netR = f_netR(p, rr, f_remainingWeight(p), true)
    color ink = why == "SL" ? color.new(#FF5C6C, 0) : color.new(#3DDC97, 0)
    if showDrawingsIn
        if not na(p.lbExit)
            label.delete(p.lbExit)
        p.lbExit := f_exit_mark(p.dir, px, why + " " + f_signed(rr), ink)
    if sendExitAlertsIn
        string extra = ',"exit_price":' + f_num(px) + ',"reason":"' + why + '","targetId":"' + targetId + '","realizedR":' + str.tostring(rr, "0.00") + ',"r_net":' + str.tostring(netR, "0.00")
        f_send(f_payload(p, "exit", extra, targetId + ":" + why))
    if targetId == "RECLAIM" or targetId == "FLAT" or targetId == "FLAT_MISSING"
        strategy.close(p.setupId, comment = why, immediately = true, disable_alert = true)
    p
f_mark_tp(staxPlan p, string which, float px, float rr) =>
    float legWeight = which == "TP1" ? p.w1 : which == "TP2" ? p.w2 : p.w3
    float netR = f_netR(p, rr, legWeight, false)
    if showDrawingsIn
        if not na(p.lbExit)
            label.delete(p.lbExit)
        p.lbExit := f_exit_mark(p.dir, px, which + " " + f_signed(rr), color.new(#3DDC97, 0))
    if sendExitAlertsIn
        string extra = ',"exit_price":' + f_num(px) + ',"reason":"TP","targetId":"' + which + '","realizedR":' + str.tostring(rr, "0.00") + ',"r_net":' + str.tostring(netR, "0.00")
        f_send(f_payload(p, "exit", extra, which + ":TP"))
    p

if barstate.isrealtime and not barstate.isconfirmed and intrabarOnIn
    if bar_index != formingBar
        formingBar := bar_index
        formingNow := false
        formSide := 0
    if not formingNow and not na(armAtr) and not na(atr)
        float tolF = reclaimAtrIn * armAtr
        bool bodyOk = math.abs(close - open) >= dispBodyAtrIn * atr
        float upPen = (not na(rangeHigh) and high >= rangeHigh + tolF) ? high - rangeHigh : na
        float dnPen = (not na(rangeLow) and low <= rangeLow - tolF) ? rangeLow - low : na
        int pick = 0
        if bodyOk and not na(upPen) and (na(dnPen) or upPen >= dnPen)
            pick := 1
        else if bodyOk and not na(dnPen)
            pick := -1
        if pick != 0
            formingNow := true
            formSide := pick
            formEntry := pick == 1 ? rangeHigh : rangeLow
            float medPx = pick == 1 ? low : high
            formStop := f_stop(medPx, pick, "Medium")
            float refF = (formEntry - formStop) * pick
            formTp := formEntry + pick * pTp * refF
            string fLvl = f_at_level(formEntry)
            string fLvlJson = fLvl == "" ? "null" : '"' + fLvl + '"'
            string fSide = pick == 1 ? "long" : "short"
            string formMsg = '{"source":"staxbot","event":"break_forming","eventId":"break_forming:' + str.tostring(bar_index) + '","version":"2.6.0","fp":"' + f_fp() + '","provisional":true,"side":"' + fSide + '","entry":' + f_num(formEntry) + ',"stop":' + f_num(formStop) + ',"target":' + f_num(formTp) + ',"level":' + fLvlJson + ',"timestamp":"' + f_ts() + '"}'
            alert(formMsg, alert.freq_once_per_bar)

if barstate.isconfirmed
    int ctOpenMin = hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")
    int ctPrevMin = hour(time[1], "America/Chicago") * 60 + minute(time[1], "America/Chicago")
    if ctOpenMin >= 17 * 60 and (na(ctPrevMin) or ctPrevMin < 17 * 60)
        tradesToday := 0
    array.clear(outbox)
    bool wasForming = formingNow
    int wasSide = formSide
    float wasEntry = formEntry
    float wasStop = formStop
    float wasTp = formTp
    formingNow := false

    if barstate.isconfirmed
        if bar_index > 0 and inAsiaSess[1] and not inAsiaSess
            asiaHi := asiaRunHi
            asiaLo := asiaRunLo
            asiaRunHi := na
            asiaRunLo := na
        if inAsiaSess
            asiaRunHi := na(asiaRunHi) ? high : math.max(asiaRunHi, high)
            asiaRunLo := na(asiaRunLo) ? low : math.min(asiaRunLo, low)
        if bar_index > 0 and inLonSess[1] and not inLonSess
            lonHi := lonRunHi
            lonLo := lonRunLo
            lonRunHi := na
            lonRunLo := na
        if inLonSess
            lonRunHi := na(lonRunHi) ? high : math.max(lonRunHi, high)
            lonRunLo := na(lonRunLo) ? low : math.min(lonRunLo, low)
        if bar_index > 0 and inOnSess[1] and not inOnSess
            onHi := onRunHi
            onLo := onRunLo
            onRunHi := na
            onRunLo := na
        if inOnSess
            onRunHi := na(onRunHi) ? high : math.max(onRunHi, high)
            onRunLo := na(onRunLo) ? low : math.min(onRunLo, low)
        if not na(dPh) and (na(seenDph) or dPh != seenDph)
            f_keep3(dHighs, dPh)
            seenDph := dPh
        if not na(dPl) and (na(seenDpl) or dPl != seenDpl)
            f_keep3(dLows, dPl)
            seenDpl := dPl
        if not na(h4Ph) and (na(seen4h) or h4Ph != seen4h)
            f_keep3(h4Highs, h4Ph)
            seen4h := h4Ph
        if not na(h4Pl) and (na(seen4l) or h4Pl != seen4l)
            f_keep3(h4Lows, h4Pl)
            seen4l := h4Pl
        if not na(h1Ph) and (na(seen1h) or h1Ph != seen1h)
            f_keep3(h1Highs, h1Ph)
            seen1h := h1Ph
        if not na(h1Pl) and (na(seen1l) or h1Pl != seen1l)
            f_keep3(h1Lows, h1Pl)
            seen1l := h1Pl

        if not na(setup15Ph) and (na(seenSetup15High) or setup15Ph != seenSetup15High)
            f_keep3(setup15Highs, setup15Ph)
            seenSetup15High := setup15Ph
        if not na(setup15Pl) and (na(seenSetup15Low) or setup15Pl != seenSetup15Low)
            f_keep3(setup15Lows, setup15Pl)
            seenSetup15Low := setup15Pl
        if useScaledHTFIn and chartSeconds >= 900
            if not na(scaledSetupPh) and (na(seenScaledSetupHigh) or scaledSetupPh != seenScaledSetupHigh)
                f_keep3(scaledSetupHighs, scaledSetupPh)
                seenScaledSetupHigh := scaledSetupPh
            if not na(scaledSetupPl) and (na(seenScaledSetupLow) or scaledSetupPl != seenScaledSetupLow)
                f_keep3(scaledSetupLows, scaledSetupPl)
                seenScaledSetupLow := scaledSetupPl
            if not na(scaledPositionPh) and (na(seenScaledPositionHigh) or scaledPositionPh != seenScaledPositionHigh)
                f_keep3(scaledPositionHighs, scaledPositionPh)
                seenScaledPositionHigh := scaledPositionPh
            if not na(scaledPositionPl) and (na(seenScaledPositionLow) or scaledPositionPl != seenScaledPositionLow)
                f_keep3(scaledPositionLows, scaledPositionPl)
                seenScaledPositionLow := scaledPositionPl
            if not na(scaledRunnerPh) and (na(seenScaledRunnerHigh) or scaledRunnerPh != seenScaledRunnerHigh)
                f_keep3(scaledRunnerHighs, scaledRunnerPh)
                seenScaledRunnerHigh := scaledRunnerPh
            if not na(scaledRunnerPl) and (na(seenScaledRunnerLow) or scaledRunnerPl != seenScaledRunnerLow)
                f_keep3(scaledRunnerLows, scaledRunnerPl)
                seenScaledRunnerLow := scaledRunnerPl
            if not na(scaledSlowPh) and (na(seenScaledSlowHigh) or scaledSlowPh != seenScaledSlowHigh)
                f_keep3(scaledSlowHighs, scaledSlowPh)
                seenScaledSlowHigh := scaledSlowPh
            if not na(scaledSlowPl) and (na(seenScaledSlowLow) or scaledSlowPl != seenScaledSlowLow)
                f_keep3(scaledSlowLows, scaledSlowPl)
                seenScaledSlowLow := scaledSlowPl

        f_pruneSwings(setup15Highs, 1)
        f_pruneSwings(setup15Lows, -1)
        f_pruneSwings(scaledSetupHighs, 1)
        f_pruneSwings(scaledSetupLows, -1)
        f_pruneSwings(scaledPositionHighs, 1)
        f_pruneSwings(scaledPositionLows, -1)
        f_pruneSwings(scaledRunnerHighs, 1)
        f_pruneSwings(scaledRunnerLows, -1)
        f_pruneSwings(scaledSlowHighs, 1)
        f_pruneSwings(scaledSlowLows, -1)

        if useCatalogIn
            if catalogNyNow and not catalogNyNow[1]
                catalogNyHigh := na
                catalogNyLow := na
                catalogOrHigh := na
                catalogOrLow := na
                catalogNyCovered := false
                catalogOrCovered := false
            if catalogNyNow
                catalogNyHigh := na(catalogNyHigh) ? high : math.max(catalogNyHigh, high)
                catalogNyLow := na(catalogNyLow) ? low : math.min(catalogNyLow, low)
                if catalogOrNow
                    catalogOrHigh := na(catalogOrHigh) ? high : math.max(catalogOrHigh, high)
                    catalogOrLow := na(catalogOrLow) ? low : math.min(catalogOrLow, low)
                else if catalogNyMinute >= catalogNyStartMinute + 15
                    catalogOrCovered := true
            if bar_index > 0 and not catalogNyNow and catalogNyNow[1]
                catalogNyCovered := true
                catalogOrCovered := true

            f_catalogSet(0, catalogPdc, "PDC", 0, false, false, not na(catalogPdc))
            f_catalogSet(1, catalogNyHigh, "NYH", 1, true, catalogNyNow, catalogNyCovered)
            f_catalogSet(2, catalogNyLow, "NYL", -1, true, catalogNyNow, catalogNyCovered)
            f_catalogSet(3, catalogOrHigh, "ORH", 1, false, catalogOrNow, catalogOrCovered)
            f_catalogSet(4, catalogOrLow, "ORL", -1, false, catalogOrNow, catalogOrCovered)

            if not na(catalogPivotHigh)
                int pivotBarHigh = bar_index - catalogPivotLenIn
                if not na(lastEqualHigh) and not na(lastEqualHighBar)
                    float equalLevelHigh = math.max(catalogPivotHigh, lastEqualHigh)
                    float toleranceHigh = equalAtrTolIn * atr
                    bool validHigh = not na(toleranceHigh) and math.abs(catalogPivotHigh - lastEqualHigh) <= toleranceHigh and pivotBarHigh - lastEqualHighBar <= equalLookbackIn
                    int highAge = math.min(bar_index - lastEqualHighBar, 500)
                    if validHigh
                        for j = 0 to highAge
                            if high[j] > equalLevelHigh
                                validHigh := false
                        if array.size(engineCatalog) > 5
                            for j = 5 to array.size(engineCatalog) - 1
                                importedLevel existing = array.get(engineCatalog, j)
                                if not existing.swept and existing.side == 1 and math.abs(existing.price - equalLevelHigh) <= toleranceHigh
                                    validHigh := false
                    if validHigh
                        array.push(engineCatalog, importedLevel.new(equalLevelHigh, "EQH", 1, true, true, false, true, false, false, false, bar_index))
                        int eqHighCount = 0
                        for j = 5 to array.size(engineCatalog) - 1
                            importedLevel countedHigh = array.get(engineCatalog, j)
                            if countedHigh.kind == "EQH"
                                eqHighCount += 1
                        if eqHighCount > equalCapIn
                            for j = 5 to array.size(engineCatalog) - 1
                                importedLevel oldestHigh = array.get(engineCatalog, j)
                                if oldestHigh.kind == "EQH"
                                    array.remove(engineCatalog, j)
                                    break
                lastEqualHigh := catalogPivotHigh
                lastEqualHighBar := pivotBarHigh

            if not na(catalogPivotLow)
                int pivotBarLow = bar_index - catalogPivotLenIn
                if not na(lastEqualLow) and not na(lastEqualLowBar)
                    float equalLevelLow = math.min(catalogPivotLow, lastEqualLow)
                    float toleranceLow = equalAtrTolIn * atr
                    bool validLow = not na(toleranceLow) and math.abs(catalogPivotLow - lastEqualLow) <= toleranceLow and pivotBarLow - lastEqualLowBar <= equalLookbackIn
                    int lowAge = math.min(bar_index - lastEqualLowBar, 500)
                    if validLow
                        for j = 0 to lowAge
                            if low[j] < equalLevelLow
                                validLow := false
                        if array.size(engineCatalog) > 5
                            for j = 5 to array.size(engineCatalog) - 1
                                importedLevel existing = array.get(engineCatalog, j)
                                if not existing.swept and existing.side == -1 and math.abs(existing.price - equalLevelLow) <= toleranceLow
                                    validLow := false
                    if validLow
                        array.push(engineCatalog, importedLevel.new(equalLevelLow, "EQL", -1, true, true, false, true, false, false, false, bar_index))
                        int eqLowCount = 0
                        for j = 5 to array.size(engineCatalog) - 1
                            importedLevel countedLow = array.get(engineCatalog, j)
                            if countedLow.kind == "EQL"
                                eqLowCount += 1
                        if eqLowCount > equalCapIn
                            for j = 5 to array.size(engineCatalog) - 1
                                importedLevel oldestLow = array.get(engineCatalog, j)
                                if oldestLow.kind == "EQL"
                                    array.remove(engineCatalog, j)
                                    break
                lastEqualLow := catalogPivotLow
                lastEqualLowBar := pivotBarLow

            if array.size(engineCatalog) > 0
                for i = 0 to array.size(engineCatalog) - 1
                    importedLevel level = array.get(engineCatalog, i)
                    if not na(level.price) and level.covered and not level.live and level.side != 0 and level.born < bar_index
                        bool tradedThrough = level.side == 1 ? high > level.price : low < level.price
                        bool bufferedReversal = f_stopBuffer("Medium") > 0 and (level.side == 1 ? high - level.price >= f_stopBuffer("Medium") and close < level.price : level.price - low >= f_stopBuffer("Medium") and close > level.price)
                        if tradedThrough
                            level.swept := true
                            level.major := false
                        if bufferedReversal
                            level.sweepConfirmed := true
                        if (level.side == 1 and close > level.price) or (level.side == -1 and close < level.price)
                            level.flipped := true
                        array.set(engineCatalog, i, level)

    array.clear(rawName)
    array.clear(rawPx)
    if not na(pdh)
        array.push(rawName, "PDH")
        array.push(rawPx, pdh)
    if not na(pdl)
        array.push(rawName, "PDL")
        array.push(rawPx, pdl)
    if not na(pwh)
        array.push(rawName, "PWH")
        array.push(rawPx, pwh)
    if not na(pwl)
        array.push(rawName, "PWL")
        array.push(rawPx, pwl)
    if not na(asiaHi)
        array.push(rawName, "ASIAH")
        array.push(rawPx, asiaHi)
    if not na(asiaLo)
        array.push(rawName, "ASIAL")
        array.push(rawPx, asiaLo)
    if not na(lonHi)
        array.push(rawName, "LONH")
        array.push(rawPx, lonHi)
    if not na(lonLo)
        array.push(rawName, "LONL")
        array.push(rawPx, lonLo)
    if not na(onHi)
        array.push(rawName, "ONH")
        array.push(rawPx, onHi)
    if not na(onLo)
        array.push(rawName, "ONL")
        array.push(rawPx, onLo)
    if array.size(dHighs) > 0
        for i = 0 to array.size(dHighs) - 1
            array.push(rawName, "DH" + str.tostring(i + 1))
            array.push(rawPx, array.get(dHighs, i))
    if array.size(dLows) > 0
        for i = 0 to array.size(dLows) - 1
            array.push(rawName, "DL" + str.tostring(i + 1))
            array.push(rawPx, array.get(dLows, i))
    if array.size(h4Highs) > 0
        for i = 0 to array.size(h4Highs) - 1
            array.push(rawName, "H4H" + str.tostring(i + 1))
            array.push(rawPx, array.get(h4Highs, i))
    if array.size(h4Lows) > 0
        for i = 0 to array.size(h4Lows) - 1
            array.push(rawName, "H4L" + str.tostring(i + 1))
            array.push(rawPx, array.get(h4Lows, i))
    if array.size(h1Highs) > 0
        for i = 0 to array.size(h1Highs) - 1
            array.push(rawName, "H1H" + str.tostring(i + 1))
            array.push(rawPx, array.get(h1Highs, i))
    if array.size(h1Lows) > 0
        for i = 0 to array.size(h1Lows) - 1
            array.push(rawName, "H1L" + str.tostring(i + 1))
            array.push(rawPx, array.get(h1Lows, i))
    if useCatalogIn and catalogFeedsGradeIn and array.size(engineCatalog) > 0
        for i = 0 to array.size(engineCatalog) - 1
            importedLevel level = array.get(engineCatalog, i)
            if f_catalogFeedable(level)
                array.push(rawName, level.kind)
                array.push(rawPx, level.price)
    if useScaledHTFIn and chartSeconds >= 900
        if array.size(scaledSetupHighs) > 0
            for i = 0 to array.size(scaledSetupHighs) - 1
                array.push(rawName, "S-SETUP-H" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledSetupHighs, i))
        if array.size(scaledSetupLows) > 0
            for i = 0 to array.size(scaledSetupLows) - 1
                array.push(rawName, "S-SETUP-L" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledSetupLows, i))
        if array.size(scaledPositionHighs) > 0
            for i = 0 to array.size(scaledPositionHighs) - 1
                array.push(rawName, "S-POS-H" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledPositionHighs, i))
        if array.size(scaledPositionLows) > 0
            for i = 0 to array.size(scaledPositionLows) - 1
                array.push(rawName, "S-POS-L" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledPositionLows, i))
        if array.size(scaledRunnerHighs) > 0
            for i = 0 to array.size(scaledRunnerHighs) - 1
                array.push(rawName, "S-RUN-H" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledRunnerHighs, i))
        if array.size(scaledRunnerLows) > 0
            for i = 0 to array.size(scaledRunnerLows) - 1
                array.push(rawName, "S-RUN-L" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledRunnerLows, i))
        if array.size(scaledSlowHighs) > 0
            for i = 0 to array.size(scaledSlowHighs) - 1
                array.push(rawName, "S-SLOW-H" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledSlowHighs, i))
        if array.size(scaledSlowLows) > 0
            for i = 0 to array.size(scaledSlowLows) - 1
                array.push(rawName, "S-SLOW-L" + str.tostring(i + 1))
                array.push(rawPx, array.get(scaledSlowLows, i))
    array.clear(zoneName)
    array.clear(zonePx)
    array.clear(zoneLo)
    array.clear(zoneHi)
    float halfZ = 0.1 * atr
    int rn = array.size(rawPx)
    if not na(halfZ) and rn > 0
        if rn > 1
            for pass = 1 to rn - 1
                for b = 0 to rn - 2
                    if array.get(rawPx, b) > array.get(rawPx, b + 1)
                        float swapPx = array.get(rawPx, b)
                        string swapNm = array.get(rawName, b)
                        array.set(rawPx, b, array.get(rawPx, b + 1))
                        array.set(rawName, b, array.get(rawName, b + 1))
                        array.set(rawPx, b + 1, swapPx)
                        array.set(rawName, b + 1, swapNm)
        string cName = array.get(rawName, 0)
        float cSum = array.get(rawPx, 0)
        int cCount = 1
        float cLo = cSum - halfZ
        float cHi = cSum + halfZ
        if rn > 1
            for i = 1 to rn - 1
                float px = array.get(rawPx, i)
                float lo = px - halfZ
                float hi = px + halfZ
                if lo <= cHi
                    cName := cName + "+" + array.get(rawName, i)
                    cLo := math.min(cLo, lo)
                    cHi := math.max(cHi, hi)
                    cSum := cSum + px
                    cCount += 1
                else
                    array.push(zoneName, cName)
                    array.push(zonePx, cSum / cCount)
                    array.push(zoneLo, cLo)
                    array.push(zoneHi, cHi)
                    cName := array.get(rawName, i)
                    cSum := px
                    cCount := 1
                    cLo := lo
                    cHi := hi
        array.push(zoneName, cName)
        array.push(zonePx, cSum / cCount)
        array.push(zoneLo, cLo)
        array.push(zoneHi, cHi)

    if rangeOnIn
        bool shelves = not na(rangeHigh) or not na(rangeLow)
        bool compressed = not na(compHi) and not na(compLo) and not na(atr) and compHi - compLo <= rangeAtrIn * atr
        bool broke = watchOn and not na(watchHi) and (close > watchHi or close < watchLo)
        bool newShelf = watchOn and (rangeHigh != watchShelfHi or rangeLow != watchShelfLo)
        if broke or not compressed
            watchOn := false
        else if newShelf
            watchOn := false
        if compressed and shelves and not watchOn
            watchOn := true
            watchHi := compHi
            watchLo := compLo
            watchShelfHi := rangeHigh
            watchShelfLo := rangeLow
            watchZone := f_at_level((compHi + compLo) / 2.0)
            float longStop = na(rangeLow) ? na : rangeLow - f_stopBuffer("Medium")
            float shortStop = na(rangeHigh) ? na : rangeHigh + f_stopBuffer("Medium")
            string lvl = watchZone == "" ? "null" : '"' + watchZone + '"'
            string watchMsg = '{"source":"staxbot","event":"watch","eventId":"watch:' + str.tostring(bar_index) + '","version":"2.6.0","fp":"' + f_fp() + '","provisional":false,"level":' + lvl + ',"range_high":' + f_num(compHi) + ',"range_low":' + f_num(compLo) + ',"break_high":' + f_num(rangeHigh) + ',"break_low":' + f_num(rangeLow) + ',"long_stop":' + f_num(longStop) + ',"short_stop":' + f_num(shortStop) + ',"timestamp":"' + f_ts() + '"}'
            f_send(watchMsg)

    bool sideOkBull = longsOk and (topDownFilterIn ? topDownDirection == 1 : not biasFilterIn or bias == 1)
    bool sideOkBear = shortsOk and (topDownFilterIn ? topDownDirection == -1 : not biasFilterIn or bias == -1)
    bool canArm = inSession and not inPause and not newsBlocked and targetsOk and volOk

    if bullThrough or bearThrough
        winSide := bullThrough ? 1 : -1
        winFrom := bar_index
        winLevel := bullThrough ? rangeHigh : rangeLow
        winSwing := bullThrough ? rangeHighBar : rangeLowBar
        winZoneHi := rangeHigh
        winZoneLo := rangeLow
        winZoneFrom := winSwing
    bool winOpen = winSide != 0 and winFrom >= 0 and bar_index - winFrom < breakWinIn
    bool winBeyond = winSide == 1 ? close > winLevel : winSide == -1 ? close < winLevel : false
    bool winDisp = winSide == 1 ? bullDisp : winSide == -1 ? bearDisp : false
    bool winSideOk = (winSide == 1 and sideOkBull) or (winSide == -1 and sideOkBear)
    if canArm and shelfOk and winOpen and winBeyond and winDisp and winSideOk
        int side = winSide
        moveSeq += 1
        moveIdNow := moveSeq
        moveDir := side
        moveBar := bar_index
        moveAnchor := side == 1 ? legLowNow : legHighNow
        moveShelf := winLevel
        moveSwing := winSwing
        moveZoneHi := winZoneHi
        moveZoneLo := winZoneLo
        moveZoneFrom := winZoneFrom
        moveFlag1 := strongDisp
        f_replace_older(side, moveIdNow)
        float tightCandle = side == 1 ? low : high
        if shelfOnIn
            f_try_arm("shelf", side, moveShelf, tightCandle, tightCandle, moveAnchor, moveShelf, moveSwing, moveZoneHi, moveZoneLo, moveZoneFrom, moveFlag1, false)
        if momentumOnIn and not na(winZoneLo) and not na(winZoneHi)
            float oppEdge = side == 1 ? winZoneLo : winZoneHi
            f_try_arm("momentum", side, close, tightCandle, oppEdge, moveAnchor, moveShelf, moveSwing, moveZoneHi, moveZoneLo, moveZoneFrom, moveFlag1, false)
            if array.size(plans) > 0
                for i = 0 to array.size(plans) - 1
                    staxPlan mom = array.get(plans, i)
                    if mom.origin == "momentum" and mom.state == "ARMED" and mom.createdBar == bar_index and tradesToday < pMaxTrades and f_live_n() < maxLiveIn
                        mom.state := "TRIGGERED"
                        mom.fillBar := bar_index
                        mom.ready := false
                        bool momentumConflict = f_stop_hit(mom.dir, mom.liveStop) or (mom.on1 and f_tp_hit(mom.dir, mom.tp1)) or (mom.on2 and f_tp_hit(mom.dir, mom.tp2)) or (mom.on3 and f_tp_hit(mom.dir, mom.tp3))
                        mom.entryCertainty := not intrabarCheckIn ? "proven" : not f_ltfAvailable() ? "unproven" : momentumConflict ? f_ltfWalk(mom.dir, true, mom.entry, mom.liveStop, mom.tp1, mom.tp2, mom.tp3, false, false, false) : "proven"
                        tradesToday += 1
                        f_send(f_payload(mom, "entry", "", ""))
                        array.set(plans, i, mom)
                        for j = 0 to array.size(plans) - 1
                            staxPlan sib = array.get(plans, j)
                            if j != i and sib.moveId == mom.moveId and sib.state == "ARMED"
                                sib.state := "CANCELLED"
                                sib.ready := false
                                sib.reason := "sibling filled"
                                sib.resolvedBar := bar_index
                                f_send(f_payload(sib, "plan_cancel", ',"reason":"sibling filled"', ""))
                                array.set(plans, j, sib)
        winSide := 0
        winFrom := -1

    bool gapNow = moveDir == 1 ? bullFvg : bearFvg
    float gapTop = moveDir == 1 ? low : low[2]
    float gapBot = moveDir == 1 ? high[2] : high
    float gapHeight = math.abs(gapTop - gapBot)
    bool gapHeightOk = minGapAtrIn <= 0 or gapHeight >= minGapAtrIn * atr
    bool inGapWindow = moveBar >= 0 and bar_index - moveBar <= fvgWindowIn
    if gapOnIn and canArm and inGapWindow and gapNow and gapHeightOk and ((moveDir == 1 and sideOkBull) or (moveDir == -1 and sideOkBear))
        float nearEdge = moveDir == 1 ? gapTop : gapBot
        float farEdge = moveDir == 1 ? gapBot : gapTop
        float midEdge = (gapTop + gapBot) / 2.0
        float gapEntry = entryLevelIn == "FVG Midpoint (CE)" ? midEdge : entryLevelIn == "FVG Far Edge (Deep)" ? farEdge : nearEdge
        float gapMed = moveDir == 1 ? low[1] : high[1]
        f_try_arm("gap", moveDir, gapEntry, farEdge, gapMed, moveAnchor, moveShelf, moveSwing, gapTop, gapBot, math.max(0, bar_index - 2), moveFlag1, false)

    if enableCIn
        bool sweepOpen = sweepSide != 0 and sweepFrom >= 0 and bar_index - sweepFrom < sweepWinIn
        if sweepSide != 0 and not sweepOpen
            sweepSide := 0
            sweepFrom := -1
        if sweepSide != 0
            sweepExtreme := sweepSide == 1 ? (na(sweepExtreme) ? high : math.max(sweepExtreme, high)) : (na(sweepExtreme) ? low : math.min(sweepExtreme, low))
            float tolC = reclaimAtrIn * armAtr
            bool backIn = bar_index > sweepFrom and not na(tolC) and (sweepSide == 1 ? sweepLvl - close >= tolC : close - sweepLvl >= tolC)
            if backIn
                int rev = -sweepSide
                bool revOk = rev == 1 ? longsOk and (topDownFilterIn or not biasFilterIn or bias == 1) : shortsOk and (topDownFilterIn or not biasFilterIn or bias == -1)
                bool exists = false
                if array.size(plans) > 0
                    for i = 0 to array.size(plans) - 1
                        staxPlan q = array.get(plans, i)
                        if q.origin == "sweep" and f_active(q.state) and math.abs(q.entry - sweepLvl) <= tick
                            exists := true
                if canArm and revOk and not exists
                    int savedMove = moveIdNow
                    int beforeN = array.size(plans)
                    moveSeq += 1
                    moveIdNow := moveSeq
                    float largePx = rev == 1 ? legLowNow : legHighNow
                    bool htfGrade = sweepKind == "htf" or f_at_level(sweepLvl) != ""
                    f_try_arm("sweep", rev, sweepLvl, sweepExtreme, sweepExtreme, largePx, sweepLvl, bar_index, math.max(sweepLvl, sweepExtreme), math.min(sweepLvl, sweepExtreme), math.max(0, sweepFrom), strongDisp, htfGrade)
                    moveIdNow := savedMove
                    if array.size(plans) > beforeN
                        f_cancel_failed(sweepSide)
                sweepSide := 0
                sweepFrom := -1
        if sweepSide == 0
            float lvl = na
            int sdir = 0
            string skind = ""
            if not na(rangeHigh) and close > rangeHigh and (na(close[1]) or close[1] <= rangeHigh)
                lvl := rangeHigh
                sdir := 1
                skind := "chart"
            else if not na(rangeLow) and close < rangeLow and (na(close[1]) or close[1] >= rangeLow)
                lvl := rangeLow
                sdir := -1
                skind := "chart"
            else if array.size(zoneHi) > 0
                for i = 0 to array.size(zoneHi) - 1
                    if na(lvl)
                        float zHi = array.get(zoneHi, i)
                        float zLo = array.get(zoneLo, i)
                        if close > zHi and (na(close[1]) or close[1] <= zHi)
                            lvl := zHi
                            sdir := 1
                            skind := "htf"
                        else if close < zLo and (na(close[1]) or close[1] >= zLo)
                            lvl := zLo
                            sdir := -1
                            skind := "htf"
            if na(lvl) and array.size(plans) > 0
                for i = 0 to array.size(plans) - 1
                    if na(lvl)
                        staxPlan q = array.get(plans, i)
                        if q.state == "ARMED" and close > q.shelf and (na(close[1]) or close[1] <= q.shelf)
                            lvl := q.shelf
                            sdir := 1
                            skind := "chart"
                        else if q.state == "ARMED" and close < q.shelf and (na(close[1]) or close[1] >= q.shelf)
                            lvl := q.shelf
                            sdir := -1
                            skind := "chart"
            if not na(lvl)
                sweepSide := sdir
                sweepFrom := bar_index
                sweepLvl := lvl
                sweepExtreme := sdir == 1 ? high : low
                sweepKind := skind

    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            p.ready := false
            if p.state == "TRIGGERED" and bar_index > p.fillBar
                p.state := "LIVE"
            if p.state == "LIVE" and bar_index > p.fillBar
                bool stopped = f_stop_hit(p.dir, p.liveStop)
                bool targetTouched = (p.on1 and not p.hit1 and f_tp_hit(p.dir, p.tp1)) or (p.on2 and not p.hit2 and f_tp_hit(p.dir, p.tp2)) or (p.on3 and not p.hit3 and f_tp_hit(p.dir, p.tp3))
                p.exitCertainty := not intrabarCheckIn ? "proven" : not f_ltfAvailable() ? "unproven" : stopped and targetTouched ? f_ltfWalk(p.dir, false, p.entry, p.liveStop, p.tp1, p.tp2, p.tp3, p.hit1, p.hit2, p.hit3) : "proven"
                if stopped
                    bool moved = p.liveStop != p.stop
                    float rr = p.refRisk > 0 ? p.dir * (p.liveStop - p.entry) / p.refRisk : 0.0
                    string why = not moved ? "SL" : math.abs(rr) < 0.05 ? "BE" : "TRAILED"
                    float exitPx = p.dir == 1 ? math.min(open, p.liveStop) : math.max(open, p.liveStop)
                    p := f_close_trade(p, exitPx, why, "STOP")
                else
                    if p.on1 and not p.hit1 and f_tp_hit(p.dir, p.tp1) and p.state == "LIVE"
                        p.hit1 := true
                        if f_done(p)
                            p.state := "CLOSED"
                            p.reason := "targets"
                            p.resolvedBar := bar_index
                        p := f_mark_tp(p, "TP1", p.tp1, p.rUnit)
                    if p.on2 and not p.hit2 and f_tp_hit(p.dir, p.tp2) and p.state == "LIVE"
                        p.hit2 := true
                        if f_done(p)
                            p.state := "CLOSED"
                            p.reason := "targets"
                            p.resolvedBar := bar_index
                        p := f_mark_tp(p, "TP2", p.tp2, p.rUnit * 2.0)
                    if p.on3 and not p.hit3 and f_tp_hit(p.dir, p.tp3) and p.state == "LIVE"
                        p.hit3 := true
                        if f_done(p)
                            p.state := "CLOSED"
                            p.reason := "targets"
                            p.resolvedBar := bar_index
                        p := f_mark_tp(p, "TP3", p.tp3, p.rUnit * 3.0)
                    else if p.state == "LIVE" and reclaimExitIn and f_wrong(p.dir, p.inv)
                        p := f_close_trade(p, close, "RECLAIM", "RECLAIM")
                    else if p.state == "LIVE" and sessionEnded and flatAtSessEndIn
                        p := f_close_trade(p, close, "FLAT", "FLAT")
                    else if p.state == "LIVE" and flatAtSessEndIn and not na(time_tradingday[1]) and time_tradingday != time_tradingday[1] and not sessionEnded[1] and not na(close[1])
                        p.exitCertainty := "proven"
                        p := f_close_trade(p, close[1], "session_end_missing_bar", "FLAT_MISSING")
                    else if p.state == "LIVE"
                        float favR = p.dir == 1 ? (high - p.entry) / p.refRisk : (p.entry - low) / p.refRisk
                        float offR = na
                        if trailOn
                            offR := favR >= trailT3 ? trailO3 : favR >= trailT2 ? trailO2 : favR >= trailT1 ? trailO1 : favR >= trailBe ? 0.0 : na
                        else if beOn
                            offR := favR >= beR ? 0.0 : na
                        if not na(offR)
                            float buffer = offR == 0 and beTickIn ? p.dir * tick : 0.0
                            float cand = p.entry + p.dir * offR * p.refRisk + buffer
                            float newStop = p.dir == 1 ? math.max(p.liveStop, cand) : math.min(p.liveStop, cand)
                            if newStop != p.liveStop
                                p.liveStop := newStop
                                if sendStopUpdIn
                                    float lockedR = p.refRisk > 0 ? p.dir * (p.liveStop - p.entry) / p.refRisk : 0.0
                                    f_send(f_payload(p, "stop_update", ',"reason":"trail","realizedR":' + str.tostring(offR, "0.00") + ',"locked_r":' + str.tostring(lockedR, "0.00"), ""))
            if p.state == "ARMED" and bar_index > p.createdBar
                bool staleBars = bar_index > p.expiryBar
                bool entryTouch = f_entry_hit(p)
                if confirmBeforeFillIn and p.scenario != "M"
                    if entryTouch and not p.inEntryZone
                        p.zoneTouches += 1
                        if p.firstTouchBar < 0
                            p.firstTouchBar := bar_index
                            p.pullbackBase := p.dir == 1 ? rangeHigh : rangeLow
                    p.inEntryZone := entryTouch
                    int pullbackBarNow = bar_index - confirmPivotLenIn
                    if p.firstTouchBar >= 0 and not p.structureConfirmed and pullbackBarNow >= p.firstTouchBar
                        bool lowerHigh = p.dir == 1 and not na(confirmPullbackPh) and not na(p.pullbackBase) and confirmPullbackPh < p.pullbackBase
                        bool higherLow = p.dir == -1 and not na(confirmPullbackPl) and not na(p.pullbackBase) and confirmPullbackPl > p.pullbackBase
                        if lowerHigh or higherLow
                            p.pullbackSwing := p.dir == 1 ? confirmPullbackPh : confirmPullbackPl
                            p.pullbackBar := pullbackBarNow
                    bool confirmedShift = p.pullbackBar >= 0 and bar_index > p.pullbackBar and (p.dir == 1 ? close > p.pullbackSwing and close > p.entry : close < p.pullbackSwing and close < p.entry)
                    if confirmedShift and not p.structureConfirmed
                        p.structureConfirmed := true
                        p.confirmBar := bar_index
                        p.confirmExtreme := p.dir == 1 ? low : high
                        p.confirmClose := close
                        p.confirmPositionOk := f_positionOk(p.dir, p.confirmExtreme, p.confirmClose)
                bool churned = confirmBeforeFillIn and p.scenario != "M" and p.zoneTouches > 2
                bool confirmationReady = not confirmBeforeFillIn or p.scenario == "M" or (p.structureConfirmed and bar_index > p.confirmBar)
                bool positionReady = not topDownFilterIn or p.origin == "sweep" or (confirmBeforeFillIn and p.scenario != "M" ? p.confirmPositionOk : f_positionOk(p.dir, p.dir == 1 ? low : high, close))
                if churned
                    p.state := "INVALIDATED"
                    p.reason := "zone churn"
                    p.resolvedBar := bar_index
                    f_send(f_payload(p, "plan_cancel", ',"reason":"zone churn"', ""))
                else if sessionEnded
                    p.state := "EXPIRED"
                    p.reason := "session"
                    p.resolvedBar := bar_index
                    f_send(f_payload(p, "plan_cancel", ',"reason":"session"', ""))
                else if f_wrong(p.dir, p.inv)
                    p.state := "INVALIDATED"
                    p.reason := "reclaim close"
                    p.resolvedBar := bar_index
                    f_send(f_payload(p, "plan_cancel", ',"reason":"reclaim close"', ""))
                else if entryTouch and f_hit(p.stop)
                    p.ready := false
                else if not inPause and not newsBlocked and inSession and tradesToday < pMaxTrades and f_live_n() < maxLiveIn and entryTouch and confirmationReady and positionReady and not f_wrong(p.dir, p.inv)
                    p.ready := true
                else if f_tp_hit(p.dir, f_near(p)) and not entryTouch
                    p.state := "EXPIRED"
                    p.scenario := "D"
                    p.reason := "ran without retest"
                    p.resolvedBar := bar_index
                    f_send(f_payload(p, "plan_cancel", ',"reason":"ran without retest"', ""))
                else if staleBars
                    p.state := "EXPIRED"
                    p.reason := "expired"
                    p.resolvedBar := bar_index
                    f_send(f_payload(p, "plan_cancel", ',"reason":"expired"', ""))
            array.set(plans, i, p)

    int guard = 0
    int room = maxLiveIn - f_live_n()
    while room > 0 and tradesToday < pMaxTrades and guard < 12
        guard += 1
        int best = -1
        float bestPx = na
        bool down = close <= open
        if array.size(plans) > 0
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if p.ready and (best == -1 or (down and p.entry > bestPx) or (not down and p.entry < bestPx))
                    best := i
                    bestPx := p.entry
        if best == -1
            room := 0
        else
            staxPlan chosen = array.get(plans, best)
            chosen.state := "TRIGGERED"
            chosen.ready := false
            chosen.fillBar := bar_index
            chosen.liveStop := chosen.stop
            bool entryConflict = f_entry_hit(chosen) and (f_stop_hit(chosen.dir, chosen.liveStop) or (chosen.on1 and f_tp_hit(chosen.dir, chosen.tp1)) or (chosen.on2 and f_tp_hit(chosen.dir, chosen.tp2)) or (chosen.on3 and f_tp_hit(chosen.dir, chosen.tp3)))
            chosen.entryCertainty := not intrabarCheckIn ? "proven" : not f_ltfAvailable() ? "unproven" : entryConflict ? f_ltfWalk(chosen.dir, true, chosen.entry, chosen.liveStop, chosen.tp1, chosen.tp2, chosen.tp3, false, false, false) : "proven"
            tradesToday += 1
            if showDrawingsIn
                if not na(chosen.lbFill)
                    label.delete(chosen.lbFill)
                chosen.lbFill := label.new(bar_index, chosen.dir == 1 ? low : high, chosen.dir == 1 ? "LONG" : "SHORT", style = chosen.dir == 1 ? label.style_label_up : label.style_label_down, color = chosen.dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0), textcolor = color.white, size = size.small, text_font_family = font.family_monospace)
            f_send(f_payload(chosen, "entry", "", ""))
            array.set(plans, best, chosen)
            if array.size(plans) > 0
                for i = 0 to array.size(plans) - 1
                    staxPlan sib = array.get(plans, i)
                    if i != best and sib.moveId == chosen.moveId and sib.state == "ARMED"
                        sib.state := "CANCELLED"
                        sib.ready := false
                        sib.reason := "sibling filled"
                        sib.resolvedBar := bar_index
                        f_send(f_payload(sib, "plan_cancel", ',"reason":"sibling filled"', ""))
                        array.set(plans, i, sib)
            room := maxLiveIn - f_live_n()

    bool armedBreak = false
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan made = array.get(plans, i)
            if made.createdBar == bar_index and (made.origin == "shelf" or made.origin == "gap" or made.origin == "momentum" or made.origin == "sweep")
                armedBreak := true
    if wasForming and not armedBreak
        string cSide = wasSide == 1 ? "long" : "short"
        string cLvl = f_at_level(wasEntry)
        string cLvlJson = cLvl == "" ? "null" : '"' + cLvl + '"'
        string cancelMsg = '{"source":"staxbot","event":"break_cancelled","eventId":"break_cancelled:' + str.tostring(bar_index) + '","version":"2.6.0","fp":"' + f_fp() + '","provisional":false,"side":"' + cSide + '","entry":' + f_num(wasEntry) + ',"stop":' + f_num(wasStop) + ',"target":' + f_num(wasTp) + ',"level":' + cLvlJson + ',"timestamp":"' + f_ts() + '"}'
        f_send(cancelMsg)

    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            p := f_draw(p)
            array.set(plans, i, p)

    if array.size(htfLn) > 0
        for i = array.size(htfLn) - 1 to 0
            line.delete(array.get(htfLn, i))
            array.remove(htfLn, i)
    if array.size(htfLb) > 0
        for i = array.size(htfLb) - 1 to 0
            label.delete(array.get(htfLb, i))
            array.remove(htfLb, i)
    if showHtfIn and showDrawingsIn and array.size(zonePx) > 0
        for i = 0 to array.size(zonePx) - 1
            float y = array.get(zonePx, i)
            int zLeft = math.max(0, bar_index - 30)
            array.push(htfLn, line.new(zLeft, y, bar_index, y, color = color.new(#7F8AA3, 75), style = line.style_dotted, width = 1))
            array.push(htfLb, label.new(zLeft, y, array.get(zoneName, i), style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = color.new(#7F8AA3, 40), size = size.tiny))

    int cold = 0
    if array.size(plans) > 0
        for i = array.size(plans) - 1 to 0
            staxPlan p = array.get(plans, i)
            if not f_active(p.state)
                cold += 1
                int keepN = resolvedIn == "Review" ? 5 : 3
                if cold > keepN
                    f_erase(p)
                    array.remove(plans, i)

f_focus() =>
    int idx = -1
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if idx == -1 and p.state == "TRIGGERED"
                idx := i
        if idx == -1
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if idx == -1 and p.state == "LIVE"
                    idx := i
        if idx == -1
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if idx == -1 and p.state == "ARMED"
                    idx := i
    idx
f_move_line() =>
    string s = ""
    int idx = -1
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if idx == -1 and p.state == "TRIGGERED"
                idx := i
        if idx == -1
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if idx == -1 and p.state == "LIVE"
                    idx := i
    if idx >= 0
        staxPlan live = array.get(plans, idx)
        s := "Move " + str.tostring(live.moveId) + ": " + f_kind(live.origin) + " plan " + f_num(live.entry)
    else
        int id = -1
        if array.size(plans) > 0
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if f_active(p.state)
                    id := math.max(id, p.moveId)
        if id >= 0
            s := "Move " + str.tostring(id) + ":"
            int n = 0
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if p.moveId == id and f_active(p.state)
                    n += 1
                    s := s + (n > 1 ? " and " : " ") + f_kind(p.origin) + " plan " + f_num(p.entry)
    s
f_also_armed() =>
    string s = ""
    bool live = false
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.state == "LIVE" or p.state == "TRIGGERED"
                live := true
        if live
            for i = 0 to array.size(plans) - 1
                staxPlan p = array.get(plans, i)
                if p.state == "ARMED"
                    string side = p.dir == 1 ? "long" : "short"
                    string bit = side + " " + f_num(p.entry) + " (" + f_kind(p.origin) + ")"
                    s := s == "" ? bit : s + ", " + bit
    s == "" ? "" : "Also armed: " + s

f_resolved_line() =>
    string s = ""
    if array.size(plans) > 0
        for i = 0 to array.size(plans) - 1
            staxPlan p = array.get(plans, i)
            if p.resolvedBar == bar_index
                s := p.state + (p.reason == "" ? "" : ": " + p.reason)
    s
if barstate.isconfirmed and array.size(plans) > 0
    for i = 0 to array.size(plans) - 1
        staxPlan orderPlan = array.get(plans, i)
        f_strategySync(orderPlan)
int focus = f_focus()
bool have = focus >= 0
staxPlan view = have ? array.get(plans, focus) : staxPlan.new()
string resolvedLine = f_resolved_line()
bool hudStale = have and view.fp != f_fp()
string moveLine = f_move_line()
string alsoLine = f_also_armed()
string shownMove = alsoLine == "" ? moveLine : moveLine == "" ? alsoLine : moveLine + " | " + alsoLine
bool noSize = have and view.qty == 0
string noteBody = hudStale ? "INPUTS CHANGED. Recreate the alert." : noSize ? "NO SIZE. Risk budget is below one contract." : eng.hudReject != "" ? eng.hudReject : not targetsOk ? "Enable TP1, TP2, or TP3." : inPause ? "Pause. No new plans and no fills." : formingNow ? "BREAK FORMING" : shownMove != "" ? shownMove : watchOn ? "RANGE WATCH" + (watchZone == "" ? "" : " " + watchZone) : "Waiting for the retest."
string note = noteBody
string baseWord = have and view.state == "TRIGGERED" ? "TRIGGERED" : have and view.state == "LIVE" ? "LIVE" : have and view.state == "ARMED" ? "ARMED" : resolvedLine != "" ? resolvedLine : watchOn ? "RANGE WATCH" : inPause ? "PAUSE" : "WATCH"
bool liveOwn = have and (view.state == "LIVE" or view.state == "TRIGGERED")
string stateWord = formingNow and not liveOwn ? "BREAK FORMING" : baseWord
string sideWord = have ? (view.dir == 1 ? "LONG" : "SHORT") : ""
string stateTxt = have ? stateWord + "  ·  " + sideWord : stateWord
float openR = have and view.refRisk > 0 ? view.dir * (close - view.entry) / view.refRisk : 0.0
float stopR = have and view.refRisk > 0 ? view.dir * (view.liveStop - view.entry) / view.refRisk : 0.0
float netOpenR = have ? f_netR(view, openR, f_remainingWeight(view), false) : 0.0
string certaintyTag = have and (view.entryCertainty == "unproven" or view.exitCertainty == "unproven") ? " ?" : ""
string extTag = have and view.extended ? " extended" : ""
string lvlTag = have and view.level != "" ? " " + view.level : ""
string qualityTag = have ? " · O" + (view.outerClose ? "1" : "0") + "/R" + str.tostring(view.runBars) : ""
string gradeTxt = have and (view.state == "LIVE" or view.state == "TRIGGERED") ? (noSize ? "NO SIZE · " : "") + view.grade + extTag + lvlTag + "   G " + f_signed(openR) + " N " + f_signed(netOpenR) + (view.liveStop != view.stop ? "  Locked " + f_signed(stopR) : "") + certaintyTag : have ? (noSize ? "NO SIZE · " : "Grade ") + view.grade + extTag + lvlTag + qualityTag + certaintyTag : str.tostring(tradesToday) + " / " + str.tostring(pMaxTrades)
string foot = hudStale ? "INPUTS CHANGED" : have ? str.tostring(view.rUnit, "0.#") + "R · " + view.preset + " · " + (trailOn ? "Trail" : beOn ? "BE" : "BE off") + " · " + sessShort + "  ·  " + pDir + qualityTag : str.tostring(pTp, "0.#") + "R  ·  " + pSl + "  ·  " + sessShort + "  ·  " + pDir
string tpName = have ? (view.on1 and not view.hit1 ? "TP1" : view.on2 and not view.hit2 ? "TP2" : view.on3 and not view.hit3 ? "TP3" : "TP") : "Trades"
float tpShow = have ? (view.on1 and not view.hit1 ? view.tp1 : view.on2 and not view.hit2 ? view.tp2 : view.on3 and not view.hit3 ? view.tp3 : f_near(view)) : na
bool hudNote = noSize or not targetsOk or hudStale or eng.hudReject != "" or inPause or (have and view.state == "ARMED") or moveLine != ""
int hudTg = have ? (view.on1 ? 1 : 0) + (view.on2 ? 1 : 0) + (view.on3 ? 1 : 0) : 0
int hudLevels = have ? hudTg + 3 : 2
int hudBody = hudSizeIn == "Compact" ? 4 : 3 + (hudNote ? 1 : 0) + hudLevels + 1
bool hudTop = hudPosIn == "Top right" or hudPosIn == "Top left"
int hudPad = hudTop ? 1 : 0
string tpKey = have ? (view.on1 ? "1" : "0") + (view.on2 ? "1" : "0") + (view.on3 ? "1" : "0") : "flat"

var table infoTbl = na
var string hudKey = ""
f_cell(table t, int col, int row, string txt, color ink, color bg, string align) =>
    table.cell(t, col, row, txt, text_color = ink, bgcolor = bg, text_halign = align == "r" ? text.align_right : text.align_left, text_valign = text.align_center, text_size = size.small, text_font_family = font.family_monospace)
f_lab_ink(string lab) =>
    str.startswith(lab, "TP3") ? color.new(#147A4E, 0) : str.startswith(lab, "TP") ? color.new(#3DDC97, 0) : str.startswith(lab, "STOP") ? color.new(#FF5C6C, 0) : str.startswith(lab, "ENTRY") ? color.new(#E6EAF2, 0) : color.new(#7F8AA3, 0)
f_val_ink(string lab) =>
    str.startswith(lab, "STOP") ? color.new(#FF5C6C, 0) : str.startswith(lab, "TP") ? color.new(#3DDC97, 0) : color.white
string wantKey = (showTableIn ? "1" : "0") + hudSizeIn + hudPosIn + str.tostring(hudPad) + ":" + str.tostring(hudBody) + (hudNote ? "N" : "") + tpKey
if not showTableIn and not na(infoTbl)
    table.delete(infoTbl)
    infoTbl := na
    hudKey := ""
if showTableIn and wantKey != hudKey
    if not na(infoTbl)
        table.delete(infoTbl)
    int cols = hudSizeIn == "Compact" ? 3 : 2
    infoTbl := table.new(hudPosIn == "Top left" ? position.top_left : hudPosIn == "Bottom right" ? position.bottom_right : hudPosIn == "Bottom left" ? position.bottom_left : position.top_right, cols, hudBody + hudPad, bgcolor = color.new(#0B0F19, 100), border_width = 0, frame_width = 0)
    if hudPad == 1
        table.merge_cells(infoTbl, 0, 0, cols - 1, 0)
    if hudSizeIn == "Full"
        if hudNote
            table.merge_cells(infoTbl, 0, 3 + hudPad, 1, 3 + hudPad)
        table.merge_cells(infoTbl, 0, hudBody - 1 + hudPad, 1, hudBody - 1 + hudPad)
    hudKey := wantKey

if showTableIn and not na(infoTbl)
    color headBg = color.new(#121A2B, 0)
    color ink = color.white
    color muted = color.new(#7F8AA3, 0)
    color liveGreen = color.new(#3DDC97, 0)
    color rowBg = color.new(#0B0F19, 0)
    color keyBg = color.new(#121A2B, 0)
    color sideInk = not have ? ink : view.dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0)
    color stateInk = stateWord == "TRIGGERED" or stateWord == "LIVE" ? liveGreen : stateWord == "ARMED" ? color.new(#e6b35a, 0) : ink
    int bulls = (hD == 1 ? 1 : 0) + (h4 == 1 ? 1 : 0) + (h1 == 1 ? 1 : 0) + (h15 == 1 ? 1 : 0) + (h5 == 1 ? 1 : 0)
    int bears = (hD == -1 ? 1 : 0) + (h4 == -1 ? 1 : 0) + (h1 == -1 ? 1 : 0) + (h15 == -1 ? 1 : 0) + (h5 == -1 ? 1 : 0)
    string cloud = bulls > bears ? "BULL " + str.tostring(bulls) + "/5" : bears > bulls ? "BEAR " + str.tostring(bears) + "/5" : "MIX"
    color biasInk = bulls > bears ? color.new(#4C8DFF, 0) : bears > bulls ? color.new(#FF8A3D, 0) : ink
    int p = hudPad
    if p == 1
        table.cell(infoTbl, 0, 0, "", bgcolor = color.new(#0B0F19, 100), height = 6)
    if hudSizeIn == "Compact"
        f_cell(infoTbl, 0, p, "STAXBOT 2.6.0", ink, headBg, "l")
        f_cell(infoTbl, 1, p, cloud, biasInk, headBg, "l")
        f_cell(infoTbl, 2, p, stateWord, stateInk, headBg, "r")
        f_cell(infoTbl, 0, p + 1, stateTxt, sideInk, keyBg, "l")
        f_cell(infoTbl, 1, p + 1, have ? f_num(view.entry) : sessShort, ink, rowBg, "r")
        f_cell(infoTbl, 2, p + 1, liveOwn ? (noSize ? "NO SIZE" : "N " + f_signed(netOpenR)) + certaintyTag : gradeTxt, liveOwn ? liveGreen : muted, rowBg, "r")
        f_cell(infoTbl, 0, p + 2, tpName, have ? liveGreen : muted, keyBg, "l")
        f_cell(infoTbl, 1, p + 2, have ? f_num(tpShow) : str.tostring(tradesToday) + " / " + str.tostring(pMaxTrades), ink, rowBg, "r")
        f_cell(infoTbl, 2, p + 2, have ? str.tostring(view.rUnit, "0.#") + "R" : "", muted, rowBg, "r")
        f_cell(infoTbl, 0, p + 3, hudStale ? "INPUTS CHANGED" : have and view.liveStop != view.stop ? "STOP (trail)" : "STOP", hudStale ? color.new(#e6b35a, 0) : have and view.liveStop != view.stop ? color.new(#9AA3B5, 0) : color.new(#FF5C6C, 0), keyBg, "l")
        f_cell(infoTbl, 1, p + 3, have ? f_num(view.liveStop) : pSl, have and view.liveStop != view.stop ? color.new(#9AA3B5, 0) : have ? color.new(#FF5C6C, 0) : ink, rowBg, "r")
        f_cell(infoTbl, 2, p + 3, have and view.liveStop != view.stop ? "Locked " + f_signed(stopR) : have ? f_signed(stopR) : "", muted, rowBg, "r")
    else
        f_cell(infoTbl, 0, p, "STAXBOT 2.6.0", ink, headBg, "l")
        f_cell(infoTbl, 1, p, stateWord, stateInk, headBg, "r")
        f_cell(infoTbl, 0, p + 1, cloud, biasInk, keyBg, "l")
        f_cell(infoTbl, 1, p + 1, sessShort, ink, rowBg, "r")
        f_cell(infoTbl, 0, p + 2, stateTxt, sideInk, keyBg, "l")
        f_cell(infoTbl, 1, p + 2, gradeTxt, have ? ink : muted, rowBg, "r")
        int at = p + 3
        if hudNote
            f_cell(infoTbl, 0, at, note, hudStale or eng.hudReject != "" ? color.new(#e6b35a, 0) : muted, rowBg, "l")
            at += 1
        string[] hudLab = array.new_string(0)
        string[] hudVal = array.new_string(0)
        if have
            if view.on3
                array.push(hudLab, "TP3   " + (view.struct3 ? "level" : str.tostring(view.rUnit * 3.0, "0.#") + "R") + "   w" + str.tostring(view.w3))
                array.push(hudVal, f_num(view.tp3))
            if view.on2
                array.push(hudLab, "TP2   " + (view.struct2 ? "level" : str.tostring(view.rUnit * 2.0, "0.#") + "R") + "   w" + str.tostring(view.w2))
                array.push(hudVal, f_num(view.tp2))
            if view.on1
                array.push(hudLab, "TP1   " + str.tostring(view.rUnit, "0.#") + "R   w" + str.tostring(view.w1))
                array.push(hudVal, f_num(view.tp1))
            array.push(hudLab, "DISPLACEMENT")
            array.push(hudVal, (view.outerClose ? "outer quarter" : "inside quarter") + " / run " + str.tostring(view.runBars))
            array.push(hudLab, "ENTRY")
            array.push(hudVal, f_num(view.entry))
            array.push(hudLab, view.liveStop != view.stop ? "STOP (trail)" : "STOP")
            array.push(hudVal, f_num(view.liveStop) + (view.liveStop != view.stop ? "  Locked " + f_signed(stopR) : ""))
        else
            array.push(hudLab, "Trades")
            array.push(hudVal, str.tostring(tradesToday) + " / " + str.tostring(pMaxTrades))
            array.push(hudLab, "Watching")
            array.push(hudVal, "break")
        if array.size(hudLab) > 0
            for i = 0 to array.size(hudLab) - 1
                string lab = array.get(hudLab, i)
                f_cell(infoTbl, 0, at, lab, f_lab_ink(lab), keyBg, "l")
                f_cell(infoTbl, 1, at, array.get(hudVal, i), f_val_ink(lab), rowBg, "r")
                at += 1
        f_cell(infoTbl, 0, p + hudBody - 1, foot, hudStale ? color.new(#e6b35a, 0) : muted, keyBg, "l")

if barstate.islast
    int catalogCount = useCatalogIn and showDrawingsIn ? array.size(engineCatalog) : 0
    while array.size(catalogLn) < catalogCount
        array.push(catalogLn, line.new(bar_index, close, bar_index + 1, close, extend = extend.right))
        array.push(catalogLb, label.new(bar_index + 1, close, "", style = label.style_label_left))
    if array.size(catalogLn) > 0
        for i = 0 to array.size(catalogLn) - 1
            line catalogLine = array.get(catalogLn, i)
            label catalogLabel = array.get(catalogLb, i)
            if i < catalogCount
                importedLevel level = array.get(engineCatalog, i)
                if not na(level.price)
                    color levelColor = level.flipped ? color.new(#3DDC97, 0) : level.swept ? color.new(#7F8AA3, 50) : level.kind == "PDC" ? color.new(#B28DFF, 0) : level.side == 1 ? color.new(#FF8A3D, 0) : level.side == -1 ? color.new(#4C8DFF, 0) : color.new(#B28DFF, 0)
                    line.set_xy1(catalogLine, math.max(0, level.born), level.price)
                    line.set_xy2(catalogLine, bar_index + 1, level.price)
                    line.set_extend(catalogLine, extend.right)
                    line.set_color(catalogLine, levelColor)
                    line.set_style(catalogLine, level.live ? line.style_dotted : line.style_solid)
                    line.set_width(catalogLine, level.originMajor ? 2 : 1)
                    label.set_xy(catalogLabel, bar_index + 1, level.price)
                    label.set_text(catalogLabel, level.kind)
                    label.set_textcolor(catalogLabel, levelColor)
                    label.set_color(catalogLabel, color.new(#0B0F19, 100))
                else
                    line.set_color(catalogLine, color.new(#0B0F19, 100))
                    label.set_text(catalogLabel, "")
                    label.set_color(catalogLabel, color.new(#0B0F19, 100))
                    label.set_textcolor(catalogLabel, color.new(#0B0F19, 100))
            else
                line.set_color(catalogLine, color.new(#0B0F19, 100))
                label.set_text(catalogLabel, "")
                label.set_color(catalogLabel, color.new(#0B0F19, 100))
                label.set_textcolor(catalogLabel, color.new(#0B0F19, 100))

pF = plot(emaFast, "EMA Fast", color = color.new(cloudColorIn, 0), linewidth = 2)
pS = plot(emaSlow, "EMA Slow", color = color.new(cloudColorIn, 35), linewidth = 2)
fill(pF, pS, color = color.new(cloudColorIn, 85), title = "EMA Cloud")
bgcolor(showSessBgIn and ((sessionFilterOn and inSession) or inPause) ? color.new(inPause ? #e6b35a : cloudColorIn, 92) : na, title = "Session")

if barstate.isconfirmed and array.size(outbox) == 1
    alert(array.get(outbox, 0), alert.freq_once_per_bar_close)
else if barstate.isconfirmed and array.size(outbox) > 1
    string joined = ""
    for i = 0 to array.size(outbox) - 1
        joined := joined + (i == 0 ? "" : ",") + array.get(outbox, i)
    alert("[" + joined + "]", alert.freq_once_per_bar_close)
