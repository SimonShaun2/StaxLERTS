//@version=6
// StaxBot 2.6.0
// New saved script. The legend reads StaxBot. The HUD reads STAXBOT 2.6.0.
// Upgraded from StaxBot 2.5.2; stored break price, latest swing, and gap detection remain in place.
// A shelf plan arms without a gap. A gap inside the window is a second plan.
// Tight stops past the gap far edge or the break candle. Medium stops past the displacement candle. Large stops past the leg extreme.
// Buffers, reclaim, and stop limits use the previous bar's ATR. Tight stays at or inside Medium, and Large stays at or beyond it.
// The arm decision uses the Medium stop. A selected stop inside the minimum is widened to it. Targets use the Medium distance. The daily count moves only when a plan fills.
// Higher-timeframe zones are prior day, prior week, completed sessions, and the last three swings on the daily, 4H, and 1H. A zone in front of TP1 rejects the plan. Flag 5 is that location.
strategy("StaxBot", shorttitle = "StaxBot", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 5,
     margin_long = 1, margin_short = 1,
     calc_on_every_tick = true, calc_on_order_fills = false, process_orders_on_close = true,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.0, slippage = 0,
     max_boxes_count = 300, max_lines_count = 500, max_labels_count = 500)

G_PRESET  = "Preset"
G_COACH   = "Coach & Execution Filters"
G_STRUCT  = "Structure"
G_TP      = "Take Profit"
G_SL      = "Stop Loss"
G_BE      = "Breakeven"
G_TRAIL   = "Trailing Stop"
G_VOL     = "Volume Filter"
G_BIAS    = "EMA Bias"
G_STAX    = "Stax Alerts"
G_DISPLAY = "Display"
G_SESSION = "Session Pause"
G_ENGINE = "Engine imports"

presetIn = input.string("Manual", "Strategy Preset", group = G_PRESET,
     options = ["Manual", "NY AM Scalper", "NY AM Standard", "London Breakout", "Overnight Conservative"],
     tooltip = "A preset can change direction, session, which stop is selected, breakeven, trail, and the daily cap. It cannot change Take Profit (R), the entry, the scenario, or whether the plan arms.")
dirIn            = input.string("Both", "Allowed Direction", options = ["Both", "Longs Only", "Shorts Only"], group = G_COACH)
sessIn           = input.string("24/5 (No Filter)", "Session Preset", group = G_COACH,
     options = ["24/5 (No Filter)", "NY AM (09:30-12:00)", "NY PM (13:00-16:00)", "London (03:00-06:00)", "Asia (20:00-00:00)", "Overnight (18:00-03:00)", "Custom"])
customSessIn     = input.session("2000-2130", "Custom Session (If Custom Selected)", group = G_COACH)
tzIn             = input.string("America/New_York", "Timezone", group = G_COACH)
maxTradesIn      = input.int(20, "Max Trades Per Day", minval = 1, group = G_COACH)
maxLiveIn        = input.int(1, "Live Positions At Once", minval = 1, maxval = 5, group = G_COACH)
flatAtSessEndIn  = input.bool(false, "Flatten Open Trade At Session End", group = G_COACH)
minGradeIn       = input.string("Off", "Minimum Grade", options = ["Off", "A", "A+"], group = G_COACH,
     tooltip = "A+ needs all five flags. A is four, and one of those four must be strong displacement or the London/New York window. Flag 1 is strong displacement. Flag 2 is EMA bias. Flag 3 is volume. Flag 4 is London 03:00–06:00 or New York 08:20–11:30. Flag 5 is an entry within 0.5 ATR of a higher-timeframe zone.")
roomModeIn       = input.string("Reject", "Room Check", options = ["Reject", "Downgrade"], group = G_COACH,
     tooltip = "Reject skips a plan whose path from entry to TP1 crosses an opposing higher-timeframe zone. Downgrade drops that plan one grade.")
extOnIn          = input.bool(true, "Extension Filter", group = G_COACH,
     tooltip = "A shelf, gap, or momentum plan whose entry is farther than the extension distance from the slow EMA drops one grade and is tagged extended. Scenario C is not extended.")
extAtrIn         = input.float(3.0, "Extension Distance (ATR x)", minval = 0, step = 0.1, group = G_COACH)
reclaimExitIn    = input.bool(true, "Reclaim Exit On Live Trades", group = G_COACH,
     tooltip = "On: a live trade that closes back through the shelf exits at that close. Off: the shelf reclaim only blocks a fill.")
reclaimAtrIn   = input.float(0.25, "Reclaim Tolerance (ATR x)", minval = 0, step = 0.05, group = G_COACH,
     tooltip = "Invalidation and the live reclaim exit need the close at least this many ATR past the shelf. A shelf fill can trade anywhere from the shelf to this distance. A gap plan uses the gap far edge instead of the shelf. The multiple is the previous bar's ATR.")

swingLenIn       = input.int(3, "Swing Length", minval = 2, group = G_STRUCT)
minRangeAtrIn    = input.float(0.0, "Min Shelf Height (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_STRUCT)
minGapAtrIn      = input.float(0.2, "Min Gap Height (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_STRUCT,
     tooltip = "A gap shorter than this multiple of ATR does not arm.")
dispModeIn       = input.string("Body >= ATR x", "Displaced Close", group = G_STRUCT,
     options = ["Body >= ATR x", "Close beyond zone by zone width"],
     tooltip = "The only definition of a displaced close. Inside the break window, a bar that passes this test and is still beyond the shelf arms the plan.")
dispBodyAtrIn    = input.float(1.0, "Displacement Body (ATR x)", minval = 0, step = 0.1, group = G_STRUCT)
breakWinIn       = input.int(3, "Break Window (bars)", minval = 1, group = G_STRUCT,
     tooltip = "A close through the shelf opens this many bars. A displaced close still beyond that shelf inside the window arms the plan, including when the crossing bar itself was not displaced.")
strongAtrIn      = input.float(1.5, "Strong Displacement (ATR x)", minval = 0, step = 0.1, group = G_STRUCT,
     tooltip = "Grade flag 1. The arming bar's body must be at least this multiple of ATR. A smaller displaced close can still arm.")
fvgWindowIn      = input.int(1, "Gap Window After The Break (bars)", minval = 1, group = G_STRUCT)
setupExpiryIn    = input.int(12, "Plan Expires After N Bars", minval = 1, group = G_STRUCT)
entryLevelIn     = input.string("FVG Near Edge (Aggressive)", "Gap Entry", group = G_STRUCT,
     options = ["FVG Near Edge (Aggressive)", "FVG Midpoint (CE)", "FVG Far Edge (Deep)"])
enableCIn        = input.bool(true, "Scenario C: Sweep & Reclaim", group = G_STRUCT,
     tooltip = "A close beyond a range, a higher-timeframe zone, or an armed shelf, then a later close back inside within the sweep window, arms the reversal at the reclaimed level.")
sweepWinIn       = input.int(3, "Sweep Window (bars)", minval = 1, group = G_STRUCT,
     tooltip = "The reclaim close must land inside this many bars of the sweep, including the sweep bar, and it must be a later bar.")
momentumOnIn     = input.bool(false, "Momentum Entry", group = G_STRUCT,
     tooltip = "Off. On enters at the break close, with the stop beyond the opposite range edge. The plan is scenario M and it counts on the break bar.")
shelfOnIn        = input.bool(true, "Scenario B: Shelf", group = G_STRUCT,
     tooltip = "Arms the break. Off skips the shelf plan. The break still opens the gap window.")
gapOnIn          = input.bool(true, "Scenario A: Gap", group = G_STRUCT,
     tooltip = "Arms the fair-value-gap plan. Gap alone is the 2.0 behavior. Off skips the gap plan. The break still records the move.")

tpRIn = input.float(1.0, "Take Profit (R)", minval = 0.1, maxval = 5, step = 0.1, group = G_TP,
     tooltip = "TP1 is this many reference R from entry. TP2 is twice that. TP3 is three times that. Reference R is the entry-to-Medium-stop distance. Presets cannot change this input.")
tp1OnIn = input.bool(true, "TP1", group = G_TP)
tp2OnIn = input.bool(true, "TP2", group = G_TP)
tp3OnIn = input.bool(true, "TP3", group = G_TP)
tp1WIn  = input.int(2, "TP1 weight", minval = 1, maxval = 100, group = G_TP)
tp2WIn  = input.int(1, "TP2 weight", minval = 1, maxval = 100, group = G_TP)
tp3WIn  = input.int(1, "TP3 weight", minval = 1, maxval = 100, group = G_TP)
structOnIn = input.bool(false, "Structural Targets", group = G_TP,
     tooltip = "Off keeps TP2 and TP3 on the R ladder. On sets TP2 to the nearest higher-timeframe zone beyond TP1 and TP3 to the next one. A missing zone stays on the ladder. TP1 stays the R multiple.")

slTypeIn     = input.string("Medium", "SL Type", options = ["Tight", "Medium", "Large"], group = G_SL,
     tooltip = "Tight stops beyond the gap far edge, or the break candle on a shelf plan. Medium stops beyond the displacement candle. Large stops beyond the leg extreme. Distances stay Tight at or inside Medium, and Large at or beyond Medium. A selected stop inside the minimum is widened to the minimum. Entry, targets, and the arm decision stay on the Medium stop. Buffers use the previous bar's ATR.")
tightAtrIn = input.float(0.05, "Tight Buffer (ATR x)", minval = 0, step = 0.01, group = G_SL)
medAtrIn   = input.float(0.10, "Medium Buffer (ATR x)", minval = 0, step = 0.01, group = G_SL)
largeAtrIn = input.float(0.25, "Large Buffer (ATR x)", minval = 0, step = 0.05, group = G_SL)
legLookbackIn   = input.int(30, "Leg Lookback (bars)", minval = 3, group = G_SL)
minStopAtrIn  = input.float(0.5, "Min Stop Distance (ATR x)", minval = 0, step = 0.1, group = G_SL,
     tooltip = "Checked on the Medium stop. The preset does not change it. A selected stop closer than this is widened to it. The multiple is the previous bar's ATR.")
maxStopAtrIn  = input.float(3.0, "Max Stop Distance (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_SL,
     tooltip = "Checked on the Medium stop. The preset does not change it. The multiple is the previous bar's ATR.")

beIn    = input.string("Off", "Breakeven", options = ["Off", "At 0.5R", "At 0.75R", "At 1R", "At 1.5R"], group = G_BE,
     tooltip = "Steps use reference R. Ignored while a trailing preset is on.")
beTickIn = input.bool(false, "BE +1 Tick Buffer", group = G_BE)
trailIn = input.string("Standard (BE 1R)", "Trailing Stop", group = G_TRAIL,
     options = ["Off", "Aggressive (BE 0.75R)", "Standard (BE 1R)", "Wide (BE 1.5R)"])

volIn    = input.string("Off", "Volume Filter", options = ["Off", "Above Average (1.0x)", "Strong (1.5x)"], group = G_VOL)
volLenIn = input.int(20, "Volume Average Length", minval = 2, group = G_VOL)
emaFastIn = input.int(9, "EMA Cloud Fast", minval = 1, group = G_BIAS)
emaSlowIn = input.int(21, "EMA Cloud Slow", minval = 1, group = G_BIAS)
biasFilterIn = input.bool(false, "Only Trade With EMA Bias", group = G_BIAS)

payloadModeIn = input.string("Generic JSON (Futures / Any Webhook)", "Alert Payload", group = G_STAX,
     options = ["Stax Options Webhook", "Generic JSON (Futures / Any Webhook)"])
tickerOverrideIn = input.string("", "Underlying Symbol Override (blank = chart root)", group = G_STAX)
dteIn            = input.int(0, "Days To Expiration (0 = 0DTE)", minval = 0, maxval = 60, group = G_STAX)
strikesOtmIn     = input.int(0, "Strikes OTM", minval = 0, group = G_STAX)
strikeStepIn     = input.float(1.0, "Strike Step", minval = 0.5, step = 0.5, group = G_STAX)
sendExitAlertsIn = input.bool(true, "Send Exit Alerts", group = G_STAX)
sendStopUpdIn    = input.bool(false, "Send Stop-Update Alerts", group = G_STAX)
rangeOnIn        = input.bool(true, "Range Watch", group = G_STAX,
     tooltip = "One watch when the last bars compress and a shelf is waiting. It is not a trade.")
rangeBarsIn      = input.int(6, "Range Watch Bars", minval = 2, group = G_STAX)
rangeAtrIn       = input.float(1.5, "Range Watch Height (ATR x)", minval = 0.1, step = 0.1, group = G_STAX)
intrabarOnIn     = input.bool(true, "Intrabar Break", group = G_STAX,
     tooltip = "On a realtime bar, price through a shelf by the reclaim tolerance with a displacement body sends one provisional break_forming alert. The close arms the plan or sends break_cancelled.")

showTableIn    = input.bool(true, "Show HUD", group = G_DISPLAY)
hudSizeIn      = input.string("Full", "HUD size", options = ["Full", "Compact"], group = G_DISPLAY)
hudPosIn       = input.string("Top right", "HUD position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DISPLAY)
showDrawingsIn = input.bool(true, "Show Chart Drawings", group = G_DISPLAY)
resolvedIn     = input.string("Remove", "Resolved Plans", options = ["Grey", "Remove", "Review"], group = G_DISPLAY,
     tooltip = "Remove deletes the drawing. Grey keeps a faint entry line and a state tag for the last three. Review keeps the last five with entry, stop, and target lines in grey, plus the state tag and the reason.")
showSessBgIn   = input.bool(true, "Shade Active Session", group = G_DISPLAY)
showHtfIn      = input.bool(true, "Show HTF Zones", group = G_DISPLAY,
     tooltip = "Draws each higher-timeframe zone faintly. A zone is the level plus or minus 0.1 ATR. Overlapping zones merge.")
cloudColorIn   = input.color(#00c8ff, "EMA Cloud Color", group = G_DISPLAY)

pauseOnIn   = input.bool(true, "Session Pause", group = G_SESSION)
pauseSessIn = input.session("1500-1700", "Pause Window", group = G_SESSION,
     tooltip = "Default 3:00–5:00 PM on the pause timezone. No new plan arms and no fill triggers in the window.")
pauseTzIn   = input.string("America/Chicago", "Pause Timezone", group = G_SESSION)

// A - additive annotations, sizing, and tester orders.
intrabarCheckIn = input.bool(true, "A2 - Intrabar order certainty", group = G_ENGINE,
     tooltip = "Annotates ambiguous same-bar touches without changing the plan state machine.")
slippageTicksIn = input.int(0, "A3 - Slippage ticks", minval = 0, maxval = 100, group = G_ENGINE)
commissionRTIn = input.float(0.0, "A3 - Commission round trip ($ / contract)", minval = 0, step = 0.05, group = G_ENGINE)
riskDollarsIn = input.float(0.0, "A4 - Risk dollars (0 = off)", minval = 0, step = 25, group = G_ENGINE)
maxContractsIn = input.int(30, "A4 - Maximum contracts", minval = 1, maxval = 300, group = G_ENGINE)

// B - every behavior-changing mode is disabled at the default settings.
useCatalogIn = input.bool(false, "B1 - Use level catalog", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
catalogFeedsGradeIn = input.bool(false, "B1 - Catalog feeds room and grade", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Requires Use level catalog.")
equalAtrTolIn = input.float(0.25, "B1 - Equal level ATR tolerance", minval = 0, step = 0.01, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used by the level catalog.")
catalogPivotLenIn = input.int(2, "B1 - Equal pivot length", minval = 1, maxval = 10, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used by the level catalog.")
equalLookbackIn = input.int(150, "B1 - Equal pivot lookback bars", minval = 5, maxval = 500, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used by the level catalog.")
equalCapIn = input.int(8, "B1 - Equal levels retained", minval = 2, maxval = 12, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used by the level catalog.")
pubAsiaIn = input.bool(false, "B2 - Publish Asia", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
pubLondonIn = input.bool(false, "B2 - Publish London", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
pubNYIn = input.bool(false, "B2 - Publish New York", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
pubAsiaWindowIn = input.session("1900-0200", "B2 - Asia window (New York)", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when Publish Asia is enabled.")
pubLondonWindowIn = input.session("0300-0700", "B2 - London window (New York)", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when Publish London is enabled.")
pubNYIndexWindowIn = input.session("0930-1545", "B2 - MNQ/MES New York window", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when Publish New York is enabled.")
pubNYGoldWindowIn = input.session("0820-1330", "B2 - MGC New York window", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when Publish New York is enabled.")
newsTimesIn = input.string("0830,1000,1400", "B3 - News times (HHMM, New York)", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when the news block length is nonzero.")
newsBlockMinutesIn = input.int(0, "B3 - News block +/- minutes (0 = off)", minval = 0, maxval = 60, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Zero disables the block.")
useTickFloorIn = input.bool(false, "B4 - Use tick floors", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
mnqFloorTicksIn = input.int(8, "B4 - MNQ floor ticks", minval = 1, maxval = 100, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when tick floors are enabled.")
mesFloorTicksIn = input.int(4, "B4 - MES floor ticks", minval = 1, maxval = 100, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when tick floors are enabled.")
mgcFloorTicksIn = input.int(10, "B4 - MGC floor ticks", minval = 1, maxval = 100, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when tick floors are enabled.")
genericFloorTicksIn = input.int(8, "B4 - Generic floor ticks", minval = 1, maxval = 100, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when tick floors are enabled.")
useScaledHTFIn = input.bool(false, "B5 - Use scaled higher-timeframe swings", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
topDownFilterIn = input.bool(false, "B6a - Top-down structure filter", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
topDownFastEmaIn = input.int(100, "B6a - Fallback EMA fast", minval = 1, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when top-down structure is enabled.")
topDownSlowEmaIn = input.int(200, "B6a - Fallback EMA slow", minval = 1, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when top-down structure is enabled.")
structuralTargets2In = input.bool(false, "B6b - Structural targets 2", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
tp2MinRIn = input.float(1.0, "B6b - Minimum TP2 R (0 = off)", minval = 0, step = 0.1, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used by structural targets 2.")
confirmBeforeFillIn = input.bool(false, "B6c - Confirm before fill", group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF.")
confirmPivotLenIn = input.int(2, "B6c - Pullback pivot length", minval = 1, maxval = 10, group = G_ENGINE,
     tooltip = "Changes which plans arm/fill/grade. Default OFF. Used when confirm-before-fill is enabled.")

pDir = switch presetIn
    "NY AM Scalper"          => "Both"
    "NY AM Standard"         => "Both"
    "London Breakout"        => "Both"
    "Overnight Conservative" => "Both"
    => dirIn
pSess = presetIn == "NY AM Scalper" or presetIn == "NY AM Standard" ? "NY AM (09:30-12:00)" : presetIn == "London Breakout" ? "London (03:00-06:00)" : presetIn == "Overnight Conservative" ? "Overnight (18:00-03:00)" : sessIn
pTp = tpRIn
pSl = switch presetIn
    "NY AM Scalper"          => "Medium"
    "NY AM Standard"         => "Large"
    "London Breakout"        => "Medium"
    "Overnight Conservative" => "Large"
    => slTypeIn
pBe = switch presetIn
    "NY AM Scalper"          => "Off"
    "NY AM Standard"         => "Off"
    "London Breakout"        => "Off"
    "Overnight Conservative" => "At 1R"
    => beIn
pTrail = switch presetIn
    "NY AM Scalper"          => "Aggressive (BE 0.75R)"
    "NY AM Standard"         => "Standard (BE 1R)"
    "London Breakout"        => "Standard (BE 1R)"
    "Overnight Conservative" => "Off"
    => trailIn
pMaxTrades = switch presetIn
    "NY AM Scalper"          => 3
    "NY AM Standard"         => 3
    "London Breakout"        => 2
    "Overnight Conservative" => 2
    => maxTradesIn

sessStr = pSess == "NY AM (09:30-12:00)" ? "0930-1200" : pSess == "NY PM (13:00-16:00)" ? "1300-1600" : pSess == "London (03:00-06:00)" ? "0300-0600" : pSess == "Asia (20:00-00:00)" ? "2000-0000" : pSess == "Overnight (18:00-03:00)" ? "1800-0300" : pSess == "Custom" ? customSessIn : ""
sessShort = pSess == "NY AM (09:30-12:00)" ? "NY AM" : pSess == "NY PM (13:00-16:00)" ? "NY PM" : pSess == "London (03:00-06:00)" ? "London" : pSess == "Asia (20:00-00:00)" ? "Asia" : pSess == "Overnight (18:00-03:00)" ? "Overnight" : pSess == "Custom" ? customSessIn : "24/5"
sessionFilterOn = sessStr != ""
sessForTime = sessionFilterOn ? sessStr : "0000-2359:1234567"
legacyInSession = not sessionFilterOn or not na(time(timeframe.period, sessForTime, tzIn))
pubWindowMode = pubAsiaIn or pubLondonIn or pubNYIn
pubAsiaNow = pubAsiaIn and not na(time(timeframe.period, pubAsiaWindowIn + ":1234567", "America/New_York"))
pubLondonNow = pubLondonIn and not na(time(timeframe.period, pubLondonWindowIn + ":1234567", "America/New_York"))
pubNYWindow = syminfo.root == "MGC" ? pubNYGoldWindowIn : pubNYIndexWindowIn
pubNYNow = pubNYIn and not na(time(timeframe.period, pubNYWindow + ":1234567", "America/New_York"))
inSession = pubWindowMode ? (pubAsiaNow or pubLondonNow or pubNYNow) : legacyInSession
sessionEnded = inSession[1] and not inSession
pauseHit = time(timeframe.period, pauseSessIn, pauseTzIn)
inPause = pauseOnIn and not na(pauseHit)
inAsiaSess = not na(time(timeframe.period, "2000-0000", "America/Chicago"))
inLonSess = not na(time(timeframe.period, "0300-0600", "America/Chicago"))
inOnSess = not na(time(timeframe.period, "1800-0300", "America/Chicago"))
tick = syminfo.mintick
longsOk = pDir != "Shorts Only"
shortsOk = pDir != "Longs Only"
trailOn = pTrail != "Off"
beOn = not trailOn and pBe != "Off"
beR = switch pBe
    "At 0.5R"  => 0.5
    "At 0.75R" => 0.75
    "At 1R"    => 1.0
    "At 1.5R"  => 1.5
    => 0.0
trailBe = switch pTrail
    "Aggressive (BE 0.75R)" => 0.75
    "Standard (BE 1R)"      => 1.0
    "Wide (BE 1.5R)"        => 1.5
    => 0.0
trailT1 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.0
    "Standard (BE 1R)"      => 1.5
    "Wide (BE 1.5R)"        => 2.0
    => 0.0
trailO1 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.25
    "Standard (BE 1R)"      => 0.5
    "Wide (BE 1.5R)"        => 0.5
    => 0.0
trailT2 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.25
    "Standard (BE 1R)"      => 2.0
    "Wide (BE 1.5R)"        => 2.5
    => 0.0
trailO2 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.5
    "Standard (BE 1R)"      => 1.0
    "Wide (BE 1.5R)"        => 1.0
    => 0.0
trailT3 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.5
    "Standard (BE 1R)"      => 2.5
    "Wide (BE 1.5R)"        => 3.0
    => 0.0
trailO3 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.75
    "Standard (BE 1R)"      => 1.5
    "Wide (BE 1.5R)"        => 1.5
    => 0.0
volMult = switch volIn
    "Above Average (1.0x)" => 1.0
    "Strong (1.5x)"        => 1.5
    => 0.0
staxMode = payloadModeIn == "Stax Options Webhook"
targetsOk = tp1OnIn or tp2OnIn or tp3OnIn

emaFast = ta.ema(close, emaFastIn)
emaSlow = ta.ema(close, emaSlowIn)
bias = close > emaFast and emaFast > emaSlow ? 1 : close < emaFast and emaFast < emaSlow ? -1 : 0
atr = ta.atr(14)
armAtr = atr[1]
compHi = ta.highest(high, rangeBarsIn)
compLo = ta.lowest(low, rangeBarsIn)
volSma = ta.sma(volume, volLenIn)

f_htf() =>
    float fast = ta.ema(close, emaFastIn)
    float slow = ta.ema(close, emaSlowIn)
    close > fast and fast > slow ? 1 : close < fast and fast < slow ? -1 : 0
hD  = request.security(syminfo.tickerid, "D", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h4  = request.security(syminfo.tickerid, "240", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h1  = request.security(syminfo.tickerid, "60", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h15 = request.security(syminfo.tickerid, "15", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h5  = request.security(syminfo.tickerid, "5", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
pdh = request.security(syminfo.tickerid, "D", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
f_htf_piv() =>
    [ta.pivothigh(high, swingLenIn, swingLenIn)[1], ta.pivotlow(low, swingLenIn, swingLenIn)[1]]
[dPh, dPl] = request.security(syminfo.tickerid, "D", f_htf_piv(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h4Ph, h4Pl] = request.security(syminfo.tickerid, "240", f_htf_piv(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h1Ph, h1Pl] = request.security(syminfo.tickerid, "60", f_htf_piv(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// Batch A intrabar certainty uses the smallest available interval no greater than one minute.
string intrabarTf = timeframe.in_seconds() > 60 ? "1" : timeframe.period
array<float> ltfHighs = na
array<float> ltfLows = na
if intrabarCheckIn
    [ltfHighResult, ltfLowResult] = request.security_lower_tf(syminfo.tickerid, intrabarTf, [high, low])
    ltfHighs := ltfHighResult
    ltfLows := ltfLowResult

// Batch B5 contexts are separate from the fixed D / 4H / 1H / 15m / 5m requests above.
f_scaledPiv(int pivotLength) =>
    [ta.pivothigh(high, pivotLength, pivotLength)[1], ta.pivotlow(low, pivotLength, pivotLength)[1]]
chartSeconds = timeframe.in_seconds()
scaledSetupSeconds = math.max(900, chartSeconds * 3)
scaledPositionSeconds = math.max(3600, chartSeconds * 12)
scaledRunnerSeconds = math.max(14400, chartSeconds * 48)
scaledSlowSeconds = math.max(86400, chartSeconds * 288)
scaledSetupTf = timeframe.from_seconds(int(scaledSetupSeconds))
scaledPositionTf = timeframe.from_seconds(int(scaledPositionSeconds))
scaledRunnerTf = timeframe.from_seconds(int(scaledRunnerSeconds))
scaledSlowTf = timeframe.from_seconds(int(scaledSlowSeconds))
float scaledSetupPh = na
float scaledSetupPl = na
float scaledPositionPh = na
float scaledPositionPl = na
float scaledRunnerPh = na
float scaledRunnerPl = na
float scaledSlowPh = na
float scaledSlowPl = na
if useScaledHTFIn and chartSeconds >= 900
    [scaledSetupPhResult, scaledSetupPlResult] = request.security(syminfo.tickerid, scaledSetupTf, f_scaledPiv(swingLenIn), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    [scaledPositionPhResult, scaledPositionPlResult] = request.security(syminfo.tickerid, scaledPositionTf, f_scaledPiv(swingLenIn), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    [scaledRunnerPhResult, scaledRunnerPlResult] = request.security(syminfo.tickerid, scaledRunnerTf, f_scaledPiv(swingLenIn), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    [scaledSlowPhResult, scaledSlowPlResult] = request.security(syminfo.tickerid, scaledSlowTf, f_scaledPiv(swingLenIn), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    scaledSetupPh := scaledSetupPhResult
    scaledSetupPl := scaledSetupPlResult
    scaledPositionPh := scaledPositionPhResult
    scaledPositionPl := scaledPositionPlResult
    scaledRunnerPh := scaledRunnerPhResult
    scaledRunnerPl := scaledRunnerPlResult
    scaledSlowPh := scaledSlowPhResult
    scaledSlowPl := scaledSlowPlResult
[setup15Ph, setup15Pl] = request.security(syminfo.tickerid, "15", f_scaledPiv(swingLenIn), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// B6a: confirmed slow / runner context directions from the Engine's structure rule.
f_structDir(int pivotLength) =>
    var int dirS = 0
    var float lastHiS = na
    var float lastLoS = na
    float phS = ta.pivothigh(high, pivotLength, pivotLength)
    float plS = ta.pivotlow(low, pivotLength, pivotLength)
    if not na(phS)
        lastHiS := phS
    if not na(plS)
        lastLoS := plS
    if not na(lastHiS) and close > lastHiS
        dirS := 1
        lastHiS := na
    if not na(lastLoS) and close < lastLoS
        dirS := -1
        lastLoS := na
    dirS
htfStructSlow = request.security(syminfo.tickerid, "D", f_structDir(2)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
htfStructRunner = request.security(syminfo.tickerid, "240", f_structDir(2)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
fallbackFast = ta.ema(close, topDownFastEmaIn)
fallbackSlow = ta.ema(close, topDownSlowEmaIn)
fallbackDirection = close > fallbackFast and fallbackFast > fallbackSlow ? 1 : close < fallbackFast and fallbackFast < fallbackSlow ? -1 : 0
topDownDirection = htfStructSlow != 0 and htfStructSlow == htfStructRunner ? htfStructSlow : fallbackDirection
[positionOpen, positionHigh, positionLow, positionClose] = request.security(syminfo.tickerid, "60", [open[1], high[1], low[1], close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

ph = ta.pivothigh(high, swingLenIn, swingLenIn)
pl = ta.pivotlow(low, swingLenIn, swingLenIn)
confirmPullbackPh = ta.pivothigh(high, confirmPivotLenIn, confirmPivotLenIn)
confirmPullbackPl = ta.pivotlow(low, confirmPivotLenIn, confirmPivotLenIn)
var float rangeHigh = na
var float rangeLow = na
var int rangeHighBar = na
var int rangeLowBar = na
if not na(ph)
    rangeHigh := ph
    rangeHighBar := bar_index - swingLenIn
if not na(pl)
    rangeLow := pl
    rangeLowBar := bar_index - swingLenIn
lowLegLen = na(rangeLowBar) ? legLookbackIn : math.max(1, math.min(legLookbackIn, bar_index - rangeLowBar + 1))
highLegLen = na(rangeHighBar) ? legLookbackIn : math.max(1, math.min(legLookbackIn, bar_index - rangeHighBar + 1))
legLowNow = ta.lowest(low, lowLegLen)
legHighNow = ta.highest(high, highLegLen)
zoneWidth = not na(rangeHigh) and not na(rangeLow) ? rangeHigh - rangeLow : 0.0
bodyDisp = math.abs(close - open) >= dispBodyAtrIn * atr
bullBeyond = not na(rangeHigh) and zoneWidth > 0 and close - rangeHigh >= zoneWidth
bearBeyond = not na(rangeLow) and zoneWidth > 0 and rangeLow - close >= zoneWidth
bullDisp = dispModeIn == "Close beyond zone by zone width" ? bullBeyond : bodyDisp
bearDisp = dispModeIn == "Close beyond zone by zone width" ? bearBeyond : bodyDisp
bullThrough = not na(rangeHigh) and close > rangeHigh and (na(close[1]) or close[1] <= rangeHigh)
bearThrough = not na(rangeLow) and close < rangeLow and (na(close[1]) or close[1] >= rangeLow)
strongDisp = math.abs(close - open) >= strongAtrIn * atr
shelfOk = zoneWidth > 0 and (minRangeAtrIn <= 0 or zoneWidth >= minRangeAtrIn * atr)
bullFvg = low > high[2] and close[1] > open[1]
bearFvg = high < low[2] and close[1] < open[1]
volOk = volMult <= 0 or volume > volSma * volMult

