//@version=6
indicator("Stax A1+A2", shorttitle="Stax A1+A2", overlay=true, max_lines_count=80, max_labels_count=80, max_boxes_count=30, max_bars_back=600)
// Canonical definitions: playbook v1.9. Checkpoint A1+A2 only; no candidate/webhook/trade engine.
string ET = "America/New_York"
string gSession = "A1 - ET range catalog (OWNER VERIFY boundaries)"
string asia = input.session("1900-0200", "Asia ET", group=gSession)
string london = input.session("0300-0700", "London ET", group=gSession)
string nyIndex = input.session("0930-1600", "MNQ/MES NY ET", group=gSession)
string nyGold = input.session("0820-1130", "MGC NY ET", group=gSession)
string onIndex = input.session("1800-0930", "MNQ/MES overnight ET", group=gSession)
string onGold = input.session("1800-0820", "MGC overnight ET", group=gSession)
int orMinutes = input.int(30, "Equity opening range minutes", minval=5, maxval=120, step=5, group=gSession)
float eqATRMult = input.float(0.1, "Equal H/L tolerance / ATR(14) - OWNER TUNE", minval=0.0, step=0.01, group="A1 - Equal liquidity")
int pivotBars = input.int(2, "Confirmed pivot left/right bars - OWNER TUNE", minval=1, maxval=10, group="A1 - Equal liquidity")
int pairLookback = input.int(150, "Maximum equal-pivot separation bars", minval=5, maxval=500, group="A1 - Equal liquidity")
int equalCap = input.int(8, "Maximum equal levels retained", minval=2, maxval=12, group="A1 - Equal liquidity")
float strongMult = input.float(1.5, "STRONG body / ATR - OWNER TUNE", minval=0.1, step=0.1, group="A2 - Structure")
float fvgMult = input.float(0.1, "Minimum FVG / ATR - OWNER TUNE", minval=0.0, step=0.05, group="A2 - Structure")
bool drawLevels = input.bool(true, "Draw catalog levels", group="Display")
bool showSwept = input.bool(false, "Show swept levels (historical context)", group="Display")
int labelOffset = input.int(6, "Level label offset bars", minval=2, maxval=30, group="Display")
bool drawGaps = input.bool(true, "Draw live FVGs", group="Display")
bool showStructure = input.bool(true, "Plot confirmed structure", group="Display")
bool debugCatalog = input.bool(false, "Full level catalog table", group="Debug - Replay only")
bool debugDisplacement = input.bool(false, "Displacement grade on each confirmed bar", group="Debug - Replay only")

bool gold = syminfo.root == "MGC"
bool equity = syminfo.root == "MNQ" or syminfo.root == "MES"
if barstate.isfirst and (not (gold or equity) or not chart.is_standard or timeframe.in_seconds() != 300)
    runtime.error("A1+A2 review build requires MGC, MNQ or MES on standard 5-minute candles with ETH data.")

type CatalogLevel
    float price
    string kind
    int side
    bool major
    bool live
    bool covered
    bool swept
    bool flipped
    int born
    line drawing
    label tag

type SessionRange
    float hi = na
    float lo = na
    bool active = false
    bool covered = false
    int key = na

type Gap
    float top
    float bottom
    int side
    int born
    box drawing

var array<CatalogLevel> catalog = array.new<CatalogLevel>()
var array<Gap> gaps = array.new<Gap>()
var SessionRange globe = SessionRange.new()
var SessionRange overnight = SessionRange.new()
var SessionRange asiaRange = SessionRange.new()
var SessionRange londonRange = SessionRange.new()
var SessionRange nyRange = SessionRange.new()
var SessionRange opening = SessionRange.new()
if barstate.isfirst
    for i = 0 to 11
        array.push(catalog, CatalogLevel.new(na, "", 0, true, false, false, false, false, 0, na, na))

f_put(int slot, float price, string kind, int side, bool major, bool live, bool covered, bool fresh) =>
    CatalogLevel lv = array.get(catalog, slot)
    lv.price := price
    lv.kind := kind
    lv.side := side
    lv.major := major
    lv.live := live
    lv.covered := covered
    if fresh
        lv.swept := false
        lv.flipped := false
        lv.born := bar_index
        if not na(lv.drawing)
            line.delete(lv.drawing)
            lv.drawing := na
        if not na(lv.tag)
            label.delete(lv.tag)
            lv.tag := na

f_range(SessionRange r, bool inside, int dayKey, bool atStart, int slot, string prefix, bool major) =>
    bool fresh = inside and (not r.active or na(r.key) or r.key != dayKey)
    if fresh
        r.hi := high
        r.lo := low
        r.covered := atStart
        r.key := dayKey
    else if inside
        r.hi := math.max(r.hi, high)
        r.lo := math.min(r.lo, low)
    if slot >= 0 and (inside or r.active)
        f_put(slot, r.hi, prefix + "H", 1, major, inside, r.covered, fresh)
        f_put(slot + 1, r.lo, prefix + "L", -1, major, inside, r.covered, fresh)
    r.active := inside

f_start(string window) =>
    int hh = int(str.tonumber(str.substring(window, 0, 2)))
    int mm = int(str.tonumber(str.substring(window, 2, 4)))
    hour(time, ET) == hh and minute(time, ET) == mm

f_in(string window) => not na(time(timeframe.period, window + ":1234567", ET))

f_equal(float current, float prior, int priorBar, int side, float confirmedBarATR) =>
    // Tolerance uses ATR available on this confirmation bar, never future/pivot-backdated ATR.
    float tolerance = eqATRMult * confirmedBarATR
    bool valid = not na(confirmedBarATR) and confirmedBarATR > 0 and not na(current) and not na(prior) and not na(priorBar) and math.abs(current - prior) <= tolerance and bar_index - pivotBars - priorBar <= pairLookback
    float level = side == 1 ? math.max(current, prior) : math.min(current, prior)
    if valid
        // Availability is now, not the pivot candle. Reject liquidity already traded through between pivots and confirmation.
        int age = math.min(bar_index - priorBar, 500)
        for j = 0 to age
            if (side == 1 and high[j] > level) or (side == -1 and low[j] < level)
                valid := false
        if array.size(catalog) > 12
            for j = 12 to array.size(catalog) - 1
                CatalogLevel existing = array.get(catalog, j)
                if not existing.swept and existing.side == side and math.abs(existing.price - level) <= tolerance
                    valid := false
    if valid
        array.push(catalog, CatalogLevel.new(level, side == 1 ? "EQH" : "EQL", side, true, false, true, false, false, bar_index, na, na))
        if array.size(catalog) > 12 + equalCap
            CatalogLevel removed = array.remove(catalog, 12)
            if not na(removed.drawing)
                line.delete(removed.drawing)
            if not na(removed.tag)
                label.delete(removed.tag)

float atr = ta.atr(14)
float ph = ta.pivothigh(high, pivotBars, pivotBars)
float pl = ta.pivotlow(low, pivotBars, pivotBars)
var float lastPH = na
var float lastPL = na
var int lastPHBar = na
var int lastPLBar = na
var float structureHigh = na
var float structureLow = na
var bool highBroken = false
var bool lowBroken = false
var string displacement = "WAIT"
var string structureStatus = "WAIT"
var string sweepStatus = "NONE"
var float confirmedATR = na
var int lastCut = na
int hhET = hour(time, ET)
int dayKey = timestamp(ET, year(time, ET), month(time, ET), dayofmonth(time, ET) + (hhET >= 18 ? 1 : 0), 0, 0)
string nyWindow = gold ? nyGold : nyIndex
string onWindow = gold ? onGold : onIndex
int minutesET = hhET * 60 + minute(time, ET)
bool inOR = equity and minutesET >= 570 and minutesET < 570 + orMinutes

if barstate.isconfirmed
    lastCut := time_close
    confirmedATR := atr
    bool newDay = not na(globe.key) and dayKey != globe.key
    if newDay
        f_put(0, globe.hi, "PDH", 1, true, false, globe.covered, true)
        f_put(1, globe.lo, "PDL", -1, true, false, globe.covered, true)
    // 17:00-16:00 CT is 18:00-17:00 ET, including DST via IANA timezone.
    f_range(globe, f_in("1800-1700"), dayKey, f_start("1800-1700"), -1, "", true)
    f_range(overnight, f_in(onWindow), dayKey, f_start(onWindow), 2, "ON", true)
    f_range(asiaRange, f_in(asia), dayKey, f_start(asia), 4, "ASIA ", true)
    f_range(londonRange, f_in(london), dayKey, f_start(london), 6, "LONDON ", true)
    f_range(nyRange, f_in(nyWindow), dayKey, f_start(nyWindow), 8, "NY ", true)
    // OR is catalogued but minor for first-obstacle purposes: not listed among §1.9 major blockers.
    f_range(opening, inOR, dayKey, minutesET == 570, 10, "OR", false)
    sweepStatus := "NONE"
    for i = 0 to array.size(catalog) - 1
        CatalogLevel lv = array.get(catalog, i)
        if not na(lv.price) and not lv.live and lv.covered and not lv.swept
            bool sweptNow = (lv.side == 1 and high > lv.price and close < lv.price) or (lv.side == -1 and low < lv.price and close > lv.price)
            if sweptNow
                lv.swept := true
                lv.major := false
                sweepStatus := lv.kind + " @ " + str.tostring(lv.price, format.mintick)
            else if (lv.side == 1 and close > lv.price) or (lv.side == -1 and close < lv.price)
                lv.side := -lv.side
                lv.flipped := true
    bool breakUp = not na(structureHigh) and not highBroken and close > structureHigh
    bool breakDown = not na(structureLow) and not lowBroken and close < structureLow
    structureStatus := breakUp ? "BOS UP" : breakDown ? "BOS DOWN" : "NO NEW BOS"
    if breakUp
        highBroken := true
    if breakDown
        lowBroken := true
    bool bullFVG = bar_index >= 2 and low > high[2] and low - high[2] >= atr * fvgMult
    bool bearFVG = bar_index >= 2 and high < low[2] and low[2] - high >= atr * fvgMult
    float body = math.abs(close - open)
    float span = high - low
    bool outerClose = span > 0 and ((close > open and close >= high - span * 0.25) or (close < open and close <= low + span * 0.25))
    bool alignedTwo = bar_index >= 1 and ((close > open and close[1] > open[1]) or (close < open and close[1] < open[1])) and math.abs(close - open[1]) >= strongMult * atr
    bool alignedThree = bar_index >= 2 and ((close > open and close[1] > open[1] and close[2] > open[2]) or (close < open and close[1] < open[1] and close[2] < open[2])) and math.abs(close - open[2]) >= strongMult * atr
    bool alignedRun = alignedTwo or alignedThree
    bool strong = (body >= strongMult * atr or alignedRun) and outerClose and ((breakUp and bullFVG) or (breakDown and bearFVG))
    bool adequate = ((breakUp and close > open) or (breakDown and close < open))
    displacement := na(atr) ? "WAIT ATR" : strong ? "STRONG" : adequate ? "ADEQUATE" : "WEAK"
    if array.size(gaps) > 0
        for i = array.size(gaps) - 1 to 0
            Gap gap = array.get(gaps, i)
            bool filled = (gap.side == 1 and low <= gap.bottom) or (gap.side == -1 and high >= gap.top)
            if bar_index > gap.born and filled
                if not na(gap.drawing)
                    box.delete(gap.drawing)
                array.remove(gaps, i)
    if bullFVG or bearFVG
        float top = bullFVG ? low : low[2]
        float bottom = bullFVG ? high[2] : high
        int side = bullFVG ? 1 : -1
        box drawing = drawGaps ? box.new(bar_index, top, bar_index + 1, bottom, bgcolor=color.new(side == 1 ? color.teal : color.orange, 88), border_color=color.new(color.gray, 50), extend=extend.right) : na
        array.push(gaps, Gap.new(top, bottom, side, bar_index, drawing))
        if array.size(gaps) > 20
            Gap removed = array.shift(gaps)
            if not na(removed.drawing)
                box.delete(removed.drawing)
    // A pivot discovered on this bar cannot cause a retroactive structure break.
    if not na(ph)
        f_equal(ph, lastPH, lastPHBar, 1, atr)
        lastPH := ph
        lastPHBar := bar_index - pivotBars
        structureHigh := ph
        highBroken := false
    if not na(pl)
        f_equal(pl, lastPL, lastPLBar, -1, atr)
        lastPL := pl
        lastPLBar := bar_index - pivotBars
        structureLow := pl
        lowBroken := false

plot(showStructure ? structureHigh : na, "Confirmed swing high", color=color.new(color.red, 60), style=plot.style_stepline, display=display.pane)
plot(showStructure ? structureLow : na, "Confirmed swing low", color=color.new(color.green, 60), style=plot.style_stepline, display=display.pane)
plotshape(debugDisplacement and barstate.isconfirmed and displacement == "STRONG", title="Debug STRONG displacement", style=shape.labeldown, location=location.abovebar, color=color.green, text="STRONG", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(debugDisplacement and barstate.isconfirmed and displacement == "ADEQUATE", title="Debug ADEQUATE displacement", style=shape.labeldown, location=location.abovebar, color=color.orange, text="ADEQUATE", textcolor=color.black, size=size.tiny, display=display.pane)
plotshape(debugDisplacement and barstate.isconfirmed and displacement == "WEAK", title="Debug WEAK displacement", style=shape.labeldown, location=location.abovebar, color=color.gray, text="WEAK", textcolor=color.white, size=size.tiny, display=display.pane)
// Keep catalog facts internal for the future Discord payload; TradingView displays only chart indications.
f_name(string kind) =>
    switch kind
        "PDH" => "Prior Day High"
        "PDL" => "Prior Day Low"
        "ONH" => "Overnight High"
        "ONL" => "Overnight Low"
        "ASIA H" => "Asia High"
        "ASIA L" => "Asia Low"
        "LONDON H" => "London High"
        "LONDON L" => "London Low"
        "NY H" => "New York High"
        "NY L" => "New York Low"
        "ORH" => "Opening Range High"
        "ORL" => "Opening Range Low"
        "EQH" => "Equal Highs"
        "EQL" => "Equal Lows"
        => kind

f_color(string kind) =>
    str.startswith(kind, "PD") ? color.orange : str.startswith(kind, "ON") ? color.aqua : str.startswith(kind, "ASIA") ? color.fuchsia : str.startswith(kind, "LONDON") ? color.rgb(100, 170, 255) : str.startswith(kind, "NY") ? color.lime : str.startswith(kind, "OR") ? color.yellow : color.rgb(255, 140, 185)

f_text(CatalogLevel lv) =>
    f_name(lv.kind) + "  " + str.tostring(lv.price, format.mintick) + (lv.swept ? "  SWEPT" : not lv.covered ? "  PARTIAL" : lv.live ? "  LIVE" : lv.flipped ? "  FLIPPED" : "")

// Optional inspection only: includes swept entries even when chart drawings hide them.
var table debugPanel = debugCatalog ? table.new(position.top_right, 6, 29, bgcolor=color.new(color.black, 5), border_width=1) : na
if barstate.islast and debugCatalog
    table.clear(debugPanel, 0, 0, 5, 28)
    table.cell(debugPanel, 0, 0, "CONFIRMED CUT / ET", text_color=color.white, text_size=size.small)
    table.cell(debugPanel, 1, 0, na(lastCut) ? "WAIT" : str.format_time(lastCut, "MM-dd HH:mm", ET), text_color=color.white, text_size=size.small)
    array<string> headings = array.from("LEVEL", "PRICE", "CLASS", "LIQUIDITY", "EQUAL", "COVERAGE")
    for col = 0 to 5
        table.cell(debugPanel, col, 1, array.get(headings, col), text_color=color.white, text_size=size.small)
    int row = 2
    for i = 0 to array.size(catalog) - 1
        CatalogLevel lv = array.get(catalog, i)
        if not na(lv.price)
            bool equalLevel = lv.kind == "EQH" or lv.kind == "EQL"
            color ink = lv.swept ? color.silver : f_color(lv.kind)
            table.cell(debugPanel, 0, row, f_name(lv.kind), text_color=ink, text_size=size.small)
            table.cell(debugPanel, 1, row, str.tostring(lv.price, format.mintick), text_color=ink, text_size=size.small)
            table.cell(debugPanel, 2, row, lv.major ? "MAJOR" : "MINOR", text_color=ink, text_size=size.small)
            table.cell(debugPanel, 3, row, lv.swept ? "SWEPT" : lv.flipped ? "UNSWEPT / FLIP" : "UNSWEPT", text_color=ink, text_size=size.small)
            table.cell(debugPanel, 4, row, equalLevel ? "YES" : "NO", text_color=ink, text_size=size.small)
            table.cell(debugPanel, 5, row, not lv.covered ? "PARTIAL" : lv.live ? "DEVELOPING" : "COMPLETE", text_color=ink, text_size=size.small)
            row += 1
    table.cell(debugPanel, 0, 27, "ATR(14)", text_color=color.white, text_size=size.small)
    table.cell(debugPanel, 1, 27, str.tostring(confirmedATR, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(debugPanel, 2, 27, "EQ TOL POINTS", text_color=color.white, text_size=size.small)
    table.cell(debugPanel, 3, 27, str.tostring(eqATRMult * confirmedATR, "#.#####"), text_color=color.white, text_size=size.small)
    table.cell(debugPanel, 0, 28, "CATALOG CAP", text_color=color.white, text_size=size.small)
    table.cell(debugPanel, 1, 28, "12 base + " + str.tostring(equalCap) + " equals", text_color=color.white, text_size=size.small)

if barstate.islast
    array<int> anchors = array.new_int(array.size(catalog), -1)
    float spacing = nz(confirmedATR, syminfo.mintick * 8) * 0.65
    // Group nearby annotations, never their price lines. Each row retains its exact price.
    for i = 0 to array.size(catalog) - 1
        CatalogLevel current = array.get(catalog, i)
        if drawLevels and not na(current.price) and (showSwept or not current.swept)
            int anchor = i
            if i > 0
                for j = 0 to i - 1
                    CatalogLevel earlier = array.get(catalog, j)
                    if anchor == i and array.get(anchors, j) == j and math.abs(earlier.price - current.price) <= spacing
                        anchor := j
            array.set(anchors, i, anchor)
    for i = 0 to array.size(catalog) - 1
        CatalogLevel lv = array.get(catalog, i)
        bool visible = drawLevels and not na(lv.price) and (showSwept or not lv.swept)
        if visible
            color ink = lv.swept ? color.gray : f_color(lv.kind)
            int labelX = bar_index + labelOffset
            if drawLevels
                if na(lv.drawing)
                    lv.drawing := line.new(bar_index, lv.price, bar_index + 1, lv.price, extend=extend.right, color=ink)
                line.set_x1(lv.drawing, math.max(lv.born, bar_index - 9999))
                line.set_x2(lv.drawing, labelX)
                line.set_extend(lv.drawing, extend.none)
                line.set_y1(lv.drawing, lv.price)
                line.set_y2(lv.drawing, lv.price)
                line.set_color(lv.drawing, ink)
                line.set_width(lv.drawing, lv.swept ? 1 : 2)
                line.set_style(lv.drawing, lv.live ? line.style_dotted : lv.swept ? line.style_dashed : line.style_solid)
                if array.get(anchors, i) == i
                    string caption = f_text(lv)
                    if i < array.size(catalog) - 1
                        for j = i + 1 to array.size(catalog) - 1
                            if array.get(anchors, j) == i
                                caption += "\n" + f_text(array.get(catalog, j))
                    if na(lv.tag)
                        lv.tag := label.new(labelX, lv.price, caption, style=label.style_label_left, color=color.new(color.black, 5), textcolor=ink, size=size.normal)
                    label.set_xy(lv.tag, labelX, lv.price)
                    label.set_text(lv.tag, caption)
                    label.set_textcolor(lv.tag, ink)
                else if not na(lv.tag)
                    label.delete(lv.tag)
                    lv.tag := na
        else
            if not na(lv.drawing)
                line.delete(lv.drawing)
                lv.drawing := na
            if not na(lv.tag)
                label.delete(lv.tag)
                lv.tag := na
