//@version=6
// ============================================================================
//  StaxBot 1.7
//  Saved script name is StaxBot 1.7, so TradingView can store it beside the
//  older StaxBot script. The chart legend reads Stax 1.7. The HUD reads
//  StaxBot 1.7.
//
//  TradingView presents the plan: direction, entry, stop, and enabled targets.
//  Targets are price levels at 1×, 2×, and 3× Take Profit (R). R is the
//  entry-to-stop distance. Weights are allocation shares, not contracts.
//  Dollar loss, dollar targets, point value, and contract quantity do not
//  qualify a setup and do not move a price.
//
//  This build does not call strategy.entry or strategy.exit. Those calls were
//  drawing the strategy arrows and the SL2 / SL3 order tags, and they treated
//  allocation weights as contract size. Entry, stop, and targets are lines.
//
//  Alerts are alert() calls only. In the alert dialog choose
//  "alert() function calls only". Do not also enable order fills.
//  TradingView snapshots these inputs when the alert is created. Changing an
//  input on the chart does not change an alert that is already running, and it
//  does not move a plan that is already drawn. The HUD then reads
//  INPUTS CHANGED. Recreate the alert.
//
//  The paper desk sizes contracts from its own risk setting. It must use the
//  prices in the alert. This script cannot read the desk.
// ============================================================================
strategy("StaxBot 1.7", shorttitle = "Stax 1.7", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     margin_long = 1, margin_short = 1,
     calc_on_every_tick = false, calc_on_order_fills = false, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.0, slippage = 0,
     calc_bars_count = 1000,
     max_boxes_count = 150, max_lines_count = 200, max_labels_count = 200)

G_PRESET  = "Preset"
G_COACH   = "Coach & Execution Filters"
G_STRUCT  = "Structure & Fair Value Gap"
G_TP      = "Take Profit"
G_SL      = "Stop Loss"
G_BE      = "Breakeven"
G_TRAIL   = "Trailing Stop"
G_VOL     = "Volume Filter"
G_BIAS    = "EMA Bias"
G_STAX    = "Stax Alerts"
G_DISPLAY = "Display"

presetIn = input.string("Manual", "Strategy Preset", group = G_PRESET,
     options = ["Manual", "NY AM Scalper", "NY AM Standard", "London Breakout", "Overnight Conservative"],
     tooltip = "Manual uses every input below as-is. A preset overrides Direction, Session, Take Profit (R), SL Type, Breakeven, Trailing Stop, and Max Trades Per Day. Target toggles and weights always come from the inputs.")

dirIn            = input.string("Both", "Allowed Direction", options = ["Both", "Longs Only", "Shorts Only"], group = G_COACH)
sessIn           = input.string("24/5 (No Filter)", "Session Preset", group = G_COACH,
     options = ["24/5 (No Filter)", "NY AM (09:30-12:00)", "NY PM (13:00-16:00)", "London (03:00-06:00)", "Asia (20:00-00:00)", "Overnight (18:00-03:00)", "Custom"])
customSessIn     = input.session("2000-2130", "Custom Session (If Custom Selected)", group = G_COACH)
tzIn             = input.string("America/New_York", "Timezone", group = G_COACH, tooltip = "IANA timezone used for sessions and alert timestamps.")
maxTradesIn      = input.int(5, "Max Trades Per Day", minval = 1, group = G_COACH)
flatAtSessEndIn  = input.bool(false, "Flatten Open Trade At Session End", group = G_COACH)
minGradeIn       = input.string("Off", "Minimum Grade", options = ["Off", "A", "A+"], group = G_COACH,
     tooltip = "Off takes every Breakaway setup. A keeps A and A+. A+ keeps A+ only. A+ needs all five: displacement, EMA bias, above-average volume, London 03:00-06:00 or New York 08:20-11:30, and the gap within 3 bars of the break. A is four of those five, and one must be displacement or the session.")

swingLenIn       = input.int(5, "Swing Length (Range Structure)", minval = 2, group = G_STRUCT)
minRangeAtrIn    = input.float(0.0, "Min Range Height (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_STRUCT)
dispAtrIn        = input.float(0.0, "Min Break Candle Body (ATR x, 0 = off)", minval = 0, step = 0.1, group = G_STRUCT)
fvgWindowIn      = input.int(5, "FVG Must Form Within N Bars Of The Break", minval = 1, group = G_STRUCT)
setupExpiryIn    = input.int(20, "Setup Expires After N Bars", minval = 1, group = G_STRUCT)
entryLevelIn     = input.string("FVG Near Edge (Aggressive)", "Entry Level", group = G_STRUCT,
     options = ["FVG Near Edge (Aggressive)", "FVG Midpoint (CE)", "FVG Far Edge (Deep)"])

tpRIn = input.float(1.0, "Take Profit (R)", minval = 0.1, maxval = 5, step = 0.1, group = G_TP,
     tooltip = "TP1 is this many R from entry. TP2 is twice that. TP3 is three times that. R is the entry-to-stop distance in price. This is not a dollar target.")
tp1OnIn = input.bool(true, "TP1", group = G_TP, tooltip = "Include the 1× target in the plan, the drawing, and the alert.")
tp2OnIn = input.bool(false, "TP2", group = G_TP, tooltip = "Include the 2× target. Spacing stays on the R ladder. This is not a freehand price.")
tp3OnIn = input.bool(false, "TP3", group = G_TP, tooltip = "Include the 3× target.")
tp1WIn  = input.int(1, "TP1 weight", minval = 1, maxval = 100, group = G_TP, tooltip = "Allocation share for TP1. Not a contract count. The paper desk turns shares into contracts.")
tp2WIn  = input.int(1, "TP2 weight", minval = 1, maxval = 100, group = G_TP)
tp3WIn  = input.int(1, "TP3 weight", minval = 1, maxval = 100, group = G_TP)

fvgCheckIn = input.string("Strict", "FVG Line Check", options = ["Strict", "Relaxed"], group = G_SL,
     tooltip = "Strict: cancel the resting plan if a candle closes through the far edge of the FVG before the fill. Relaxed: only a close beyond the stop cancels it.")
slTypeIn   = input.string("Large", "SL Type", options = ["Tight", "Medium", "Large"], group = G_SL,
     tooltip = "Tight = far edge of the FVG. Medium = low/high of the displacement candle. Large = origin of the leg.")
slBufferTicksIn = input.int(2, "SL Buffer (ticks)", minval = 0, group = G_SL)
legLookbackIn   = input.int(30, "Large SL: Max Leg Lookback (bars)", minval = 3, group = G_SL)
minStopTicksIn  = input.int(8, "Min Stop Distance (ticks)", minval = 1, group = G_SL)
maxStopPtsIn    = input.float(0, "Max Stop Distance (points, 0 = off)", minval = 0, group = G_SL)

beIn    = input.string("Off", "Breakeven", options = ["Off", "At 0.5R", "At 0.75R", "At 1R", "At 1.5R"], group = G_BE,
     tooltip = "Ignored while a Trailing Stop preset is on.")
beTickIn = input.bool(false, "BE +1 Tick Buffer", group = G_BE)
trailIn = input.string("Off", "Trailing Stop", group = G_TRAIL,
     options = ["Off", "Aggressive (BE 0.75R)", "Standard (BE 1R)", "Wide (BE 1.5R)"],
     tooltip = "Aggressive: BE@0.75R, +0.25R@1R, +0.5R@1.25R, +0.75R@1.5R. Standard: BE@1R, +0.5R@1.5R, +1R@2R, +1.5R@2.5R. Wide: BE@1.5R, +0.5R@2R, +1R@2.5R, +1.5R@3R. The stop never moves backwards. A new stop is active from the next bar.")

volIn    = input.string("Off", "Volume Filter", options = ["Off", "Above Average (1.0x)", "Strong (1.5x)"], group = G_VOL)
volLenIn = input.int(20, "Volume Average Length", minval = 2, group = G_VOL)
emaFastIn = input.int(9, "EMA Cloud Fast", minval = 1, group = G_BIAS)
emaSlowIn = input.int(21, "EMA Cloud Slow", minval = 1, group = G_BIAS)
biasFilterIn = input.bool(false, "Only Trade With EMA Bias", group = G_BIAS,
     tooltip = "Uses the chart timeframe cloud. The D / 4H / 1H / 15m / 5m row is display only.")

payloadModeIn = input.string("Generic JSON (Futures / Any Webhook)", "Alert Payload", group = G_STAX,
     options = ["Stax Options Webhook", "Generic JSON (Futures / Any Webhook)"],
     tooltip = "Generic JSON sends plan, entry, exit, and optional stop updates with prices and R. It does not send a contract quantity. Create the alert as alert() function calls only.")
tickerOverrideIn = input.string("", "Underlying Symbol Override (blank = chart root)", group = G_STAX)
dteIn            = input.int(0, "Days To Expiration (0 = 0DTE)", minval = 0, maxval = 60, group = G_STAX)
strikesOtmIn     = input.int(0, "Strikes OTM", minval = 0, group = G_STAX)
strikeStepIn     = input.float(1.0, "Strike Step", minval = 0.5, step = 0.5, group = G_STAX)
sendExitAlertsIn = input.bool(true, "Send Exit Alerts (Generic JSON only)", group = G_STAX)
sendStopUpdIn    = input.bool(false, "Send Stop-Update Alerts (Generic JSON only)", group = G_STAX)

showTableIn    = input.bool(true, "Show HUD", group = G_DISPLAY)
hudSizeIn      = input.string("Full", "HUD size", options = ["Full", "Compact"], group = G_DISPLAY)
hudPosIn       = input.string("Top right", "HUD position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DISPLAY)
showDrawingsIn = input.bool(true, "Show Chart Drawings", group = G_DISPLAY)
keepClosedIn   = input.bool(false, "Keep Closed Drawings", group = G_DISPLAY,
     tooltip = "Off keeps the current plan and fades the one that just ended, then removes that faded plan when the next one arms. On leaves faded plans on the chart.")
showSessBgIn   = input.bool(true, "Shade Active Session", group = G_DISPLAY)
cloudColorIn   = input.color(#00c8ff, "EMA Cloud Color", group = G_DISPLAY)

pDir = switch presetIn
    "NY AM Scalper"          => "Both"
    "NY AM Standard"         => "Both"
    "London Breakout"        => "Both"
    "Overnight Conservative" => "Both"
    => dirIn
pSess = presetIn == "NY AM Scalper" or presetIn == "NY AM Standard" ? "NY AM (09:30-12:00)" : presetIn == "London Breakout" ? "London (03:00-06:00)" : presetIn == "Overnight Conservative" ? "Overnight (18:00-03:00)" : sessIn
pTp = switch presetIn
    "NY AM Scalper"          => 1.0
    "NY AM Standard"         => 2.0
    "London Breakout"        => 1.5
    "Overnight Conservative" => 1.0
    => tpRIn
pSl = switch presetIn
    "NY AM Scalper"          => "Medium"
    "NY AM Standard"         => "Large"
    "London Breakout"        => "Medium"
    "Overnight Conservative" => "Large"
    => slTypeIn
pBe = switch presetIn
    "NY AM Scalper"          => "Off"
    "NY AM Standard"         => "Off"
    "London Breakout"        => "Off"
    "Overnight Conservative" => "At 1R"
    => beIn
pTrail = switch presetIn
    "NY AM Scalper"          => "Aggressive (BE 0.75R)"
    "NY AM Standard"         => "Standard (BE 1R)"
    "London Breakout"        => "Standard (BE 1R)"
    "Overnight Conservative" => "Off"
    => trailIn
pMaxTrades = switch presetIn
    "NY AM Scalper"          => 3
    "NY AM Standard"         => 3
    "London Breakout"        => 2
    "Overnight Conservative" => 2
    => maxTradesIn

sessStr = pSess == "NY AM (09:30-12:00)" ? "0930-1200" : pSess == "NY PM (13:00-16:00)" ? "1300-1600" : pSess == "London (03:00-06:00)" ? "0300-0600" : pSess == "Asia (20:00-00:00)" ? "2000-0000" : pSess == "Overnight (18:00-03:00)" ? "1800-0300" : pSess == "Custom" ? customSessIn : ""
sessShort = pSess == "NY AM (09:30-12:00)" ? "NY AM" : pSess == "NY PM (13:00-16:00)" ? "NY PM" : pSess == "London (03:00-06:00)" ? "London" : pSess == "Asia (20:00-00:00)" ? "Asia" : pSess == "Overnight (18:00-03:00)" ? "Overnight" : pSess == "Custom" ? customSessIn : "24/5"
sessionFilterOn = sessStr != ""
sessForTime = sessionFilterOn ? sessStr : "0000-2359:1234567"
inSession = not sessionFilterOn or not na(time(timeframe.period, sessForTime, tzIn))
sessionEnded = sessionFilterOn and inSession[1] and not inSession
dayStamp = dayofmonth(time, tzIn)
newDay = dayStamp != dayStamp[1]
tick = syminfo.mintick
longsOk = pDir != "Shorts Only"
shortsOk = pDir != "Longs Only"
trailOn = pTrail != "Off"
beOn = not trailOn and pBe != "Off"
beR = switch pBe
    "At 0.5R"  => 0.5
    "At 0.75R" => 0.75
    "At 1R"    => 1.0
    "At 1.5R"  => 1.5
    => 0.0
trailBe = switch pTrail
    "Aggressive (BE 0.75R)" => 0.75
    "Standard (BE 1R)"      => 1.0
    "Wide (BE 1.5R)"        => 1.5
    => 0.0
trailT1 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.0
    "Standard (BE 1R)"      => 1.5
    "Wide (BE 1.5R)"        => 2.0
    => 0.0
trailO1 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.25
    "Standard (BE 1R)"      => 0.5
    "Wide (BE 1.5R)"        => 0.5
    => 0.0
trailT2 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.25
    "Standard (BE 1R)"      => 2.0
    "Wide (BE 1.5R)"        => 2.5
    => 0.0
trailO2 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.5
    "Standard (BE 1R)"      => 1.0
    "Wide (BE 1.5R)"        => 1.0
    => 0.0
trailT3 = switch pTrail
    "Aggressive (BE 0.75R)" => 1.5
    "Standard (BE 1R)"      => 2.5
    "Wide (BE 1.5R)"        => 3.0
    => 0.0
trailO3 = switch pTrail
    "Aggressive (BE 0.75R)" => 0.75
    "Standard (BE 1R)"      => 1.5
    "Wide (BE 1.5R)"        => 1.5
    => 0.0
volMult = switch volIn
    "Above Average (1.0x)" => 1.0
    "Strong (1.5x)"        => 1.5
    => 0.0
staxMode = payloadModeIn == "Stax Options Webhook"
targetsOk = tp1OnIn or tp2OnIn or tp3OnIn

emaFast = ta.ema(close, emaFastIn)
emaSlow = ta.ema(close, emaSlowIn)
bias = close > emaFast and emaFast > emaSlow ? 1 : close < emaFast and emaFast < emaSlow ? -1 : 0
atr = ta.atr(14)
volSma = ta.sma(volume, volLenIn)

f_htf() =>
    float fast = ta.ema(close, emaFastIn)
    float slow = ta.ema(close, emaSlowIn)
    close > fast and fast > slow ? 1 : close < fast and fast < slow ? -1 : 0
hD  = request.security(syminfo.tickerid, "D", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h4  = request.security(syminfo.tickerid, "240", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h1  = request.security(syminfo.tickerid, "60", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h15 = request.security(syminfo.tickerid, "15", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)
h5  = request.security(syminfo.tickerid, "5", f_htf(), barmerge.gaps_off, barmerge.lookahead_off)

ph = ta.pivothigh(high, swingLenIn, swingLenIn)
pl = ta.pivotlow(low, swingLenIn, swingLenIn)
var float rangeHigh = na
var float rangeLow = na
var int rangeHighBar = na
var int rangeLowBar = na
var bool highBroken = false
var bool lowBroken = false
if not na(ph)
    rangeHigh := ph
    rangeHighBar := bar_index - swingLenIn
    highBroken := false
if not na(pl)
    rangeLow := pl
    rangeLowBar := bar_index - swingLenIn
    lowBroken := false
lowLegLen = na(rangeLowBar) ? legLookbackIn : math.max(1, math.min(legLookbackIn, bar_index - rangeLowBar + 1))
highLegLen = na(rangeHighBar) ? legLookbackIn : math.max(1, math.min(legLookbackIn, bar_index - rangeHighBar + 1))
legLowNow = ta.lowest(low, lowLegLen)
legHighNow = ta.highest(high, highLegLen)
rangeOk = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow and (minRangeAtrIn <= 0 or rangeHigh - rangeLow >= minRangeAtrIn * atr)
displaced = dispAtrIn <= 0 or math.abs(close - open) >= dispAtrIn * atr
bullBos = rangeOk and not highBroken and close > rangeHigh and displaced
bearBos = rangeOk and not lowBroken and close < rangeLow and displaced
var int bullBosBar = na
var int bearBosBar = na
var float bullLegLow = na
var float bearLegHigh = na
var bool bullDisp = false
var bool bearDisp = false
if bullBos
    highBroken := true
    bullBosBar := bar_index
    bullLegLow := legLowNow
    bullDisp := math.abs(close - open) >= atr
if bearBos
    lowBroken := true
    bearBosBar := bar_index
    bearLegHigh := legHighNow
    bearDisp := math.abs(close - open) >= atr
bullFvg = low > high[2] and close[1] > open[1]
bearFvg = high < low[2] and close[1] < open[1]
bullArmed = not na(bullBosBar) and bar_index - bullBosBar >= 0 and bar_index - bullBosBar <= fvgWindowIn
bearArmed = not na(bearBosBar) and bar_index - bearBosBar >= 0 and bar_index - bearBosBar <= fvgWindowIn
volOkPrev = volMult <= 0 or volume[1] > volSma[1] * volMult

var int tradesToday = 0
if newDay
    tradesToday := 0

f_num(float v) =>
    na(v) ? "null" : str.tostring(v, format.mintick)
f_ts() =>
    str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ssZ", tzIn)
f_pad2(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)
f_expiryYYMMDD() =>
    int base = timestamp(tzIn, year(time, tzIn), month(time, tzIn), dayofmonth(time, tzIn), 12, 0, 0) + dteIn * 86400000
    int dow = dayofweek(base, tzIn)
    int adj = dow == dayofweek.saturday ? base + 2 * 86400000 : dow == dayofweek.sunday ? base + 86400000 : base
    str.substring(str.tostring(year(adj, tzIn)), 2, 4) + f_pad2(month(adj, tzIn)) + f_pad2(dayofmonth(adj, tzIn))
f_strike(int side) =>
    float step = strikeStepIn
    float raw = side == 1 ? math.ceil(close / step) * step + strikesOtmIn * step : math.floor(close / step) * step - strikesOtmIn * step
    float frac = raw - math.floor(raw)
    frac == 0 ? str.tostring(math.round(raw)) + ".0" : str.tostring(raw)
f_grade(bool dispOk, bool biasOk, bool volOk, bool sessOk, bool timeOk) =>
    int score = (dispOk ? 1 : 0) + (biasOk ? 1 : 0) + (volOk ? 1 : 0) + (sessOk ? 1 : 0) + (timeOk ? 1 : 0)
    score == 5 ? "A+" : score == 4 and (dispOk or sessOk) ? "A" : "B"
f_fp() =>
    string a = (tp1OnIn ? "1" : "0") + ":" + str.tostring(tp1WIn)
    string b = (tp2OnIn ? "1" : "0") + ":" + str.tostring(tp2WIn)
    string c = (tp3OnIn ? "1" : "0") + ":" + str.tostring(tp3WIn)
    str.tostring(pTp, "0.00") + "|" + a + "|" + b + "|" + c + "|" + pSl + "|" + minGradeIn + "|" + entryLevelIn + "|" + pBe + "|" + pTrail + "|" + pDir + "|" + sessShort
f_signed(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"

var bool pending = false
var bool inTrade = false
var int dir = 0
var int bornBar = na
var int fillBar = na
var int bosAt = na
var float entryPx = na
var float stopPx = na
var float liveStop = na
var float riskPx = na
var float nearPx = na
var float invPx = na
var float fvgTop = na
var float fvgBot = na
var bool on1 = false
var bool on2 = false
var bool on3 = false
var float t1 = na
var float t2 = na
var float t3 = na
var int w1 = 1
var int w2 = 1
var int w3 = 1
var bool hit1 = false
var bool hit2 = false
var bool hit3 = false
var float rUnit = na
var string gradeNow = ""
var string setupId = ""
var string fpNow = ""
var string setJson = ""
var string footNow = ""
var bool ended = false
var bool armed = false

var box fvgBox = na
var line lnEn = na
var line lnSl = na
var line ln1 = na
var line ln2 = na
var line ln3 = na
var label lbEn = na
var label lbSl = na
var label lb1 = na
var label lb2 = na
var label lb3 = na
var label lbBos = na
var label lbFvg = na
var label lbFill = na
var label lbExit = na

f_box_end(box b, bool destroy) =>
    if not na(b)
        if destroy
            box.delete(b)
        else
            box.set_bgcolor(b, color.new(#7F8AA3, 88))
            box.set_border_color(b, color.new(#7F8AA3, 70))
    true
f_line_end(line l, bool destroy) =>
    if not na(l)
        if destroy
            line.delete(l)
        else
            line.set_color(l, color.new(#7F8AA3, 70))
    true
f_lab_end(label l, bool destroy) =>
    if not na(l)
        if destroy
            label.delete(l)
        else
            label.set_textcolor(l, color.new(#7F8AA3, 65))
            label.set_color(l, color.new(#0B0F19, 100))
    true

f_targets() =>
    string s = ""
    if on1
        s := '{"id":"TP1","price":' + f_num(t1) + ',"allocation":' + str.tostring(w1) + ',"r":' + str.tostring(rUnit, "0.00") + '}'
    if on2
        string bit = '{"id":"TP2","price":' + f_num(t2) + ',"allocation":' + str.tostring(w2) + ',"r":' + str.tostring(rUnit * 2.0, "0.00") + '}'
        s := s == "" ? bit : s + "," + bit
    if on3
        string bit3 = '{"id":"TP3","price":' + f_num(t3) + ',"allocation":' + str.tostring(w3) + ',"r":' + str.tostring(rUnit * 3.0, "0.00") + '}'
        s := s == "" ? bit3 : s + "," + bit3
    "[" + s + "]"

f_core(string event, string eventId, string extra) =>
    string action = (event == "entry" and dir == 1) or (event == "exit" and dir == -1) or (event != "exit" and dir == 1) ? "buy" : "sell"
    '{"source":"staxbot","event":"' + event + '","eventId":"' + eventId + '","setupId":"' + setupId + '","settingsId":"' + fpNow + '","action":"' + action + '","side":"' + (dir == 1 ? "long" : "short") + '","ticker":"' + syminfo.ticker + '","root":"' + syminfo.root + '","exchange":"' + syminfo.prefix + '","timeframe":"' + timeframe.period + '","grade":"' + gradeNow + '","settings":' + setJson + extra + ',"timestamp":"' + f_ts() + '"}'

f_levels() =>
    ',"price":' + f_num(entryPx) + ',"entry":' + f_num(entryPx) + ',"stop":' + f_num(stopPx) + ',"target":' + f_num(nearPx) + ',"targets":' + f_targets() + ',"reason":"fvg_retrace"'

f_stax(int side) =>
    string root = tickerOverrideIn != "" ? tickerOverrideIn : syminfo.root
    string tkr = root + f_expiryYYMMDD() + (side == 1 ? "C" : "P") + f_strike(side)
    '{"timestamp":"' + f_ts() + '","unmodifiedTicker":"' + tkr + '","source":"staxbot","side":"' + (side == 1 ? "long" : "short") + '","underlying":"' + syminfo.ticker + '","underlyingEntry":' + f_num(entryPx) + ',"underlyingStop":' + f_num(stopPx) + ',"underlyingTarget":' + f_num(nearPx) + '}'

f_fill_mark() =>
    label result = na
    if dir == 1
        result := label.new(bar_index, low, "LONG", style = label.style_label_up, color = color.new(#4C8DFF, 0), textcolor = color.white, size = size.small, text_font_family = font.family_monospace)
    else
        result := label.new(bar_index, high, "SHORT", style = label.style_label_down, color = color.new(#FF8A3D, 0), textcolor = color.white, size = size.small, text_font_family = font.family_monospace)
    result
f_exit_mark(float y, string txt, color ink) =>
    label result = na
    if dir == 1
        result := label.new(bar_index, y, txt, style = label.style_label_down, color = ink, textcolor = color.white, size = size.tiny, text_font_family = font.family_monospace)
    else
        result := label.new(bar_index, y, txt, style = label.style_label_up, color = ink, textcolor = color.white, size = size.tiny, text_font_family = font.family_monospace)
    result
f_note(int at, float y, string txt) =>
    label.new(at, y, txt, style = label.style_none, color = color.new(#7F8AA3, 100), textcolor = color.new(#7F8AA3, 65), size = size.tiny)

f_price_tag(int at, float y, string txt, color ink) =>
    label.new(at, y, txt, style = label.style_label_right, color = color.new(#0B0F19, 20), textcolor = ink, size = size.small, text_font_family = font.family_monospace)

f_done() =>
    (not on1 or hit1) and (not on2 or hit2) and (not on3 or hit3)

// Resting plan, then a fill on a later bar. The signal bar is not a fill:
// a bullish near-edge limit sits on this bar's low.
if pending and not inTrade and bar_index > bornBar
    bool touched = dir == 1 ? low <= entryPx : high >= entryPx
    bool stopped = dir == 1 ? low <= stopPx : high >= stopPx
    bool ran = dir == 1 ? high >= nearPx : low <= nearPx
    if touched
        inTrade := true
        pending := false
        fillBar := bar_index
        liveStop := stopPx
        hit1 := false
        hit2 := false
        hit3 := false
        tradesToday += 1
        if showDrawingsIn
            if not na(fvgBox)
                box.set_right(fvgBox, bar_index)
            if not na(lbFill)
                label.delete(lbFill)
            lbFill := f_fill_mark()
        if not staxMode
            alert(f_core("entry", setupId + ":ENTRY", f_levels()), alert.freq_once_per_bar_close)
        else
            alert(f_stax(dir), alert.freq_once_per_bar_close)
        if stopped
            float rr = riskPx > 0 ? dir * (stopPx - entryPx) / riskPx : 0.0
            if showDrawingsIn
                if not na(lbExit)
                    label.delete(lbExit)
                lbExit := f_exit_mark(dir == 1 ? high : low, "SL " + f_signed(rr), color.new(#FF5C6C, 0))
            if not staxMode and sendExitAlertsIn
                string extra = ',"price":' + f_num(stopPx) + ',"stop":' + f_num(stopPx) + ',"target":' + f_num(nearPx) + ',"reason":"SL","targetId":"STOP","realizedR":' + str.tostring(rr, "0.00")
                alert(f_core("exit", setupId + ":EXIT:STOP", extra), alert.freq_once_per_bar_close)
            inTrade := false
            ended := true
        else
            if on1 and not hit1 and (dir == 1 ? high >= t1 : low <= t1)
                hit1 := true
                float rr1 = riskPx > 0 ? dir * (t1 - entryPx) / riskPx : 0.0
                if showDrawingsIn
                    if not na(lbExit)
                        label.delete(lbExit)
                    lbExit := f_exit_mark(dir == 1 ? high : low, "TP1 " + f_signed(rr1), color.new(#3DDC97, 0))
                if not staxMode and sendExitAlertsIn
                    string extra1 = ',"price":' + f_num(t1) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(t1) + ',"reason":"TP","targetId":"TP1","realizedR":' + str.tostring(rr1, "0.00")
                    alert(f_core("exit", setupId + ":EXIT:TP1", extra1), alert.freq_once_per_bar_close)
            if on2 and not hit2 and (dir == 1 ? high >= t2 : low <= t2)
                hit2 := true
                float rr2 = riskPx > 0 ? dir * (t2 - entryPx) / riskPx : 0.0
                if showDrawingsIn
                    if not na(lbExit)
                        label.delete(lbExit)
                    lbExit := f_exit_mark(dir == 1 ? high : low, "TP2 " + f_signed(rr2), color.new(#3DDC97, 0))
                if not staxMode and sendExitAlertsIn
                    string extra2 = ',"price":' + f_num(t2) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(t2) + ',"reason":"TP","targetId":"TP2","realizedR":' + str.tostring(rr2, "0.00")
                    alert(f_core("exit", setupId + ":EXIT:TP2", extra2), alert.freq_once_per_bar_close)
            if on3 and not hit3 and (dir == 1 ? high >= t3 : low <= t3)
                hit3 := true
                float rr3 = riskPx > 0 ? dir * (t3 - entryPx) / riskPx : 0.0
                if showDrawingsIn
                    if not na(lbExit)
                        label.delete(lbExit)
                    lbExit := f_exit_mark(dir == 1 ? high : low, "TP3 " + f_signed(rr3), color.new(#147A4E, 0))
                if not staxMode and sendExitAlertsIn
                    string extra3 = ',"price":' + f_num(t3) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(t3) + ',"reason":"TP","targetId":"TP3","realizedR":' + str.tostring(rr3, "0.00")
                    alert(f_core("exit", setupId + ":EXIT:TP3", extra3), alert.freq_once_per_bar_close)
            if f_done()
                inTrade := false
                ended := true
    else
        bool expired = bar_index - bornBar > setupExpiryIn
        bool invalidated = dir == 1 ? close < invPx : close > invPx
        bool flipped = dir == 1 ? bearBos : bullBos
        string why = expired ? "expired" : invalidated ? "invalidated" : ran ? "missed" : flipped ? "flipped" : sessionEnded ? "session" : ""
        if why != ""
            if not staxMode
                alert(f_core("plan_cancel", setupId + ":CANCEL", ',"reason":"' + why + '"'), alert.freq_once_per_bar_close)
            pending := false
            ended := true

if inTrade and bar_index > fillBar
    bool stopped = dir == 1 ? low <= liveStop : high >= liveStop
    if stopped
        float rr = riskPx > 0 ? dir * (liveStop - entryPx) / riskPx : 0.0
        bool moved = liveStop != stopPx
        string why = not moved ? "SL" : math.abs(rr) < 0.05 ? "BE" : "TRAILED"
        color ink = why == "SL" ? color.new(#FF5C6C, 0) : why == "BE" ? color.new(#9AA3B5, 0) : color.new(#3DDC97, 0)
        if showDrawingsIn
            if not na(lbExit)
                label.delete(lbExit)
            lbExit := f_exit_mark(dir == 1 ? high : low, why + " " + f_signed(rr), ink)
        if not staxMode and sendExitAlertsIn
            string extra = ',"price":' + f_num(liveStop) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(nearPx) + ',"reason":"' + why + '","targetId":"STOP","realizedR":' + str.tostring(rr, "0.00")
            alert(f_core("exit", setupId + ":EXIT:" + why, extra), alert.freq_once_per_bar_close)
        inTrade := false
        ended := true
    else
        if on1 and not hit1 and (dir == 1 ? high >= t1 : low <= t1)
            hit1 := true
            float rr1 = riskPx > 0 ? dir * (t1 - entryPx) / riskPx : 0.0
            if showDrawingsIn
                if not na(lbExit)
                    label.delete(lbExit)
                lbExit := f_exit_mark(dir == 1 ? high : low, "TP1 " + f_signed(rr1), color.new(#3DDC97, 0))
            if not staxMode and sendExitAlertsIn
                string extra1 = ',"price":' + f_num(t1) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(t1) + ',"reason":"TP","targetId":"TP1","realizedR":' + str.tostring(rr1, "0.00")
                alert(f_core("exit", setupId + ":EXIT:TP1", extra1), alert.freq_once_per_bar_close)
        if on2 and not hit2 and (dir == 1 ? high >= t2 : low <= t2)
            hit2 := true
            float rr2 = riskPx > 0 ? dir * (t2 - entryPx) / riskPx : 0.0
            if showDrawingsIn
                if not na(lbExit)
                    label.delete(lbExit)
                lbExit := f_exit_mark(dir == 1 ? high : low, "TP2 " + f_signed(rr2), color.new(#3DDC97, 0))
            if not staxMode and sendExitAlertsIn
                string extra2 = ',"price":' + f_num(t2) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(t2) + ',"reason":"TP","targetId":"TP2","realizedR":' + str.tostring(rr2, "0.00")
                alert(f_core("exit", setupId + ":EXIT:TP2", extra2), alert.freq_once_per_bar_close)
        if on3 and not hit3 and (dir == 1 ? high >= t3 : low <= t3)
            hit3 := true
            float rr3 = riskPx > 0 ? dir * (t3 - entryPx) / riskPx : 0.0
            if showDrawingsIn
                if not na(lbExit)
                    label.delete(lbExit)
                lbExit := f_exit_mark(dir == 1 ? high : low, "TP3 " + f_signed(rr3), color.new(#147A4E, 0))
            if not staxMode and sendExitAlertsIn
                string extra3 = ',"price":' + f_num(t3) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(t3) + ',"reason":"TP","targetId":"TP3","realizedR":' + str.tostring(rr3, "0.00")
                alert(f_core("exit", setupId + ":EXIT:TP3", extra3), alert.freq_once_per_bar_close)
        if f_done()
            inTrade := false
            ended := true
        else if inTrade
            float favR = dir == 1 ? (high - entryPx) / riskPx : (entryPx - low) / riskPx
            float offR = na
            if trailOn
                offR := favR >= trailT3 ? trailO3 : favR >= trailT2 ? trailO2 : favR >= trailT1 ? trailO1 : favR >= trailBe ? 0.0 : na
            else if beOn
                offR := favR >= beR ? 0.0 : na
            if not na(offR)
                float buffer = offR == 0 and beTickIn ? dir * tick : 0.0
                float cand = entryPx + dir * offR * riskPx + buffer
                float newStop = dir == 1 ? math.max(liveStop, cand) : math.min(liveStop, cand)
                if newStop != liveStop
                    liveStop := newStop
                    if not na(lnSl)
                        line.set_y1(lnSl, liveStop)
                        line.set_y2(lnSl, liveStop)
                        line.set_color(lnSl, color.new(#9AA3B5, 0))
                    if not na(lbSl)
                        label.set_text(lbSl, "STOP " + f_num(liveStop))
                        label.set_y(lbSl, liveStop)
                    if sendStopUpdIn and not staxMode
                        string extraS = ',"price":' + f_num(liveStop) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(nearPx) + ',"reason":"trail","realizedR":' + str.tostring(offR, "0.00")
                        alert(f_core("stop_update", setupId + ":STOP:" + str.tostring(bar_index), extraS), alert.freq_once_per_bar_close)

if inTrade and sessionEnded and flatAtSessEndIn
    if showDrawingsIn
        if not na(lbExit)
            label.delete(lbExit)
        lbExit := f_exit_mark(close, "FLAT", color.new(#7F8AA3, 0))
    if not staxMode and sendExitAlertsIn
        float rr = riskPx > 0 ? dir * (close - entryPx) / riskPx : 0.0
        string extra = ',"price":' + f_num(close) + ',"stop":' + f_num(liveStop) + ',"target":' + f_num(nearPx) + ',"reason":"FLAT","targetId":"FLAT","realizedR":' + str.tostring(rr, "0.00")
        alert(f_core("exit", setupId + ":EXIT:FLAT", extra), alert.freq_once_per_bar_close)
    inTrade := false
    ended := true

canTrade = inSession and targetsOk and tradesToday < pMaxTrades and not inTrade and not pending
longSetup = canTrade and longsOk and bullFvg and bullArmed and volOkPrev and (not biasFilterIn or bias == 1)
shortSetup = canTrade and shortsOk and bearFvg and bearArmed and volOkPrev and (not biasFilterIn or bias == -1)
if longSetup or shortSetup
    int side = longSetup ? 1 : -1
    float gapTop = side == 1 ? low : low[2]
    float gapBot = side == 1 ? high[2] : high
    float nearEdge = side == 1 ? gapTop : gapBot
    float farEdge = side == 1 ? gapBot : gapTop
    float entryLvl = entryLevelIn == "FVG Midpoint (CE)" ? (gapTop + gapBot) / 2.0 : entryLevelIn == "FVG Far Edge (Deep)" ? farEdge : nearEdge
    float slRaw = pSl == "Tight" ? farEdge : pSl == "Medium" ? (side == 1 ? low[1] : high[1]) : side == 1 ? math.min(nz(bullLegLow, low[1]), low[1]) : math.max(nz(bearLegHigh, high[1]), high[1])
    float sl = side == 1 ? slRaw - slBufferTicksIn * tick : slRaw + slBufferTicksIn * tick
    float riskPts = side == 1 ? entryLvl - sl : sl - entryLvl
    bool valid = riskPts >= minStopTicksIn * tick and (maxStopPtsIn <= 0 or riskPts <= maxStopPtsIn)
    int bosBar = side == 1 ? bullBosBar : bearBosBar
    int clock = hour(time, tzIn) * 60 + minute(time, tzIn)
    bool gradeSess = (clock >= 180 and clock < 360) or (clock >= 500 and clock < 690)
    string grade = f_grade(side == 1 ? bullDisp : bearDisp, side == 1 ? bias == 1 : bias == -1, volume[1] > volSma[1], gradeSess, bar_index - bosBar <= 3)
    bool takeGrade = minGradeIn == "Off" or grade == "A+" or (minGradeIn == "A" and grade == "A")
    if valid and takeGrade
        pending := true
        armed := true
        inTrade := false
        dir := side
        bornBar := bar_index
        fillBar := na
        bosAt := bosBar
        entryPx := entryLvl
        stopPx := sl
        liveStop := sl
        riskPx := riskPts
        invPx := fvgCheckIn == "Strict" ? farEdge : sl
        fvgTop := gapTop
        fvgBot := gapBot
        on1 := tp1OnIn
        on2 := tp2OnIn
        on3 := tp3OnIn
        w1 := tp1WIn
        w2 := tp2WIn
        w3 := tp3WIn
        rUnit := pTp
        t1 := entryLvl + side * pTp * riskPts
        t2 := entryLvl + side * pTp * 2.0 * riskPts
        t3 := entryLvl + side * pTp * 3.0 * riskPts
        nearPx := on1 ? t1 : on2 ? t2 : t3
        hit1 := false
        hit2 := false
        hit3 := false
        gradeNow := grade
        fpNow := f_fp()
        setJson := '{"tpR":' + str.tostring(pTp, "0.00") + ',"slType":"' + pSl + '","minGrade":"' + minGradeIn + '","entryLevel":"' + entryLevelIn + '","direction":"' + pDir + '","breakeven":"' + pBe + '","trail":"' + pTrail + '","tp1":' + (on1 ? "true" : "false") + ',"tp2":' + (on2 ? "true" : "false") + ',"tp3":' + (on3 ? "true" : "false") + ',"w1":' + str.tostring(w1) + ',"w2":' + str.tostring(w2) + ',"w3":' + str.tostring(w3) + '}'
        footNow := str.tostring(pTp, "0.#") + "R · " + pSl + " · " + (trailOn ? "Trail" : beOn ? "BE" : "BE off") + " · " + sessShort
        setupId := syminfo.ticker + ":" + str.tostring(time) + ":" + (side == 1 ? "long" : "short")
        if side == 1
            bullBosBar := na
        else
            bearBosBar := na
        if not staxMode
            alert(f_core("plan", setupId + ":PLAN", f_levels()), alert.freq_once_per_bar_close)

// Retire the previous drawing set before the new one is created.
if armed and showDrawingsIn
    bool destroy = not keepClosedIn
    f_box_end(fvgBox, destroy)
    f_line_end(lnEn, destroy)
    f_line_end(lnSl, destroy)
    f_line_end(ln1, destroy)
    f_line_end(ln2, destroy)
    f_line_end(ln3, destroy)
    f_lab_end(lbEn, destroy)
    f_lab_end(lbSl, destroy)
    f_lab_end(lb1, destroy)
    f_lab_end(lb2, destroy)
    f_lab_end(lb3, destroy)
    f_lab_end(lbBos, destroy)
    f_lab_end(lbFvg, destroy)
    f_lab_end(lbFill, destroy)
    f_lab_end(lbExit, destroy)
    fvgBox := na
    lnEn := na
    lnSl := na
    ln1 := na
    ln2 := na
    ln3 := na
    lbEn := na
    lbSl := na
    lb1 := na
    lb2 := na
    lb3 := na
    lbBos := na
    lbFvg := na
    lbFill := na
    lbExit := na
    int left = math.max(0, bornBar - 10)
    int right = bornBar
    float zoneTop = math.max(fvgTop, fvgBot)
    float zoneBot = math.min(fvgTop, fvgBot)
    color sideInk = dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0)
    fvgBox := box.new(bornBar - 2, zoneTop, bornBar, zoneBot, border_color = color.new(sideInk, 0), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(sideInk, 88))
    lnEn := line.new(left, entryPx, right, entryPx, color = color.new(#E6EAF2, 0), width = 1)
    lnSl := line.new(left, stopPx, right, stopPx, color = color.new(#FF5C6C, 0), width = 2)
    lbEn := f_price_tag(right, entryPx, "ENTRY " + f_num(entryPx), color.new(#E6EAF2, 0))
    lbSl := f_price_tag(right, stopPx, "STOP " + f_num(stopPx), color.new(#FF5C6C, 0))
    if on1
        ln1 := line.new(left, t1, right, t1, color = color.new(#3DDC97, 0), style = line.style_dotted, width = 1)
        lb1 := f_price_tag(right, t1, "TP1 " + f_num(t1) + "  " + str.tostring(rUnit, "0.#") + "R  w" + str.tostring(w1), color.new(#3DDC97, 0))
    if on2
        ln2 := line.new(left, t2, right, t2, color = color.new(#3DDC97, 0), style = line.style_solid, width = 2)
        lb2 := f_price_tag(right, t2, "TP2 " + f_num(t2) + "  " + str.tostring(rUnit * 2.0, "0.#") + "R  w" + str.tostring(w2), color.new(#3DDC97, 0))
    if on3
        ln3 := line.new(left, t3, right, t3, color = color.new(#147A4E, 0), style = line.style_dashed, width = 2)
        lb3 := f_price_tag(right, t3, "TP3 " + f_num(t3) + "  " + str.tostring(rUnit * 3.0, "0.#") + "R  w" + str.tostring(w3), color.new(#147A4E, 0))
    float bosY = dir == 1 ? low[bar_index - bosAt] : high[bar_index - bosAt]
    lbBos := f_note(bosAt, bosY, "BOS")
    lbFvg := f_note(bornBar, dir == 1 ? high : low, "FVG")

if ended and not armed and showDrawingsIn
    f_box_end(fvgBox, false)
    f_line_end(lnEn, false)
    f_line_end(lnSl, false)
    f_line_end(ln1, false)
    f_line_end(ln2, false)
    f_line_end(ln3, false)
    f_lab_end(lbEn, false)
    f_lab_end(lbSl, false)
    f_lab_end(lb1, false)
    f_lab_end(lb2, false)
    f_lab_end(lb3, false)
    f_lab_end(lbBos, false)
    f_lab_end(lbFvg, false)
    f_lab_end(lbFill, false)
    f_lab_end(lbExit, false)
ended := false
armed := false

pF = plot(emaFast, "EMA Fast", color = color.new(cloudColorIn, 0), linewidth = 2)
pS = plot(emaSlow, "EMA Slow", color = color.new(cloudColorIn, 35), linewidth = 2)
fill(pF, pS, color = color.new(cloudColorIn, 85), title = "EMA Cloud")
bgcolor(showSessBgIn and sessionFilterOn and inSession ? color.new(cloudColorIn, 93) : na, title = "Session")

var table infoTbl = na
var string hudKey = ""
f_cell(table t, int col, int row, string txt, color ink, color bg, string align) =>
    table.cell(t, col, row, txt, text_color = ink, bgcolor = bg, text_halign = align == "r" ? text.align_right : text.align_left, text_valign = text.align_center, text_size = size.tiny, text_font_family = font.family_monospace)

if not showTableIn and not na(infoTbl)
    table.delete(infoTbl)
    infoTbl := na
    hudKey := ""
string wantKey = (showTableIn ? "1" : "0") + hudSizeIn + hudPosIn
if showTableIn and wantKey != hudKey
    if not na(infoTbl)
        table.delete(infoTbl)
    int cols = hudSizeIn == "Compact" ? 3 : 2
    int rows = hudSizeIn == "Compact" ? 4 : 9
    infoTbl := table.new(hudPosIn == "Top left" ? position.top_left : hudPosIn == "Bottom right" ? position.bottom_right : hudPosIn == "Bottom left" ? position.bottom_left : position.top_right, cols, rows, bgcolor = color.new(#0B0F19, 0), border_width = 1, border_color = color.new(#121A2B, 0), frame_color = color.new(#121A2B, 0), frame_width = 1)
    if hudSizeIn == "Full"
        table.merge_cells(infoTbl, 0, 2, 1, 2)
        table.merge_cells(infoTbl, 0, 8, 1, 8)
    hudKey := wantKey

if showTableIn and not na(infoTbl)
    bool stale = (pending or inTrade) and f_fp() != fpNow
    bool live = pending or inTrade
    color head = live ? (dir == 1 ? color.new(#4C8DFF, 0) : color.new(#FF8A3D, 0)) : color.new(#121A2B, 0)
    color ink = color.white
    color muted = color.new(#7F8AA3, 0)
    color rowBg = color.new(#0B0F19, 0)
    color keyBg = color.new(#121A2B, 0)
    int bulls = (hD == 1 ? 1 : 0) + (h4 == 1 ? 1 : 0) + (h1 == 1 ? 1 : 0) + (h15 == 1 ? 1 : 0) + (h5 == 1 ? 1 : 0)
    int bears = (hD == -1 ? 1 : 0) + (h4 == -1 ? 1 : 0) + (h1 == -1 ? 1 : 0) + (h15 == -1 ? 1 : 0) + (h5 == -1 ? 1 : 0)
    string cloud = bulls > bears ? "BULL " + str.tostring(bulls) + "/5" : bears > bulls ? "BEAR " + str.tostring(bears) + "/5" : "MIX"
    string state = inTrade ? "LIVE" : pending ? "ARMED" : "SCAN"
    string sideTxt = live ? (dir == 1 ? "LONG" : "SHORT") : ""
    float openR = live and riskPx > 0 ? dir * (close - entryPx) / riskPx : 0.0
    string note = not targetsOk ? "Enable TP1, TP2, or TP3" : stale ? "INPUTS CHANGED. Recreate the alert." : pending ? "BOS + FVG. Waiting for the retest." : inTrade ? "Plan is live. " + f_signed(openR) : "D" + (hD == 1 ? "+" : hD == -1 ? "-" : "·") + " 4H" + (h4 == 1 ? "+" : h4 == -1 ? "-" : "·") + " 1H" + (h1 == 1 ? "+" : h1 == -1 ? "-" : "·") + " 15" + (h15 == 1 ? "+" : h15 == -1 ? "-" : "·") + " 5" + (h5 == 1 ? "+" : h5 == -1 ? "-" : "·")
    string foot = stale ? "INPUTS CHANGED" : live ? footNow : str.tostring(pTp, "0.#") + "R · " + pSl + " · " + (targetsOk ? "targets on" : "no target") + " · " + sessShort
    if hudSizeIn == "Compact"
        f_cell(infoTbl, 0, 0, "StaxBot 1.7", ink, head, "l")
        f_cell(infoTbl, 1, 0, "PLAN", ink, head, "l")
        f_cell(infoTbl, 2, 0, live ? gradeNow : cloud, ink, head, "r")
        f_cell(infoTbl, 0, 1, state + (sideTxt == "" ? "" : " " + sideTxt), ink, keyBg, "l")
        f_cell(infoTbl, 1, 1, live ? f_num(entryPx) : "—", ink, rowBg, "r")
        f_cell(infoTbl, 2, 1, live ? f_signed(openR) : str.tostring(tradesToday) + "/" + str.tostring(pMaxTrades), live ? ink : muted, rowBg, "r")
        string tpName = live ? (on1 and not hit1 ? "TP1" : on2 and not hit2 ? "TP2" : on3 and not hit3 ? "TP3" : "TP") : "TP1"
        float tpShow = live ? (on1 and not hit1 ? t1 : on2 and not hit2 ? t2 : on3 and not hit3 ? t3 : nearPx) : na
        f_cell(infoTbl, 0, 2, tpName, color.new(#3DDC97, 0), keyBg, "l")
        f_cell(infoTbl, 1, 2, live ? f_num(tpShow) : "—", ink, rowBg, "r")
        f_cell(infoTbl, 2, 2, live ? "w" + str.tostring(on1 and not hit1 ? w1 : on2 and not hit2 ? w2 : w3) : "", muted, rowBg, "r")
        f_cell(infoTbl, 0, 3, stale ? "INPUTS CHANGED" : "STOP", stale ? color.new(#e6b35a, 0) : color.new(#FF5C6C, 0), keyBg, "l")
        f_cell(infoTbl, 1, 3, live ? f_num(liveStop) : foot, ink, rowBg, "r")
        f_cell(infoTbl, 2, 3, live ? f_signed(riskPx > 0 ? dir * (liveStop - entryPx) / riskPx : 0.0) : "", muted, rowBg, "r")
    else
        f_cell(infoTbl, 0, 0, "StaxBot 1.7", ink, head, "l")
        f_cell(infoTbl, 1, 0, "PLAN", ink, head, "r")
        f_cell(infoTbl, 0, 1, state + (sideTxt == "" ? "" : "  " + sideTxt), ink, keyBg, "l")
        f_cell(infoTbl, 1, 1, live ? gradeNow + "  " + f_signed(openR) : cloud, ink, rowBg, "r")
        f_cell(infoTbl, 0, 2, note, stale ? color.new(#e6b35a, 0) : muted, rowBg, "l")
        f_cell(infoTbl, 0, 3, on3 and live ? "TP3  " + str.tostring(rUnit * 3.0, "0.#") + "R  w" + str.tostring(w3) : "", color.new(#147A4E, 0), keyBg, "l")
        f_cell(infoTbl, 1, 3, on3 and live ? f_num(t3) : "", ink, rowBg, "r")
        f_cell(infoTbl, 0, 4, on2 and live ? "TP2  " + str.tostring(rUnit * 2.0, "0.#") + "R  w" + str.tostring(w2) : "", color.new(#3DDC97, 0), keyBg, "l")
        f_cell(infoTbl, 1, 4, on2 and live ? f_num(t2) : "", ink, rowBg, "r")
        f_cell(infoTbl, 0, 5, on1 and live ? "TP1  " + str.tostring(rUnit, "0.#") + "R  w" + str.tostring(w1) : live ? "" : "Trades", on1 and live ? color.new(#3DDC97, 0) : muted, keyBg, "l")
        f_cell(infoTbl, 1, 5, on1 and live ? f_num(t1) : live ? "" : str.tostring(tradesToday) + "/" + str.tostring(pMaxTrades), ink, rowBg, "r")
        f_cell(infoTbl, 0, 6, live ? "ENTRY" : "", color.new(#E6EAF2, 0), keyBg, "l")
        f_cell(infoTbl, 1, 6, live ? f_num(entryPx) : "", ink, rowBg, "r")
        f_cell(infoTbl, 0, 7, live ? "STOP" : "", color.new(#FF5C6C, 0), keyBg, "l")
        f_cell(infoTbl, 1, 7, live ? f_num(liveStop) : "", ink, rowBg, "r")
        f_cell(infoTbl, 0, 8, foot + " · " + pDir, stale ? color.new(#e6b35a, 0) : muted, keyBg, "l")
